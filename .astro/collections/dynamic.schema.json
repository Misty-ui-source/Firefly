{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "published": {
      "type": "string",
      "format": "date-time"
    },
    "pinned": {
      "default": false,
      "type": "boolean"
    },
    "location": {
      "default": "",
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "published"
  ]
}