<script>
// 实时数据：直连 Umami 公开分享接口（学 HY 9ll.uk 方案，零后端）
// 流程：GET /api/share/{shareId} 拿 websiteId + token → 带 x-umami-share-token 头调数据接口
// 缓存：token 24h，数据 2min；失败静默保留构建时数据
(function () {
	var SHARE_ID = "EG15WwHeRvz2lmd2";
	var API_BASE = "https://umami.lanerc.me";
	var TOKEN_KEY = "lanerc-umami-share-token";
	var DATA_KEY = "lanerc-umami-live";
	var TOKEN_TTL = 24 * 60 * 60 * 1000;
	var DATA_TTL = 0; // 用户要求：不缓存，每次进页面都重新拉

	function fmt(n) { return Number(n || 0).toLocaleString(); }

	function render(d) {
		var map = {
			totalVisitors: d.totalVisitors,
			totalPageviews: d.totalPageviews,
			todayVisitors: d.todayVisitors,
			todayPageviews: d.todayPageviews,
		};
		Object.keys(map).forEach(function (k) {
			var el = document.querySelector('[data-stat="' + k + '"]');
			if (el && map[k] != null) el.textContent = fmt(map[k]);
		});
		var onlineEl = document.getElementById("live-online");
		if (onlineEl && d.online != null) {
			onlineEl.innerHTML = '<span class="online-dot"></span>' + (d.online > 0 ? d.online + " 人在线" : "在线");
		}
		var updatedEl = document.getElementById("live-updated");
		if (updatedEl) {
			var t = new Date().toLocaleString("zh-CN", { hour12: false }).slice(0, 16);
			updatedEl.textContent = "实时更新于 " + t + " · 30天区间";
		}
	}

	function getCached(key, ttl) {
		try {
			var c = JSON.parse(localStorage.getItem(key) || "null");
			if (c && Date.now() - c.ts < ttl) return c.data;
		} catch (e) {}
		return null;
	}
	function setCached(key, data) {
		try { localStorage.setItem(key, JSON.stringify({ ts: Date.now(), data: data })); } catch (e) {}
	}

	// 先看数据缓存
	var cachedData = getCached(DATA_KEY, DATA_TTL);
	if (cachedData) { render(cachedData); return; }

	function fetchShare() {
		var cached = getCached(TOKEN_KEY, TOKEN_TTL);
		if (cached) return Promise.resolve(cached);
		return fetch(API_BASE + "/api/share/" + SHARE_ID)
			.then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); })
			.then(function (d) {
				var info = { websiteId: d.websiteId, token: d.token };
				setCached(TOKEN_KEY, info);
				return info;
			});
	}

	function umamiGet(info, path) {
		return fetch(API_BASE + path, {
			headers: {
				"x-umami-share-token": info.token,
				"x-umami-share-context": "1",
			},
		}).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
	}

	fetchShare().then(function (info) {
		var now = Date.now();
		var day = 24 * 60 * 60 * 1000;
		var p30 = { startAt: now - 30 * day, endAt: now };
		var pToday = { startAt: new Date().setHours(0, 0, 0, 0), endAt: now };
		var qs = function (p) { return "?startAt=" + p.startAt + "&endAt=" + p.endAt + "&unit=day&timezone=Asia/Shanghai"; };
		var wid = info.websiteId;
		return Promise.all([
			umamiGet(info, "/api/websites/" + wid + "/stats" + qs(p30)).catch(function () { return null; }),
			umamiGet(info, "/api/websites/" + wid + "/stats" + qs(pToday)).catch(function () { return null; }),
			umamiGet(info, "/api/realtime/" + wid).catch(function () { return null; }),
		]).then(function (res) {
			var all = res[0], today = res[1], realtime = res[2];
			// 在线人数：5 分钟内有活动的去重 session 数（不是 events 总数）
			var online = 0;
			if (realtime && realtime.events) {
				var seen = {}, cutoff = Date.now() - 5 * 60 * 1000;
				realtime.events.forEach(function (e) {
					var t = new Date(e.createdAt).getTime();
					if (t >= cutoff && e.sessionId && !seen[e.sessionId]) {
						seen[e.sessionId] = 1;
						online++;
					}
				});
			}
			var d = {
				totalVisitors: all && all.visitors != null ? all.visitors : null,
				totalPageviews: all && all.pageviews != null ? all.pageviews : null,
				todayVisitors: today && today.visitors != null ? today.visitors : null,
				todayPageviews: today && today.pageviews != null ? today.pageviews : null,
				online: online,
			};
			// 至少有一项有效才渲染
			if (d.totalVisitors != null || d.totalPageviews != null) {
				render(d);
				setCached(DATA_KEY, d);
			}
		});
	}).catch(function () { /* 保留构建时数据 */ });
})();
</script>

<script is:inline>
// 各卡片图表实时更新（Umami 分享接口）
(function () {
	function getShare() {
		try {
			var c = JSON.parse(localStorage.getItem("lanerc-umami-share-token") || "null");
			if (c && Date.now() - c.ts < 86400000) return Promise.resolve(c.data);
		} catch (e) {}
		return fetch("https://umami.lanerc.me/api/share/EG15WwHeRvz2lmd2")
			.then(function (r) { return r.json(); })
			.then(function (d) {
				var info = { websiteId: d.websiteId, token: d.token };
				try { localStorage.setItem("lanerc-umami-share-token", JSON.stringify({ ts: Date.now(), data: info })); } catch (e) {}
				return info;
			});
	}
	function uget(info, path) {
		return fetch("https://umami.lanerc.me" + path, {
			headers: { "x-umami-share-token": info.token, "x-umami-share-context": "1" }
		}).then(function (r) { if (!r.ok) throw new Error(r.status); return r.json(); });
	}
	var iconMap = { "laptop": "💻", "mobile": "📱", "tablet": "📱", "desktop": "🖥️", "中国": "🇨🇳", "美国": "🇺🇸", "日本": "🇯🇵", "香港": "🇭🇰", "台湾": "🇹🇼", "英国": "🇬🇧", "德国": "🇩🇪", "法国": "🇫🇷", "韩国": "🇰🇷", "新加坡": "🇸🇬", "chrome": "🌐", "edge-chromium": "🌐", "chromium-webview": "📱", "safari": "🧭", "firefox": "🦊" };
	function updateDonut(containerId, items, colors) {
		var container = document.getElementById(containerId);
		if (!container) return;
		var row = container.querySelector(".donut-row");
		if (!row) return;
		var total = items.reduce(function (s, x) { return s + x.y; }, 0) || 1;
		var R = 54, C = 2 * Math.PI * R, offset = 25;
		items.slice(0, 5).forEach(function (item, i) {
			var frac = item.y / total, len = frac * C, color = colors[i % colors.length];
			// 更新 circle 的数据属性（不重建 DOM）
			var circle = row.querySelector('circle[data-seg-index="' + i + '"]');
			if (circle) {
				circle.setAttribute("stroke", color);
				circle.setAttribute("stroke-dasharray", len + " " + (C - len));
				circle.setAttribute("stroke-dashoffset", -offset);
			}
			// 更新图例（只改文本，不重建）
			var legendItem = row.querySelector('[data-legend-index="' + i + '"]');
			if (legendItem) {
				var nameEl = legendItem.querySelector(".legend-name");
				var pctEl = legendItem.querySelector(".legend-pct");
				var dotEl = legendItem.querySelector(".legend-dot");
				if (nameEl) nameEl.textContent = item.x || "未知";
				if (pctEl) pctEl.textContent = Math.round(frac * 100) + "%";
				if (dotEl) dotEl.style.background = color;
			}
			offset += len;
		});
	}
	function createDonutHTML(items, colors, icon) {
		var total = items.reduce(function (s, x) { return s + x.y; }, 0) || 1;
		var R = 54, C = 2 * Math.PI * R, offset = 25, svg = "", legend = "";
		items.slice(0, 5).forEach(function (item, i) {
			var frac = item.y / total, len = frac * C, color = colors[i % colors.length];
			svg += '<circle cx="70" cy="70" r="' + R + '" fill="none" stroke="' + color + '" stroke-width="18" stroke-dasharray="' + len + " " + (C - len) + '" stroke-dashoffset="' + (-offset) + '" transform="rotate(-90 70 70)" data-seg-index="' + i + '" data-astro-cid-bhxyrf2g/>';
			offset += len;
			legend += '<div class="legend-item" data-legend-index="' + i + '" data-astro-cid-bhxyrf2g><span class="legend-dot" data-astro-cid-bhxyrf2g style="background:' + color + '"></span><span class="legend-name" data-astro-cid-bhxyrf2g>' + (item.x || "未知") + '</span><b class="legend-pct" data-astro-cid-bhxyrf2g>' + Math.round(frac * 100) + "%</b></div>";
		});
		var iconHtml = icon ? '<span class="donut-icon">' + icon + "</span>" : "";
		return '<div class="donut-row" data-astro-cid-bhxyrf2g><div class="donut-wrap" data-astro-cid-bhxyrf2g><svg viewBox="0 0 140 140" class="donut-svg" data-astro-cid-bhxyrf2g><circle cx="70" cy="70" r="54" fill="none" stroke="#f3f0ea" stroke-width="18" data-astro-cid-bhxyrf2g/>' + svg + "</svg>" + iconHtml + '</div><div class="donut-legend" data-astro-cid-bhxyrf2g>' + legend + "</div></div>";
	}

	getShare().then(function (info) {
		var wid = info.websiteId, now = Date.now(), day = 86400000;
		var q = function (s, e, u) { return "?startAt=" + s + "&endAt=" + e + "&unit=" + u + "&timezone=Asia/Shanghai"; };
		var mq = q(now - 30 * day, now, "day");

		function delay(ms) { return new Promise(function (res) { setTimeout(res, ms); }); }
		// 访问脉冲（延迟启动，避免并发触发限流）
		delay(500).then(function () {
			return uget(info, "/api/websites/" + wid + "/pageviews" + q(now - 90 * day, now, "day"));
		}).then(function (r) {
			var arr = (r.pageviews || []).map(function (p) { return { date: p.x, pageviews: p.y }; });
			var el = document.getElementById("umami-daily-data");
			if (el && arr.length) {
				el.textContent = JSON.stringify(arr);
				document.dispatchEvent(new CustomEvent("umami-daily-updated"));
			}
		}).catch(function () {});

		// 活跃时间 7x24
		uget(info, "/api/websites/" + wid + "/pageviews" + q(now - 30 * day, now, "hour")).then(function (r) {
			var wrap = document.getElementById("activity-heatmap");
			if (!wrap || !r.pageviews) return;
			var grid = [], maxV = 1, d, h;
			for (d = 0; d < 7; d++) grid.push(new Array(24).fill(0));
			r.pageviews.forEach(function (p) {
				var bj = new Date(new Date(p.x).getTime() + 28800000);
				var wd = (bj.getUTCDay() + 6) % 7;
				h = bj.getUTCHours();
				grid[wd][h] += p.y;
				if (grid[wd][h] > maxV) maxV = grid[wd][h];
			});
			var weekNames = ["一", "二", "三", "四", "五", "六", "日"], html = '<div class="heatmap-grid" data-astro-cid-bhxyrf2g><div class="hm-corner" data-astro-cid-bhxyrf2g></div>';
			for (var hh = 0; hh < 24; hh++) html += '<div class="hm-hlabel" data-astro-cid-bhxyrf2g>' + (hh < 10 ? "0" + hh : hh) + '时</div>';
			grid.forEach(function (row, wd) {
				html += '<div class="hm-wlabel" data-astro-cid-bhxyrf2g>' + weekNames[wd] + "</div>";
				row.forEach(function (v, hr) {
					var op = v === 0 ? 0.06 : 0.15 + 0.85 * (v / maxV);
					var bg = v === 0 ? "#ebedf0" : "rgba(64,196,99," + op.toFixed(2) + ")";
					html += '<div class="hm-dot" data-astro-cid-bhxyrf2g style="background:' + bg + '" title="' + weekNames[wd] + " " + (hr < 10 ? "0" + hr : hr) + "时: " + v + ' 浏览"></div>';
				});
			});
			var old = wrap.querySelector(".heatmap-grid");
			if (old) old.outerHTML = html + "</div>";
		}).catch(function () {});

		// donut 图
		var devC = ["#7eb8f0", "#8fd8b8", "#f0c878", "#b8a0f0", "#f0a0c0"];
		var broC = ["#a080f0", "#f0c878", "#78d0d0", "#f0a080", "#f0a0c0", "#a0c8f0"];
		var srcC = ["#7eb8f0", "#f0c878", "#8fd8b8", "#b8a0f0"];
		uget(info, "/api/websites/" + wid + "/metrics" + mq + "&type=device").then(function (r) {
			var el = document.getElementById("device-donut");
			if (el && r && r.length) updateDonut("device-donut", r, devC);
		}).catch(function () {});
		uget(info, "/api/websites/" + wid + "/metrics" + mq + "&type=browser").then(function (r) {
			var el = document.getElementById("browser-donut");
			if (el && r && r.length) updateDonut("browser-donut", r, broC);
		}).catch(function () {});
		uget(info, "/api/websites/" + wid + "/metrics" + mq + "&type=referrer").then(function (r) {
			if (r && r.length) updateDonut("source-donut", r.map(function (x) { return { x: x.x || "直接访问", y: x.y }; }), srcC);
		}).catch(function () {});
		// 国家分布 donut
		var countryNames = { CN: "中国", US: "美国", JP: "日本", HK: "香港", TW: "台湾", GB: "英国", DE: "德国", FR: "法国", KR: "韩国", SG: "新加坡" };
		var ctyColors = ["#f06a6a", "#7eb8f0", "#f0c878", "#8fd8b8", "#b8a0f0"];
		uget(info, "/api/websites/" + wid + "/metrics" + mq + "&type=country").then(function (r) {
			var el = document.getElementById("region-map");
			if (el && r && r.length) {
				var mapped = r.map(function (x) { return { x: countryNames[x.x] || x.x, y: x.y }; });
				if (!el.querySelector(".donut-row")) {
					el.innerHTML = createDonutHTML(mapped, ctyColors, "");
				} else {
					updateDonut("region-map", mapped, ctyColors);
				}
			}
		}).catch(function () {});
		// 热门页面
		uget(info, "/api/websites/" + wid + "/metrics" + mq + "&type=url").then(function (r) {
			var el = document.getElementById("top-pages");
			if (el && r && r.length) {
				var html = "";
				r.slice(0, 4).forEach(function (p, i) {
					var url = p.x || "/";
					var shortUrl = url === "/" ? "首页" : (url.length > 16 ? url.slice(0, 16) + "…" : url);
					var sub = url === "/" ? "站点入口" : "页面路径";
					html += '<a class="tp-item tp-link" href="' + url + '" title="' + url + '"><span class="tp-rank">' + ("0" + (i + 1)).slice(-2) + '</span><div class="tp-info"><div class="tp-url">' + shortUrl + '</div><div class="tp-sub">' + sub + '</div></div><b class="tp-count">' + p.y + "</b></a>";
				});
				el.innerHTML = html;
			}
		}).catch(function () {});
	}).catch(function () {});

	// 手动刷新按钮：清缓存并重拉
	var refreshBtn = document.getElementById("refresh-stats");
	if (refreshBtn) {
		refreshBtn.addEventListener("click", function () {
			try {
				localStorage.removeItem("lanerc-umami-share-token");
			Object.keys(localStorage).forEach(function (k) {
				if (k.indexOf("lanerc-umami-") === 0) localStorage.removeItem(k);
			});
			} catch (e) {}
			refreshBtn.textContent = "\u23f3 \u5237\u65b0\u4e2d...";
			refreshBtn.disabled = true;
			location.reload();
		});
	}
})();
</script>
