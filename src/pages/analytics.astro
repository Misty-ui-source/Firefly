<script type="application/json" id="umami-daily-data" is:inline set:html={JSON.stringify(umami.daily ?? [])}></script>
<script is:inline>
  // 访问脉冲 7/30/90 天切换
  (function() {
    const dataEl = document.getElementById('umami-daily-data');
    if (!dataEl) return;
    let allDaily = [];
    try { allDaily = JSON.parse(dataEl.textContent || '[]'); } catch(e) { return; }
    // 按日期排序（旧→新）
    allDaily.sort((a, b) => new Date(a.date) - new Date(b.date));

    const tabs = document.querySelectorAll('.time-tab');
    const chartEl = document.getElementById('traffic-chart');
    if (!tabs.length || !chartEl) return;

    function render(range) {
      const daily = allDaily.slice(-range);
      // 更新 tab 高亮
      tabs.forEach(t => t.classList.toggle('active', t.dataset.range == String(range)));
      // 更新"近 X 天"文案
      document.querySelectorAll('.range-label').forEach(el => { el.textContent = `近 ${range} 天`; });
      document.querySelectorAll('[data-rangedays]').forEach(el => { el.textContent = range; });
      // 重绘点图（SVG 圆点，参考 HY 风格）
      if (daily.length > 0) {
        const maxPv = Math.max(...daily.map(x => x.pageviews), 1);
        const W = 600, H = 160, padL = 8, padR = 8, padT = 12, padB = 24;
        const iw = W - padL - padR, ih = H - padT - padB;
        const n = daily.length;
        let dots = "", labels = "";
        daily.forEach((d, i) => {
          const x = n === 1 ? padL + iw / 2 : padL + (i / (n - 1)) * iw;
          const y = padT + ih - (d.pageviews / maxPv) * ih;
          const r = d.pageviews > 0 ? 5 : 3;
          const color = d.pageviews > 0 ? "#2d7cff" : "#d0d7de";
          dots += `<circle cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" r="${r}" fill="${color}" opacity="0.85"><title>${d.date.slice(0,10)}: ${d.pageviews} 浏览</title></circle>`;
          if (n <= 31 || i % Math.ceil(n / 15) === 0 || i === n - 1) {
            var anchor = "middle", lx = x;
            if (i === 0) { anchor = "start"; lx = padL; }
            if (i === n - 1) { anchor = "end"; lx = W - padR; }
            labels += `<text x="${lx.toFixed(1)}" y="${H - 6}" font-size="9" fill="#999" text-anchor="${anchor}">${d.date.slice(5, 10)}</text>`;
          }
        });
        // 连线（淡）
        let path = "";
        daily.forEach((d, i) => {
          const x = n === 1 ? padL + iw / 2 : padL + (i / (n - 1)) * iw;
          const y = padT + ih - (d.pageviews / maxPv) * ih;
          path += (i === 0 ? "M" : "L") + x.toFixed(1) + "," + y.toFixed(1);
        });
        chartEl.innerHTML = `<svg viewBox="0 0 ${W} ${H}" class="dot-chart" style="width:100%;height:auto;display:block"><path d="${path}" fill="none" stroke="#2d7cff" stroke-width="1.5" opacity="0.3"/>${dots}${labels}</svg>`;
      } else {
        chartEl.innerHTML = '<p class="muted">暂无访问数据</p>';
      }
      // 更新本周期统计
      const pv = daily.reduce((s, d) => s + d.pageviews, 0);
      const active = daily.filter(d => d.pageviews > 0).length;
      const peak = daily.length ? Math.max(...daily.map(d => d.pageviews)) : 0;
      const pvEl = document.querySelector('[data-pv]');
      const activeEl = document.querySelector('[data-active]');
      const peakEl = document.querySelector('[data-peak]');
      if (pvEl) pvEl.textContent = pv;
      if (activeEl) activeEl.textContent = active;
      if (peakEl) peakEl.textContent = peak;
      // 拉取该周期的访客数（Umami stats API）
      try {
        var cached = JSON.parse(localStorage.getItem("lanerc-umami-share-token") || "null");
        var tk = cached && cached.data ? cached.data : null;
        var doFetch = function (info) {
          var end = Date.now(), start = end - range * 86400000;
          var url = "https://umami.lanerc.me/api/websites/" + info.websiteId + "/stats?startAt=" + start + "&endAt=" + end;
          return fetch(url, { headers: { "x-umami-share-token": info.token, "x-umami-share-context": "1" } }).then(function (r) { return r.json(); });
        };
        var p = tk ? Promise.resolve(tk) : fetch("https://umami.lanerc.me/api/share/EG15WwHeRvz2lmd2").then(function (r) { return r.json(); }).then(function (d) { return { websiteId: d.websiteId, token: d.token }; });
        p.then(doFetch).then(function (s) {
          var vEl = document.querySelector('[data-period-visitors]');
          if (vEl && s && s.visitors != null) vEl.textContent = s.visitors;
        }).catch(function () {});
      } catch (e) {}
    }

    tabs.forEach(t => {
      t.addEventListener('click', () => render(parseInt(t.dataset.range, 10)));
    });

    // 监听实时数据更新事件
    document.addEventListener('umami-daily-updated', () => {
      try { allDaily = JSON.parse(dataEl.textContent || '[]'); } catch(e) { return; }
      allDaily.sort((a, b) => new Date(a.date) - new Date(b.date));
      const active = document.querySelector('.time-tab.active');
      const range = active ? parseInt(active.dataset.range, 10) : 30;
      render(range);
    });
  })();
</script>

