      {(() => {
        const srcColors = ["#7eb8f0", "#f0c878", "#8fd8b8", "#b8a0f0"];
        const refs = umami.referrers ?? [];
        if (refs.length === 0) {
          return <p class="muted">暂无来源数据 · 新站数据收集中</p>;
        }
        const total = refs.reduce((s, x) => s + x.count, 0) || 1;
        let offset = 25;
        const R = 54, C = 2 * Math.PI * R;
        const segs = refs.slice(0, 4).map((item, i) => {
          const frac = item.count / total;
          const len = frac * C;
          const color = srcColors[i % srcColors.length];
          const el = (
            <circle cx="70" cy="70" r={R} fill="none" stroke={color} stroke-width="18"
              stroke-dasharray={`${len} ${C - len}`} stroke-dashoffset={-offset}
              transform="rotate(-90 70 70)" data-seg-index={i} />
          );
          offset += len;
          return { el, color, pct: Math.round(frac * 100), name: item.name || "直接访问" };
        });
        return (
          <div class="donut-row" id="source-donut">
            <div class="donut-wrap">
              <svg viewBox="0 0 140 140" class="donut-svg">
                <circle cx="70" cy="70" r={R} fill="none" stroke="#f3f0ea" stroke-width="18" />
                {segs.map(s => s.el)}
              </svg>
              <span class="donut-icon">🔗</span>
            </div>
            <div class="donut-legend">
              {segs.map((s, idx) => (
                <div class="legend-item" data-legend-index={idx}>
