---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";

const title = "博客日志";
const description = "记录本站的实质性更新";


// 版本记录（倒序，最新在前）
const logs = [
  {
    version: "V1.6",
    date: "2026 年 10 月 27 日",
    no: "第 7 次记录",
    tags: ["双形态", "阅读", "主题"],
    summary: "站点形态上线：华彩 / 素简双形态——华彩全套呈现，素简简洁导航、专注阅读；顺带收进 azuma 统计页角色图的 iPad 显示修复与公告访客词库扩容",
    count: "30 条记录",
    background: "朝朝听雨 rainzt.cn 的 Pure 形态眼馋很久了：同一套站，他那边能一键切成简洁导航、专注阅读的素面孔。这次照着给本站也整了双形态，机制没另起炉灶，跟导航栏四款样式走同一套底层，类驱动、不渲双份 DOM。",
    changes: [
      { no: "01", cat: "修复", text: "推送节奏和访客活跃时间的角色图改 PNG 并提前加载，修 iPad 上不显示",
        detail: "桌面浏览器一切正常，iPad 上这两张就是空白，关了 VPN、停留等加载也没用。扒了文件才发现：整页的图片里只有这两张是带透明通道的 VP8X/ALPH 变体编码，其余能正常显示的（第一张卡、四张小卡）都是普通 VP8——iPad 的 Safari 正好对这个变体解码有毛病。再叠上懒加载在 Safari 里对这种绝对定位图的触发也不靠谱。索性双管齐下：两张图转成 PNG（顺便按实际显示尺寸缩小了，原图 1312px 宽纯属浪费），并改成进页面提前加载，不再等滚到才拉。版式和人物的站位一律保持原样，不动原结构。" },
      { no: "02", cat: "功能", text: "站点形态上线：华彩 / 素简双形态，素简对标朝朝听雨的 Pure",
        detail: "华彩就是现在这套全套呈现，原样不动；素简是专注阅读的面孔：横幅壁纸、花瓣等特效、看板娘、音乐浮动件全收掉，导航栏退回一条纯色素栏（调色板、搜索、亮暗切换都还在），侧栏只留个人卡（大图收成小圆头像）、公告、最近评论和标签（公告照原站逻辑放在评论上面），文章页正文单列居中、左栏全隐、右栏只留目录，页脚只留备案和版权行；其它页面只跟随全局简化，内容区不动。后又照他的细节收了三处：站名旁的图标去掉、只留纯文字；右栏整体去主题色（社交按钮的薄荷底、标题竖条、标签的彩字全撤，只剩黑白灰）；文章页置顶的头图收到 65ch 宽，不再撑满整列。入口在调色板（显示设置）「外观」页签里、导航栏样式分组的正下方；控制台主题页可以设全站默认，访客自己切的选择存浏览器本地、优先于默认，刷新不闪。实现上没学他服务端渲双份 DOM（他首页 HTML 约 987KB），这边一套 DOM，html 上挂 data-site-mode 属性，素简样式全收在一个 CSS 文件里按属性开关，跟 data-navbar-style 是同一套机制。" },
      { no: "03", cat: "功能", text: "公告访客词库扩容：河南 18 市专属词条 + 外国国家补全到 60 国",
        detail: "访客检测公告里的地方词条之前只有江苏做到了市一级，这次把河南 18 个地市（郑州、开封、洛阳、南阳、信阳……）挨个配了专属词条，跟江苏十三太保同等待遇：河南访客进来先按城市打招呼，没收录的小地方走省级兜底。国外部分原来只有 23 个国家有专属词条，这次把名录里的外国国家全补齐到 60 个（另新增冰岛、哈萨克斯坦、卡塔尔、克罗地亚、乌拉圭 5 个国家名录），从土耳其的热气球到巴铁的朋友，来的客人基本都能接上一句本地话。大陆 31 个省级词条和港澳台 3 条本来就齐，这次没动。" },
      { no: "04", cat: "修复", text: "控制台项目可改状态了；保存时表单外的字段不再被抹掉",
        detail: "项目页那四个状态（计划中 / 开发中 / 已发布 / 已归档）在控制台里一直改不了：项目编辑走的是通用表单，状态压根没登记进可编辑字段。更埋着的一颗雷是保存逻辑——编辑器只收集表单里有的字段，没露面的字段（项目的链接、排序、短名，单页的其余配置）保存一次就被抹掉一次，之前没爆只是因为还没从控制台存过这些页。这次一起修了：项目编辑加了状态下拉（旧值 released 不在标准状态里，会原样标出来提醒改选），保存改为把未管理的 frontmatter 字段整段原文保留，嵌套结构也原样不动。项目列表每行也加了状态小标，点开选一下就直接存，连编辑页都不用进，旧值清理就是挨个点五下的事。" },
      { no: "05", cat: "功能", text: "素简补完：评论区去色、列表信息行、文章页进度线与纯文字上下篇",
        detail: "素简上线后又补了三处。评论区是 Waline 自己的界面，原先一身绿（主题色、昵称、提交按钮都是它默认的绿，博主徽章还是蓝的），在素简里全压成黑白灰：它的整套界面靠 CSS 变量驱动，变量改掉，链接、点赞、排序选中跟着一起退色，只有提交按钮在暗色下要深底翻浅底、单独钉了一遍；顺手把 zhz-ai 那块紫渐变徽章也换成灰药丸。文章列表上方加了一行小字「第 N 页 · 本页 X 篇，共 Y 篇」（他的 Pure 有这个，一直眼馋）。文章页顶部加了 2px 的阅读进度线，读到哪儿走到哪儿；底部上一篇 / 下一篇的大按钮卡退成纯文字行，不再跟正文抢注意力。三样都只在素简下出现，华彩原样不动。" },
      { no: "06", cat: "功能", text: "控制台文章/项目列表加了封面缩略图",
        detail: "之前列表是纯文字行，找文章全靠认标题。这次每行左边加了一张 64×48 的封面图（要的是正经小图，不是细条）：文章读各自目录里的封面，项目读 images/ 下的图，外链图和站内绝对路径也都能直接显示；没封面或者图挂了就自动不占位，还是原来的文字行。" },
      { no: "07", cat: "优化", text: "素简第二轮扫尾：全站内容页去色补完",
        detail: "第一轮只扫了首页和文章页，这次把剩下的页面挨个过了一遍：搜索页的标题图标和结果高亮、朋友圈的统计小卡、日期圈和更新计数片、归档页的年份圈和分类片、动态页的计数和置顶徽章、正文里的行内代码片、右下角浮动按钮——凡是还染着主题绿的地方全部改成中性灰阶。中间还误伤过一次侧栏小部件标题（一条覆盖规则写太宽，把标题刷成了黑条），已经收窄修好；华彩模式不受任何影响。" },
      { no: "08", cat: "功能", text: "新增日历页：日子、文章和校历钉在一起",
        detail: "新开了一个日历页 /calendar/：月历上能看到每天发了什么——文章、动态、日记用不同颜色的点标着，点任意一天，下面列出当天全部内容；法定节假日直接写在格子里（放假、调休上班都标清了），东南大学 2026—2027 学年校历也进来了，开学、考试周、寒暑假这些节点只落在起始日，不然一整个学期都会被刷满。右栏加了「那年今日」，只在日历页出现：默认看往年的今天写过什么，在日历里点别的日期它会跟着切。另外留了一层只属于我自己的记录，在控制台「单页 → 日历记录」里维护，存在仓库里，日历页每次打开都拉最新版，改完刷新就生效、不用等重新构建。导航入口放在「我的 → 时间线」下面。格子里还带一行农历：平时显示初几、廿几，初一显示月份，赶上节气和农历节日（春节、中秋、除夕这些）就换成节日名——农历是拿 1900–2100 的历表在浏览器里本地换算的，跟两个公开历法实现逐日对过 2020–2035 年共 5844 天、一天不差，节气表收了 2024–2030 年。页面下方另有一张「近在眼前」卡：往后 60 天里的节气、农历节日、假期、校历和个人记录按日子排开，每行一个秒级倒计时，点一行直接跳到那天。" },
      { no: "09", cat: "功能", text: "给 R2 图库加了个门面：图床页 /picbed/",
        detail: "之前传到 R2 的图只能在控制台媒体库里管，没有一个能「翻图 + 拿链接」的地方。这次给图库套了个只读门面：输口令解锁后按目录翻图，点图片直接复制 Markdown，也可以切链接或 HTML 格式；非图片文件就一行一个、复制链接。口令在控制台「单页 → 图床门面」里设置，只存哈希、明文不进仓库；没设口令时门面是关的，谁都列不出来。说清楚：图片本身一直是公开直链，这个口令挡的只是把整个图库翻出来这件事。" },
      { no: "10", cat: "修复", text: "素简模式内容顶格：全屏经典布局的大片空白修掉",
        detail: "素简模式打开日历、归档、文章这些页面时，导航栏下面空一大截才见内容——是我的壁纸停在「全屏·经典」布局上才有的组合：原主题给这种布局的非首页留了 45vh 的横幅位，素简把横幅藏了、位置却没收。之前素简只改了控制位置的变量，没压住直接写在内容框上的那条高度（它在样式层外，层内的覆盖够不着）。这次同层把高度一并收回，素简下全站非首页内容都顶到导航栏下方；华彩模式的横幅展示原样不受影响。" },
      { no: "11", cat: "优化", text: "素简导航：下拉箭头贴紧文字、菜单改成右基准",
        detail: "素简导航里带子菜单的几项，箭头原本钉在按钮右缘，素简把按钮内边距收紧后箭头直接压在文字上（实测重叠 17px）。现在箭头回到文字右侧贴着排，悬停时的翻转还在；下拉菜单改成以右边为基准展开：右缘与菜单项对齐、向左借空间，菜单比文字宽时往左长，不往右溢出。" },
      { no: "12", cat: "修复", text: "暗色模式下日志、设备、朋友圈三页正文看不见",
        detail: "这三页是同一批手写的页面：外框给了暗色背景，里头的文字却全靠继承，而继承链上没人给过暗色文字色——亮色下默认黑字没问题，暗色下就成了黑底黑字，整页只剩边框和标签片。逐页排查后确认就这三页中招（日历、归档、统计等页都没事），给三页外框补上随明暗切换的文字色，华彩、素简下都恢复正常。" },
      { no: "13", cat: "优化", text: "素简的调色板精简了，顺带加了字体切换",
        detail: "素简下壁纸和特效本来就不生效，调色板里那两大页签留着纯属占地方。现在切到素简，调色板只剩三组：站点形态（随时切回华彩）、字体、文章布局。字体是新加的：系统默认、Zen Maru Gothic 圆体、霞鹜文楷、朱雀仿宋四种，都是站里已经备好的字体，选完存浏览器本地，刷新不丢；华彩下调色板保持原样全功能。" },
      { no: "14", cat: "修复", text: "动态里的 ==高亮== 之前不生效，修好了",
        detail: "文章那边的渲染管线早就带了高亮插件，写 ==文字== 能出淡青色高亮；动态页图省事，自己另起了一个「裸」渲染器生成内容，谁的插件都没带——高亮、维基链接在动态里都原样吐回来。这次给它补齐同款插件，动态里写 ==文字== 和文章里一个效果，行内代码里的 == 不受影响。" },
      { no: "15", cat: "修复", text: "控制台总结报告的每日操作量柱图在手机上被挤出屏幕，修好",
        detail: "月度小结里的柱状图一个月有 31 根柱子，每根柱的日期标签是「10-01」这种全格式，列宽被标签的最小宽度顶住，整排横向溢出又没法滚动——手机上只能看到 1 号到 14 号，偏偏操作记录是中旬才开始攒的，15 号之后的柱子全在屏幕外，看着就像图没了。改法是柱列改为等分压缩、标签只留日号：现在 31 根柱全进卡片宽度里，哪天最忙一眼就能看出来。" },
      { no: "16", cat: "修复", text: "日历页第一次打开是空的、要刷新才出来，修好",
        detail: "日历页的初始化脚本被打包成了外部文件，站内切页（Swup）时它有概率被跳过执行，页面就只剩个空壳：月份显示「···」、格子一格没有，手动刷新走整页加载才正常。改法是把脚本改回内联（跟站内其他必须执行的脚本一个口径，切页必重跑），再加一道看门狗：切页后发现网格在、但没渲染，就自动补跑一次初始化。图床页是同样的结构，顺手一起改了。" },
      { no: "30", cat: "功能", text: "第三种站点形态「谐彩」上线：Material 3 色阶 · 无边框柔影",
        detail: "双形态变三形态，新来的叫谐彩，视觉参考 Shirone 主题那套 Material 3 的设计语言。跟华彩正好反着来：华彩是 3px 纯黑粗边框加白卡，谐彩把边框全撤了，页面和卡片靠一整套色阶梯分层（卡片只比页面亮一档，暗色下反过来卡片明显浮起来），阴影柔到几乎看不见；主色也不再是亮青绿，压深成沉稳的一档，跟着色相走整套阶梯重新推导。导航换成半透毛玻璃顶栏，链接居中，站名旁加了根主色小竖条，跟每个小部件标题左边的竖条是同一个母题。首页横幅做成舞台：大标题、打字机副标题、社交胶囊行、底部波浪收尾，内页横幅收矮。文章卡片做减法：封面独立成块，标签从彩色药丸改成斜杠分隔的纯文字，日期字数这些元信息全带小图标。代码块跟着明暗走，亮色模式下是浅底，不再一年四季黑着。字体换了三角色分工：西文、中文圆体、代码等宽，全是站里字体库现成的，没新引文件。另外专门给谐彩做了一整套调色板：主题色相滑杆、色彩规范两代可选、九种 Material 色彩风格、六种背景纹理加不透明度、遮罩 / 模糊 / 卡片透明三根滑杆，还有减少动态开关——只在谐彩下出现，华彩和素简的调色板不变。入口还是调色板「外观」里的站点形态，现在是三段；控制台主题页也能设默认。实现上跟素简同一套机制：一套 DOM、属性开关、样式全收在一个文件里，华彩和素简一行没动。" },
      { no: "29", cat: "新功能", text: "控制台加了图片暂存队列，加图不再一张一提交",
        detail: "以前在控制台加一张壁纸、贴纸就触发一次保存、一次提交、一次构建，连着加五张图就是五次。这次给图片类改动加了「待执行」队列：改动先攒在本地（顶栏有角标计数，刷新也不会丢），点执行才合并成一次提交推上去；等不及的地方也留了立即提交的出口。执行的规矩也立好了：推之前先拉远端最新版比对，对不上的标黄跳过、绝不覆盖更新的内容，回读验过一致才从队列里划掉。" },
      { no: "28", cat: "修复", text: "关了轮播还随机换壁纸，修了；控制台传图不再能传出重复图",
        detail: "控制台里关掉某个模式的轮播，定的语义是列表第一张固定显示；但站点脚本挑首张时不看轮播开关、一律随机抽——关了轮播每次打开还是换一张，固定好的那张经常被别的图盖掉，看着还会动一点。这次改成：轮播关着就钉死第一张（切模式、屏幕宽窄跨断点也一样），轮播开着的模式维持原来的随机首张加自动切换。另外控制台上传专属图的入口独缺一道重复检查，同一张图能进列表两次（透明覆盖的列表里就混着一张重复的），这次补上检查，保存时再按地址去重一遍，下次在控制台保存壁纸设置时那张重复的会自动清掉。" },
      { no: "27", cat: "修复", text: "统计页「大家在看什么」在透明模式下跟着透了",
        detail: "朝朝听雨回访时提的：统计页的面板本身是半透明的，但「大家在看什么」每一条排行自己带了一层实色底，壁纸透不过来，看着就是一条条白板。这次把排行条和序号块的底换成跟面板同一个半透明变量，浅色、暗色都跟着透，壁纸换图时也不会再闪眼睛。只动透明模式这一处，普通模式和统计卡本身的样式原样不动。" },
      { no: "26", cat: "调整", text: "素简字体菜单改成控制台可管了",
        detail: "字体页里加了「素简字体菜单」：字体库里十款字体（外加系统默认）放哪几款进素简调色板、按什么顺序排，都在控制台定，排第一的即默认字体。访客自己选过的仍以访客为准。" },
      { no: "25", cat: "调整", text: "控制台能设素简的默认字体了",
        detail: "主题页里加了「素简默认字体」，六个选项跟调色板里一样。没在调色板里选过字体的访客，进素简时用这个默认；访客自己选过的以访客为准，不受影响。" },
      { no: "24", cat: "修复", text: "暗色下右下角两个悬浮按钮看不见，修了；设备页底图提亮",
