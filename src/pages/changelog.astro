---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";

const title = "博客日志";
const description = "记录本站的实质性更新";


// 版本记录（倒序，最新在前）
const logs = [
  {
    version: "V1.5",
    date: "2026 年 10 月 25 日",
    no: "第 6 次记录",
    tags: ["管理台", "Cloudflare", "移动端"],
    summary: "自研管理台上线 + 功能大补完：写作防丢、评论审核、首页卡片、总结报告全齐活，博客迁上 Cloudflare Pages；次日续补高亮渲染、历史版本、全文搜索、媒体库、字体管理与访客公告",
    count: "69 条记录",
    background: "之前博客的构建部署全靠电脑，人在外面想改个东西只能干瞪眼。这次直接上了 Cloudflare Pages，push 就自动构建部署。又顺手把念叨已久的自研管理台写完了 —— 对着 doulor 的后台抄的作业，手机平板上也能写文章、换背景、管相册。登录页整了个波奇全屏，氛围直接拉满。",
    changes: [
      { no: "01", cat: "功能", text: "博客迁上 Cloudflare Pages：push 到 GitHub 自动构建部署",
        detail: "之前 Cloudflare 账号 Workers Builds 被封，换了干净号走 Connect to Git 路线。构建命令是仓库自带的 pnpm build（带 Pagefind 索引重建），以后改东西不用再开电脑打包了，手机上用管理台保存就会触发重新部署。" },
      { no: "02", cat: "功能", text: "自研管理台上线（/admin/）：GitHub OAuth 登录，文章/动态/项目/单页增删改",
        detail: "原生 JS 单页，没套构建工具。GitHub OAuth + PKCE 登录，登录后浏览器拿 token 直调 GitHub Contents API 读写仓库，保存就是一次 git commit。文章是目录模式（一个目录一篇），动态/项目/单页是平铺文件。" },
      { no: "03", cat: "功能", text: "图片管理：博客背景、头像、Favicon、贴纸、Logo、设备图、相册封面，7 个槽位一处替换",
        detail: "博客背景图走 R2（上传自动转 WebP 再写配置，支持增删和上下排序）；头像一次上传生成 PNG + AVIF 两个版本，地址不变友链无缝；Favicon 一次生成 180px 和 32px；贴纸能换图、改位置尺寸；Logo 分亮暗两套；设备页 6 张图；相册封面单独管。" },
      { no: "04", cat: "功能", text: "音乐管理：歌单增删改、调顺序、在线试听",
        detail: "读 src/config/musicConfig.ts 的 playlist，新增歌曲可以填直链也可以上传 mp3 到 R2，封面上传自动转 WebP。保存后构建时读配置，Pages 重建就生效。" },
      { no: "05", cat: "改版", text: "登录页：波奇全屏背景 + 漂浮音符粒子 + 卡片呼吸光；加上 nekro.top 同款三环加载页",
        detail: "登录页整个就是后藤一里的图，不做淡化不加遮罩，原图完整呈现。16 个音符粒子往上飘，卡片有青绿呼吸光。加载页抄的 nekro.top：三环 spinner（外圈换成品牌青绿）+ 站名，加载完左右两块面板向两边滑开。" },
      { no: "06", cat: "功能", text: "相册管理：新建相册、批量传图、加密相册",
        detail: "读 galleryConfig.ts 的 albums，照片走 R2（admin/gallery/<id>/）再追加进 urls.txt，一次 commit。新建相册 ID 按名称自动生成 slug。加密相册的密码只在内存里流转，界面上永不展示原文。" },
      { no: "07", cat: "改版", text: "编辑器照 doulor 重做：分区表单 + Markdown 工具条，动态不再简陋",
        detail: "基本信息卡（标题/日期时间选择器/分类/标签/描述/封面上传/胶囊选项）+ 正文卡（B/I/引用/代码/链接快捷按钮、R2 插图、实时字数、预览）。文章多了置顶和密码保护；动态加了地点字段、一键插入【Muse AI 发布】，R2 目录自动填好当天日期。" },
      { no: "08", cat: "功能", text: "手机 / iPad 适配：顶栏收成汉堡菜单，编辑器单列排布",
        detail: "小屏下导航收进'☰ 菜单'，输入框 16px 防 iOS 自动放大，按钮 44px 高方便点按。现在平板上配好 GitHub 登录就能直接用了，不用开电脑。" },
      { no: "09", cat: "功能", text: "控制台背景一键换：默认波奇酱，备选'星空海滨站'",
        detail: "图片管理里加了'控制台背景'槽位，预设两张一键切换，也可以自己传一张覆盖。找了张星空下的海边车站当备选，青绿夜色跟 hue 174 很搭。" },
      { no: "10", cat: "维护", text: "修了三个 bug：Umami 反代 404、路由三段 hash 丢参数、JS 变量重名",
        detail: "Umami 反代把上游拼成了双重 /api，改对后统计页恢复。路由解析三段式 hash（如文章编辑页）会丢掉第三段，之前编辑页实际是坏的。相册模块和图片模块有个同名变量导致相册页整个报错，都修了，本地实测页面无报错。" },
      { no: "11", cat: "功能", text: "友链管理：增删改、上下排序、启用/停用，头像预览",
        detail: "读 friendsConfig.ts，13 条友链可视化维护。保存时按位置重排 weight，停用的不进构建。还加了 RSS 检测：每条友链的 RSS 能不能拉、拉几篇，一键全测，省得构建时才发现挂了。" },
      { no: "12", cat: "功能", text: "文章系列：编辑器里填系列名 + 系列内排序，自动补全防拼错",
        detail: "主题本来就支持 series 系列导航，之前只能手写 frontmatter。现在编辑器里加了系列输入框，打开自动扫全站已有系列名补全，排序数字越小越靠前。" },
      { no: "13", cat: "功能", text: "书签导航管理：7 分组两级增删改排序",
        detail: "96 条书签的分组和条目都能在控制台里调，保存按位置重赋 weight。之前整理 96 条可是纯手写配置，这次终于不用了。" },
      { no: "14", cat: "改版", text: "控制台导航收纳：次要入口收进 ··· 下拉，移动端换行全显",
        detail: "入口越来越多（图片/音乐/相册/公告/友链/书签/导航/视频/简介/横幅），顶栏放不下，收进 ··· 菜单。桌面端点开展示，手机上换行平铺。" },
      { no: "15", cat: "功能", text: "控制台导航栏可配置：排序/改名/主栏与 ··· 分组",
        detail: "控制台自己的导航也能改了：↑↓ 排序，主栏和 ··· 之间互移，还能改名。配置存仓库，换设备同步。" },
      { no: "16", cat: "功能", text: "视频管理：R2 原画质直传，不转码不压缩",
        detail: "传视频走 R2，文件原样直传不压画质。列表缩略图预览、一键复制链接、删除。建议 mp4（H.264）兼容性最好。" },
      { no: "17", cat: "功能", text: "简介卡片管理：名字/签名/链接可改，头像一键替换双地址同步",
        detail: "侧边栏那张卡片终于不用改代码了。头像是重点：对外地址锁死 https://lanerc.me/avatar.png 和 .avif（友链都用的这个），控制台一次上传同时覆盖两个文件，地址永不变。传 GIF 开启动图模式，前台跳过优化器保证能动。" },
      { no: "18", cat: "功能", text: "横幅文字管理：主标题多语言可改，轮换语句增删排序",
        detail: "'Lovely Life' 和下面打字机轮换的 6 句话都能改了，中文日文 emoji 随便写，↑↓ 调播放顺序。" },
      { no: "19", cat: "维护", text: "构建兜底：友链 RSS 拉取失败不再中断构建",
        detail: "fetch-friend-posts.py 入口加了 try/except，单个源挂了跳过，整个脚本异常也不中断构建。之前要是 RSS 挂一个，整站都构建失败。" },
      { no: "20", cat: "改版", text: "控制台 v2 改版：改名 Alexander Console，日/夜主题切换，毛玻璃细边框 + 暗红点缀",
        detail: "视觉换了一整套：毛玻璃 + 1px 细边框 + 直角 + 暗红点缀，登录页和内页背景分开管。页面切换是 CRT 开关机 + 虫洞动效，开关在设置里，关掉就是无动效直达。" },
      { no: "21", cat: "功能", text: "写作防丢：文章/动态/公告/时间线/碎碎念草稿自动保存，带版本守卫",
        detail: "所有编辑器写一半杀后台、关页面，回来都能恢复草稿。再加一道版本守卫：内容在别处改过新版，旧草稿不会自动盖上去，而是亮出「丢弃草稿 / 仍用旧草稿」让本人选。新建文件撞名自动改名 (1)(2) 顺延，删除操作一律先弹确认。" },
      { no: "22", cat: "功能", text: "拖放导入：.md 文件拖进编辑页自动拆字段填充，图片拖入上传插入光标处",
        detail: "在电脑上写好的 Markdown 直接拖进来：带 frontmatter 的自动填标题/标签/分类等字段，正文进编辑器；图片文件拖入就传 R2 插入。工具栏的「导入文件」按钮走同一条管线。已经用它发了一篇文章，全程没碰复制粘贴。" },
      { no: "23", cat: "功能", text: "评论管理内置页：Waline 审核不用再开评论后台",
        detail: "控制台里直接看评论列表，按状态筛选，通过/置顶/标垃圾/删除/回复一条龙。管理员登录令牌只存在本机浏览器，密码只发给 Waline 本人验证、不落盘。顺手修了评论时间显示 Invalid Date 的问题（取错了字段）。" },
      { no: "24", cat: "功能", text: "首页卡片自助管理：首页 12 张卡片在导航页里改，显隐/排序/改名随手调",
        detail: "首页那 12 张卡以前写死在代码里，现在在「导航」页统一管：哪张显示、排第几、叫什么，都能改完保存生效。主站导航的外链入口也在同一页维护。" },
      { no: "25", cat: "功能", text: "公告栏管理：一句话公告 + 「了解更多」链接，控制台里直接改",
        detail: "顶部公告不用改代码了：内容一句话、可关、链接文本和地址都能改，默认指向 /about/。博客要是有临时通知，手机上改完保存就上线。" },
      { no: "26", cat: "功能", text: "时间线管理：博客时间线条目增删改、上下排序、标签随便打",
        detail: "/timeline/ 的条目搬进控制台维护：标题、描述、详情列表、日期、链接都能改，↑↓ 调顺序。标签输入中英文逗号和顿号都认，不用再小心翼翼切输入法。" },
      { no: "27", cat: "功能", text: "碎碎念管理：星空页的碎碎念增删改 + 显示/隐藏切换",
        detail: "/gallery/thoughts/ 星空里飘的那些短句，现在在控制台里增删改，发布时间自动记、编辑自动记更新时间，还能一条条隐藏/显示。内容是纯文本展示，不配图，星空弹窗就那么大。" },
      { no: "28", cat: "功能", text: "控制台总结报告：月度/季度/年度自动弹，写作页有往期存档",
        detail: "数据源是控制台操作日志 + GitHub 提交历史回填（2026-10-15 起）。报告是小红书周报风：大数字 + 柱状图 + 本期亮点 + 一句实在话，评语按数据阈值自动挑。弹窗只在主页面弹，叉掉的在写作页存档里还能看。" },
      { no: "29", cat: "功能", text: "控制台 PWA：能装到电脑桌面和手机主屏，独立窗口打开",
        detail: "manifest + service worker（只缓存外壳，接口不缓存），图标用的博客头像。装完跟原生 App 一样独立窗口，GitHub 登录时会临时跳授权页再回来。" },
      { no: "30", cat: "功能", text: "背景多图：四处背景的自定义图从「只能一张」改成攒多张",
        detail: "桌面/手机 × 登录/内页，四处背景以前传新图就顶掉旧图。现在上传的都保留成列表：可固定一张、可全部进轮换、可单张删（只移出列表，不删 R2 原图）。以前被顶掉的图没记录，找不回来了，这次学乖了。" },
      { no: "31", cat: "功能", text: "相册排序 + 手机端布局修复：相册能 ↑↓ 排序，按钮不再压字",
        detail: "相册列表加了上下排序（只重排配置顺序，不动照片）。手机上相册行的五个按钮以前挤一行压住描述，现在整行换到信息下方平铺，描述也能正常折行了。" },
      { no: "32", cat: "优化", text: "书签管理页默认折叠：7 个分组默认收起，点开才展开",
        detail: "96 条书签全展开时找一条要点半天。现在默认全折叠，顶部有「全部展开/收起」，在折叠的分组里点新建书签会自动展开那组。" },
      { no: "33", cat: "维护", text: "构建事故修复：编辑相册写出双逗号 `},,`，全站构建堵了四十多分钟",
        detail: "控制台改加密相册时，写回配置没吞掉旧尾逗号，相册数组多出一个空位，Astro 生成静态路径时读到 undefined，当晚所有构建全挂。数据文件改回单逗号、写回逻辑补上吞逗号，并验证了连续编辑两次不再复现。顺带修了统计脚本一个变量作用域 bug——它让 Umami 数据一直静默不更新，因为构建命令的兜底把报错吞了。" },
      { no: "34", cat: "功能", text: "正文编辑器粘贴图片：剪贴板是图片时右键粘贴直接进文章",
        detail: "截图完不用先存文件再上传了：在正文里右键粘贴（或 Ctrl+V），图片自动传到这篇文章的 R2 目录、插到光标处，多张一起粘也行。纯文字粘贴不受影响。" },
      { no: "35", cat: "优化", text: "标签分隔符兼容 + 文章 R2 目录自动填，不再手写目录名",
        detail: "文章/相册的标签输入跟时间线看齐：英文逗号、中文逗号、顿号都认作分隔符。文章编辑器的 R2 目录以前是空的、插图前要自己想名字，现在按文章目录名（新文章按日期）自动填好，灰字示例也换成了文章的例子。" },
      { no: "36", cat: "功能", text: "登录增强：双域名两套 GitHub OAuth 按域名自动切换，权限升级 repo",
        detail: "pages.dev 和 lanerc.me 两个域名各一套 OAuth App，控制台按当前域名自动选对应的 Client ID，后端按 client_id 取对应的密钥。OAuth 授权范围从 public_repo 升到 repo，公开仓旧令牌还能用，重新登录一次的新令牌带完整权限。" },
      { no: "37", cat: "修复", text: "博文 ==高亮== 终于渲染了：补 remark 插件，颜色统一主题青绿",
        detail: "之前控制台预览里高亮好好的，发到博客就没了——预览是控制台自己替换的，博客的 Markdown 管线里根本没人管 mark 语法。给博客加了 remark-mark 插件（只处理正文文本，代码块里的 == 不受影响），底色从一开始的荧光黄改成跟站里一个色系的青绿，控制台预览也同步统一。代码高亮的配色没动，那套我很喜欢。" },
      { no: "38", cat: "功能", text: "正文右键菜单补全：剪切/复制/粘贴置顶，代码块收进辅栏",
        detail: "自定义右键菜单顶部补上剪切/复制/粘贴，和系统菜单的手感对齐；粘贴时剪贴板里是图片就直接走上传插入，不用先存文件。原来平铺的七种代码语言收成一个「代码块 ▸」，悬停展开辅栏选语言，菜单清爽多了。" },
      { no: "39", cat: "优化", text: "文章列表加排序切换：默认文件名序 / 按发表时间，一键来回切",
        detail: "文章列表原来一律按文件名倒序，slug 和发表日期对不上，看着就是乱的。现在工具栏加了「🕒 按时间排」按钮，点了按 published 倒序，再点切回默认。动态那边文件名本身就是日期，不需要这个按钮，就没加。" },
      { no: "40", cat: "改版", text: "碎碎念星空改定版：平时完全静止，只有滚轮才穿行，字体提亮",
        detail: "先做了真 3D 纵深穿行（节点带深度、透视缩放、滚轮给相机冲量），上线后发现四层动效叠在一起晃得慌。最后定版：自动前进、公转、上下浮、星星闪烁全关，画面静止，只有滚轮时才向前穿行；顺手把文字整体提亮到接近参考站的亮白，飞到脸前的提前淡出，长标题在手机上按宽度自动收字号，不再顶出屏幕。" },
      { no: "41", cat: "功能", text: "文件历史版本：编辑器里看每个文件的提交历史，逐行 diff，一键恢复",
        detail: "编辑器工具栏加「🕘 历史」：列出这篇文章最近 30 个版本，能看任意一版原文，能和当前版逐行对比（增删标红绿、没改的段落折叠），看中哪版点恢复就以新提交写回——恢复错了还能在历史里再找回。以前想找回旧稿只能去 GitHub 翻提交，现在不用了。" },
      { no: "42", cat: "功能", text: "全文搜索：文章/动态/项目/单页四个栏目一起搜标题和正文",
        detail: "以前找一篇旧文只能逐栏翻列表。现在搜索页把四个栏目的文档全读一遍建内存索引，输词即搜，多词全含才命中、标题命中优先，结果带栏目和日期，命中词在片段里标亮，点结果直接进编辑器。索引在浏览器里建，不占服务器。" },
      { no: "43", cat: "功能", text: "媒体库：R2 桶里所有文件一处浏览，复制链接/打开/删除",
        detail: "以前传过的图散落在各个目录，想找一张只能拼 URL 猜。现在媒体库把桶整个列出来：按前缀（文章/动态/项目/视频/音乐…）筛选、按文件名过滤、图片有缩略图。删文件前会先在文章里查引用，被引用的会警告——防手滑删掉正在用的图。" },
      { no: "44", cat: "功能", text: "标签管理：改名/合并/删除，一次提交全站改好；分类卡置于标签前",
        detail: "80 个标签以前改一个要挨篇编辑。现在标签页聚合全站标签和分类（带篇数），改名就是全站替换、合并就是并到已有标签、删除就是从所有文章摘掉，受影响的文件合成 1 个 commit 提交。分类只有几个、标签有 80 个，后来把分类卡挪到标签卡前面，进页面第一眼就是分类。" },
      { no: "45", cat: "优化", text: "上传图片自动压缩：转 WebP + 过大自动缩放，并加「原图直传」开关",
        detail: "图片上传时统一转 WebP（质量 0.8），长边超过 2560 的等比缩小，转完要是没变小就保留原图，GIF/SVG 不动。实测一张 216KB 的插画能压到 127KB，100% 对照肉眼看不出差别。但文字多的截图怕糊，编辑器工具栏加了「🖼 原图直传」开关，开了之后所有图片不压缩原样传，全局生效。" },
      { no: "46", cat: "功能", text: "音乐上传自动识别 MP3 标签：歌名/歌手/专辑/封面/歌词自动填",
        detail: "往歌单加歌时选中 MP3 就自动解析 ID3：歌名、歌手填进表单，专辑显示出来，内嵌封面自动传 R2 并预览，有内嵌歌词的直接填进歌词框。解析器是自己写的（ID3v2 + v1 兜底），老文件常见的 GBK 编码也做了兜底解码。识别不到就安静走手动填，不拦路。" },
      { no: "47", cat: "功能", text: "字体管理：控制台里换全站字体，新增思源宋体/霞鹜文楷/朱雀仿宋三款中文字体",
        detail: "主题的字体本来就收口在一个配置里，这次给它配了控制台页面：全局正文、横幅主/副标题、导航标题、代码字体五个位置分别选，外加总开关。原来注册的字体全是英文字体、中文一直走系统字体回退，这次补了三款中文的：思源宋体走 Fontsource，霞鹜文楷和朱雀仿宋是本地字体文件，构建时自动按全站用字子集化，全量字体不进最终网站。" },
      { no: "48", cat: "功能", text: "访客检测公告：按访客位置打招呼 + 算距离，静态公告保留二选一；历史公告自动存档",
        detail: "公告加了第二种模式：Cloudflare 自带访客的国家和经纬度，公告按模板生成「欢迎来自 X 的小伙伴，{时段问候}。你距离 Alexander 约有 N 公里」，问候按访客当地时间分八档，位置拿不到自动回落静态公告。两种模式在控制台公告页二选一启用，各有自己的一套「了解更多」链接。顺手给静态公告加了历史存档：保存新公告时上一条自动归档（最多 20 条），一条点恢复就能换回去。" },
      { no: "49", cat: "功能", text: "导航加入「开往」友链接力：原「开往旧站」改成下拉",
        detail: "申请了开往（travellings）收录。导航栏原来的「🚇 开往旧站」改成「🚇 开往」下拉：第一项开往（随机跳一位成员的博客），第二项还是开往旧站，图标没换。审核要求徽标在打开网页能直接看到的地方，顶栏正好合适。" },
      { no: "50", cat: "维护", text: "新文章同步旧站 Fuwari + 清掉误入文章目录的 10MB 压缩包",
        detail: "把《.pages.dev 飞快，自定义域名却慢得要死》同步到旧站时构建一直冻住，最后定位到是文章目录里躺着一个 blog-rebuild-reflections.zip——那是 Obsidian vault 备份顺手带进去的，构建器把 zip 当模块解析直接卡死。删掉之后构建立刻恢复，文章也顺利上线。以后往内容目录放文件得先看一眼。" },
      { no: "51", cat: "功能", text: "站点导航管理：控制台里改博客顶栏菜单和下拉项",
        detail: "顶栏的链接和一级下拉都能在控制台增删改排了。为了做这个，把 navBarConfig 从代码拼装拍平成纯数据，改前改后逐项对比过，页面渲染一模一样。下拉只做两级，主题本身就只渲染一级，再深也没意义。" },
      { no: "52", cat: "维护", text: "修复三处编辑弹窗没有样式：弹窗其实一直躺在页面最下面",
        detail: "时间线、碎碎念、站点导航的编辑弹窗点了像没反应，查了半天发现 .modal-overlay 这个样式类从来没定义过，弹窗直接裸奔到页面底部去了。补上居中弹窗样式后三处一起恢复。顺手给站点导航的图标字段加了个去 Iconify 找图标的入口。" },
      { no: "53", cat: "功能", text: "单页评论区开关：友链页、打赏页、动态页各自能关评论",
        detail: "三个页面的评论开关原本散在各自的配置文件里，现在控制台单页页顶部有张开关卡，点一下就写回对应配置。留言板跟全局评论走，关于页模板里本来就没有评论区，这两个不在卡里。" },
      { no: "54", cat: "功能", text: "通用单页模板：新建一个文件，自动长出一个页面",
        detail: "静态博客原本只有关于、友链、留言三个写死的单页，想加新页面得写代码。这次加了个动态路由模板，统一读单页目录：新建文件、写好标题正文，构建完就是一个带 Markdown 渲染、代码高亮和评论区的完整页面。已有的专属页面和现成路由都在保留名单里，新文件顶不掉它们，导航栏也不会自动多出入口——想露出来再去站点导航里加。" },
      { no: "55", cat: "功能", text: "三个示范单页 + 单页列表分两组",
        detail: "先建了三个示范页验证模板：随便写写（notes，纯文字）、摄影（photography，图文介绍）、好物清单（picks，链接列表），都是直达页不进导航。控制台的单页列表也拆成两组：展示单页（专属模板）在前，通用单页（通用模板）在后，每行标明用的哪种模板，一眼能分清。" },
      { no: "56", cat: "改版", text: "评论区开关卡挪到单页列表下面 + 通用单页逐页开关",
        detail: "开关卡原来在列表上面，手机上打开单页页先撞见一大张卡，文件列表被顶到下面。挪到列表底部，打开先看文件。通用单页的评论开关也补齐了：每个通用单页一个开关，存进单独的配置文件，默认开。" },
      { no: "57", cat: "功能", text: "相册统一提交：排序、新建、删相册不再一个动作一个 commit",
        detail: "以前点一次上下移动就提交一次，调个顺序能刷出一排 commit。现在相册列表页的新建、编辑、排序、删除都先在本地暂存，按钮上写清攒了几处改动，点「统一提交」才一次性写进仓库，一个 commit 搞定。新建的相册也改成排在最前面，不用再往下翻。" },
      { no: "58", cat: "功能", text: "友链剪切板填充：复制对方本站信息，一键填表",
        detail: "博主给的友链信息基本都是站名、链接、头像、描述四件套，以前要一项项复制粘贴。现在表单里点「剪切板填充」，整段读进来自动分好类填进去。对方没给 RSS 的，会拿网址按 /rss.xml、/atom.xml、/feed 这些常用路径逐个实测，测通哪个填哪个，一个都没有就留空，不瞎猜。" },
      { no: "59", cat: "功能", text: "壁纸模式开放切换：显示设置面板回归",
        detail: "之前访客切换不了壁纸模式，查下来不是功能被删了，是显示设置面板的总开关一直关着。这次把面板打开（外观/壁纸/特效三页签都在），切壁纸模式就在面板的壁纸页签里，横幅/全屏/透明覆盖/纯色四种。本来还在顶栏另加了壁纸和布局两个快捷按钮，主包一看跟调色板面板里全重复了，都删了，顶栏不留重复入口，切换全走面板。" },
      { no: "60", cat: "功能", text: "管理台加「主题」页 + 分模式壁纸：每个模式能配自己的图",
        detail: "管理台新开一页「主题」（调色板图标），四张卡选默认壁纸模式。每个模式还能配专属图：在图片页里按模式分好组，桌面/移动分开管，能传图、贴 URL、从共享图库里挑，轮不轮播也能按模式单独开关。某个模式没配专属图就自动用共享图库，不空窗。主题页只管切默认模式，图片设置点卡片上的按钮跳到图片页对应那一组，滚动定位带高亮。" },
      { no: "61", cat: "功能", text: "访客公告词条大扩容：省份、散装江苏、国家各有专属问候",
        detail: "检测版公告原来只有一句「欢迎来自 X 的小伙伴」。现在国内每个省一条专属词条，能探到城市的显示城市、探不到的显示省份；江苏必须散装，十三个市一个市一条，南京是大蓝鲸鸭血粉丝汤，苏州是园林排面。国外只显示国家，主要国家也都配了专属词条。中间那句距离的文案没动。" },
      { no: "62", cat: "功能", text: "友链随机排序开关 + 友链申请框",
        detail: "友链管理里加了个随机排序开关，开了之后每次构建友链顺序洗一次牌，友链本来就无先后。友链页本站信息卡加了「全部复制」，下面多了个申请框：左边实时预览、右边填表，点添加就拼好格式放进剪切板，有评论框的页面还能自动填进评论区，省得申请人自己拼格式。" },
      { no: "63", cat: "功能", text: "管理台主题页扩容：显示设置面板的默认值全归它管",
        detail: "之前主题页只能切默认壁纸模式。这次把显示设置面板里的默认项全搬进来了：主题色相、文章布局（桌面和移动端分开设）、卡片边框和阴影、卡片跟随主题色、首页壁纸标题、壁纸轮播、水波纹动画、渐变过渡、樱花特效。保存一次就是一个提交，没改动的文件不碰。访客自己在面板里改过的还是以访客的为准，这里管的只是第一次打开时是什么样。" },
      { no: "64", cat: "功能", text: "文章布局开关只在点进文章阅读时出现",
        detail: "列表/网格这个开关以前每个页面都摆着，在主页、归档这些页面点了也没啥用。按站长的要求改成：只有点进文章（项目详情页同理）阅读时才出现在面板里，其它页面不显示。判断用的是站里现成的详情页判定，跟侧边栏、悬浮目录同一套逻辑。" },
      { no: "65", cat: "功能", text: "特效扩充：雪花、萤火虫加入面板",
        detail: "显示设置面板的特效页签原来只有樱花一个，太单调。这次加了雪花和萤火虫，两个共用一个轻量粒子引擎（没走樱花那套 Worker，简单直接，数量也克制）。管理台主题页里也能一起设这三个特效的默认值。默认都是关的，想看的自己在面板里开。" },
      { no: "66", cat: "功能", text: "友链申请：邮箱不再写进公开评论",
        detail: "申请框点提交之后，邮箱原来会拼在评论文本最后一段，等于公开贴出来，谁都能看见。改成邮箱只填进评论区自带的邮箱栏：博主后台看得到、审核通知照样发到这个邮箱，评论文本和复制到剪切板的内容里都不带邮箱了。申请框的邮箱框也标清了「不会公开显示」。" },
      { no: "67", cat: "功能", text: "横幅联系方式：数据换正，管理台两级开关随便管",
        detail: "首页横幅大标题下面本来有一排联系方式图标的位置，配置里一直关着，链接留的还是主题作者的示例（点过去是别人的 GitHub）。这次把数据换成站长自己的：GitHub、邮箱、RSS、Atom、Discord、Telegram（链接都是关于页里的现成公开地址）；默认仍是不显示，管理台主题页新增的「横幅联系方式」卡里有两级开关：一个总开关管整排显不显示，每条前面还有自己的小开关，加好的先关着、不想露面不用删；名称、图标、链接、删改增都自己管。邮箱链接照旧走防爬处理。" },
      { no: "68", cat: "功能", text: "特效大扩容：音符、雨、流星、泡泡、爱心、落叶、点击全来了",
        detail: "站长发话特效多多益善。这一批一次加了七个：音符（波奇酱蔷薇红，往上飘，对齐管理台登录页那排音符）、雨滴、流星（随机划过，带拖尾）、泡泡、爱心、落叶（枫叶打着旋往下落）、点击特效（点哪儿迸一小簇）。加上原有的樱花、雪花、萤火虫，面板特效页签凑满十个；新加的都进同一个轻量粒子引擎，管理台主题页也能逐个设默认值。还是那句话：默认全关，想看哪个自己开。" },
      { no: "69", cat: "功能", text: "管理台图片位全接媒体库：库里的图点一下就用，不用重复上传",
        detail: "站长发话：图片这些尽量都加上从媒体库选。以前传到 R2 的图再想用，得翻媒体库复制链接回来粘。现在图片管理里能放图的地方都多了个「🗂 从媒体库选」：共享壁纸、分模式专属图、报告图库点一下直接加入；头像、Favicon、Logo、贴纸和几处控制台背景走的是把选中图读成文件、复用原来的替换流程；写文章的封面、相册加照片也能从库里挑。库里图多了弹窗里能按文件名筛选。" },
    ],
    updateTags: ["管理台", "Cloudflare", "移动端"],
  },
