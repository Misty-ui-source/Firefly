---
import MainGridLayout from "@/layouts/MainGridLayout.astro";
import { siteConfig } from "@/config";
import { CHANGELOG } from "@/data/changelog";

const title = "博客日志";
const description = "记录本站的实质性更新";


// 版本记录（倒序，最新在前）
const logs = CHANGELOG;

// 头部统计卡：从 logs 自动算，加新版本时数字自己跟上，不用手改
const parseLogDate = (s) => {
  const m = String(s).match(/(\d+)\s*年\s*(\d+)\s*月\s*(\d+)\s*日/);
  return m ? new Date(+m[1], +m[2] - 1, +m[3]) : null;
};
const statVersion = logs[0]?.version ?? "—";
const statDays = new Set(logs.map((l) => l.date)).size;
const statRecords = logs.reduce((n, l) => n + (l.changes?.length ?? 0), 0);
const statDates = logs.map((l) => parseLogDate(l.date)).filter(Boolean).sort((a, b) => a - b);
const fmtMD = (d) => `${d.getMonth() + 1}.${d.getDate()}`;
const statSpan = statDates.length
  ? (statDates[0].getTime() === statDates[statDates.length - 1].getTime()
      ? fmtMD(statDates[0])
      : `${fmtMD(statDates[0])}–${fmtMD(statDates[statDates.length - 1])}`)
  : "—";
---

<MainGridLayout title={title} description={description}>
  <div class="card-base p-6 md:p-8">
      <div class="flex flex-col md:flex-row gap-6 mb-8">
        <div class="flex-1">
          <div class="text-xs tracking-widest opacity-60 mb-3">● BLOG CHANGELOG / PUBLIC RECORD</div>
          <h1 class="text-4xl font-bold mb-3">博客日志</h1>
          <p class="text-sm opacity-70 mb-3">这里记录这个博客从上线到页面迭代的每一个重要节点，每一次都按真实改动整理，展开即可查看完整变更说明。</p>
          <p class="text-xs text-[var(--primary)]">版本规则：Major 代表结构升级 · Minor 代表新功能 · Patch 代表修复、内容与维护</p>
        </div>
        <div class="grid grid-cols-2 gap-3 md:w-64 shrink-0">
          <div class="border border-black/10 dark:border-white/10 rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-[var(--primary)]">{statVersion}</div>
            <div class="text-xs opacity-60">当前版本</div>
          </div>
          <div class="border border-black/10 dark:border-white/10 rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-[var(--primary)]">{statDays}</div>
            <div class="text-xs opacity-60">个更新日</div>
          </div>
          <div class="border border-black/10 dark:border-white/10 rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-[var(--primary)]">{statRecords}</div>
            <div class="text-xs opacity-60">条详细记录</div>
          </div>
          <div class="border border-black/10 dark:border-white/10 rounded-xl p-3 text-center">
            <div class="text-xl font-bold text-[var(--primary)]">{statSpan}</div>
            <div class="text-xs opacity-60">时间跨度</div>
          </div>
        </div>
      </div>

    <div class="space-y-8">
      {logs.map((log) => (
        <article class="relative pl-8">
          <div class="absolute left-0 top-8 bottom-0 w-px bg-black/10 dark:bg-white/10"></div>
          <div class="absolute -left-1.5 top-2 w-3 h-3 rounded-full bg-[var(--primary)]"></div>
          <div class="text-sm opacity-60 mb-1">{log.date} · {log.no}</div>
          <div class="flex items-center gap-3 mb-2 flex-wrap">
            <span class="text-xl font-bold text-[var(--primary)]">{log.version}</span>
            {log.tags.map((t) => (
              <span class="text-xs px-2 py-0.5 rounded-full bg-black/5 dark:bg-white/10">{t}</span>
            ))}
          </div>
          <h2 class="text-lg font-semibold mb-2">{log.summary}</h2>
          <details class="mt-3">
            <summary class="cursor-pointer text-sm opacity-70 hover:opacity-100">展开这条记录（{log.count}）</summary>
            <div class="mt-3 pl-4 border-l border-black/10 dark:border-white/10">
              <h3 class="text-sm font-semibold mb-2">背景</h3>
              <p class="text-sm opacity-80 mb-4">{log.background}</p>
              {log.changes.map((c) => (
                <details class="mb-2 border border-black/10 dark:border-white/10 rounded-lg">
                  <summary class="cursor-pointer text-sm p-3">
                    <span class="font-mono opacity-60">{c.no}</span>
                    <span class="ml-2 px-1.5 py-0.5 text-xs rounded bg-black/5 dark:bg-white/10">{c.cat}</span>
                    <span class="ml-2 text-xs opacity-50">{c.date}</span>
                    <span class="ml-2">{c.text}</span>
                  </summary>
                  <div class="px-3 pb-3 text-sm opacity-80 border-t border-black/10 dark:border-white/10 pt-2">
                    {c.detail || c.text}
                  </div>
                </details>
              ))}
              <div class="mt-3 text-xs opacity-50">
                更新标签：{log.updateTags.join(" · ")}
              </div>
            </div>
          </details>
        </article>
      ))}
    </div>
  </div>
</MainGridLayout>
