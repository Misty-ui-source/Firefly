---
// 明信音乐播放器（二期）：常驻层（挂 Layout 的 Swup 容器外，跨页续播），
// 只在明信形态现身，切走形态只藏不暂停——播放不断。
// 视觉照 Shirone MusicSidebar（番茄仓 organisms/music）：封面卡面（圆封面 +
// 播放波纹环）、标题/歌手、行内音量、进度条、模式/上下曲/歌单控制行、
// 歌词面板（居中列 + 当前行高亮）、歌单面板（序号 + 当前项 tonal 底）。
// 引擎走本站浮动播放器链：歌单先行 musicConfig.floatingPlayer
// （/api/music/playlist 拉单、/api/music/resolve 换源解析），
// mingxinConfig.music.metingSources 在后台合并去重、逐源静默降级；
// 歌词走 Meting 的 lrc 路径（条目自带或按平台+id 补查），LRC 解析同 Shirone lyrics.ts。
import { mingxinConfig } from "@/config/mingxinConfig";
import { musicPlayerConfig } from "@/config/musicConfig";

const fp = musicPlayerConfig.floatingPlayer;
const fpEnabled = !!fp?.enabled;
const fpPlaylists = (fp?.playlists || []).filter((p) => p.id);
const quality = fp?.quality || "320k";
const meting = mingxinConfig.music;
const playerVariant = meting.playerVariant === "pill" ? "pill" : "sidebar";
const renderPlayer = fpEnabled && fpPlaylists.length > 0;
---

{
	renderPlayer && (
		<div id="mingxin-music-player" data-mxmp-variant={playerVariant} hidden>
			<div class="mxmp-view mxmp-view--sidebar">
			<button
				type="button"
				class="mxmp-entry"
				data-mxmp-entry
				aria-label="打开明信音乐播放器"
			>
				<img class="mxmp-entry-cover" data-mxmp-entry-cover alt="" hidden />
				<span class="mxmp-entry-glyph" data-mxmp-entry-glyph>
					♪
				</span>
				<span class="mxmp-entry-state" data-mxmp-entry-state>
					▶
				</span>
			</button>
			<section class="music-player" data-mxmp-card hidden aria-label="音乐播放器">
				<div class="music-player__track">
					<div class="music-player__cover" data-mxmp-cover-wrap>
						<img data-mxmp-cover alt="" hidden />
						<span class="music-player__cover-glyph" data-mxmp-cover-glyph>
							♪
						</span>
					</div>
					<div class="music-player__metadata">
						<strong data-mxmp-title title="">音乐播放器</strong>
						<span data-mxmp-artist title="">歌单加载中…</span>
						<div class="music-player__submeta">
							<div class="music-player__volume-inline">
								<button
									type="button"
									class="mxmp-icon-btn"
									data-mxmp-mute
									aria-label="静音"
								>
									🔊
								</button>
								<div class="music-player__volume-slider-wrap">
									<input
										type="range"
										class="music-player__volume-slider"
										data-mxmp-volume
										min="0"
										max="1"
										step="0.01"
										value="0.7"
										aria-label="音量"
									/>
								</div>
							</div>
							<div class="music-player__lyrics-actions">
								<span class="mxmp-status" data-mxmp-status />
								<button
									type="button"
									class="mxmp-icon-btn"
									data-mxmp-lyrics-toggle
									aria-label="歌词"
									aria-expanded="false"
								>
									词
								</button>
							</div>
						</div>
					</div>
				</div>
				<div class="music-player__progress">
					<span class="music-player__time-cap" data-mxmp-time-cur>
						0:00
					</span>
					<div class="music-player__progress-control">
						<input
							type="range"
							class="mxmp-progress-slider"
							data-mxmp-progress
							min="0"
							max="1000"
							step="1"
							value="0"
							aria-label="进度"
						/>
					</div>
					<span class="music-player__time-cap" data-mxmp-time-dur>
						0:00
					</span>
				</div>
				<div class="music-player__controls">
					<button
						type="button"
						class="mxmp-icon-btn"
						data-mxmp-mode
						aria-label="播放模式：顺序播放"
					>
						🔁
					</button>
					<button
						type="button"
						class="mxmp-icon-btn"
						data-mxmp-prev
						aria-label="上一首"
					>
						⏮
					</button>
					<button
						type="button"
						class="mxmp-icon-btn mxmp-icon-btn--filled"
						data-mxmp-toggle
						aria-label="播放"
					>
						▶
					</button>
					<button type="button" class="mxmp-icon-btn" data-mxmp-next aria-label="下一首">
						⏭
					</button>
					<button
						type="button"
						class="mxmp-icon-btn"
						data-mxmp-list-toggle
						aria-label="歌单"
						aria-expanded="false"
					>
						☰
					</button>
				</div>
				<div class="music-player__lyrics-panel" data-mxmp-lyrics-panel hidden>
					<div class="music-player__lyrics-list" data-mxmp-lyrics-list>
						<p class="music-player__lyrics-empty">暂无歌词</p>
					</div>
				</div>
				<div class="music-player__playlist-panel" data-mxmp-list-panel hidden>
					<ol class="music-player__playlist" data-mxmp-list>
						<li class="music-player__empty">加载中…</li>
					</ol>
				</div>
			</section>
			</div>
			<div class="mxmp-view mxmp-view--pill">
				<div
					class="mxpill"
					data-mxpill
					data-state="disc"
					data-panel="closed"
					data-playing="false"
					role="region"
					aria-label="音乐播放器"
				>
					<div class="mxpill__stage">
						<!-- 展开卡：面板与信息层共用一张表面（移植自 mmz MusicPlayer） -->
						<div class="mxpill__card">
							<div class="mxpill__panel">
								<div class="mxpill__panel-clip">
									<div class="mxpill__panel-body" data-mxpill-panel-body>
										<div class="mxpill__panel-tabs">
											<span class="mxpill__tab-indicator" data-mxpill-tab-indicator aria-hidden="true"></span>
											<button class="mxpill__tab mxpill__tab--playlist is-active" data-mxpill-tab="playlist" type="button">列表</button>
											<button class="mxpill__tab mxpill__tab--lyrics" data-mxpill-tab="lyrics" type="button">歌词</button>
										</div>
										<div class="mxpill__panel-views">
											<div class="mxpill__playlist-view is-active" data-mxpill-view="playlist">
												<div class="mxpill__playlist-list" data-mxpill-list role="listbox" aria-label="歌单"></div>
											</div>
											<div class="mxpill__lyrics-view" data-mxpill-view="lyrics">
												<div class="mxpill__lyrics-list" data-mxpill-lyrics-list role="listbox" aria-label="歌词">
													<div class="mxpill__lyrics-placeholder">暂无歌词</div>
												</div>
											</div>
										</div>
									</div>
								</div>
							</div>
							<!-- 信息层：bar 态常驻在展开卡底部，唱片骑在其左下角 -->
							<div class="mxpill__info">
								<div class="mxpill__info-clip">
									<div class="mxpill__info-surface" data-mxpill-info>
										<p class="mxpill__title" data-mxpill-title>音乐播放器</p>
										<p class="mxpill__artist" data-mxpill-artist></p>
										<div class="mxpill__progress-row">
											<span class="mxpill__time-current" data-mxpill-time-cur>0:00</span>
											<div
												class="mxpill__progress"
												data-mxpill-progress
												role="slider"
												aria-label="进度"
												aria-valuemin="0"
												aria-valuemax="100"
												aria-valuenow="0"
											>
												<div class="mxpill__progress-bar" data-mxpill-progress-bar></div>
												<div class="mxpill__progress-thumb" data-mxpill-progress-thumb></div>
											</div>
											<span class="mxpill__time-total" data-mxpill-time-dur>0:00</span>
										</div>
										<div class="mxpill__loading" aria-hidden="true">
											<svg class="mxpill__icon mxpill__icon--lg" viewBox="0 0 24 24" aria-hidden="true"><path fill="currentColor" d="M6 12.05q0 1.125.425 2.188T7.75 16.2l.25.25V15q0-.425.288-.712T9 14t.713.288T10 15v4q0 .425-.288.713T9 20H5q-.425 0-.712-.288T4 19t.288-.712T5 18h1.75l-.4-.35q-1.3-1.15-1.825-2.625T4 12.05Q4 9.7 5.2 7.787T8.425 4.85q.35-.2.738-.025t.512.575q.125.375-.012.75t-.488.575q-1.45.8-2.312 2.213T6 12.05m12-.1q0-1.125-.425-2.187T16.25 7.8L16 7.55V9q0 .425-.288.713T15 10t-.712-.288T14 9V5q0-.425.288-.712T15 4h4q.425 0 .713.288T20 5t-.288.713T19 6h-1.75l.4.35q1.225 1.225 1.788 2.663T20 11.95q0 2.35-1.2 4.263t-3.225 2.937q-.35.2-.737.025t-.513-.575q-.125-.375.013-.75t.487-.575q1.45-.8 2.313-2.212T18 11.95"/></svg>
										</div>
									</div>
								</div>
							</div>
						</div>
						<!-- 工具栏层：胶囊歌词槽与工具栏共用同一槽位交叉淡入 -->
						<div class="mxpill__bar">
