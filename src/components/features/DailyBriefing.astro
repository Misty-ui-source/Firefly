---
// 每日选刊（第二批）：首页内容栏版——侧栏布局形态（华彩/素简/谐彩/顽彩）
// 在文章列表上方展示；璨夜下内容栏隐藏，改由 AstralBriefingTile 在矩阵里出。
// 拼装规则见 utils/daily-briefing.ts。
import { getBriefingItems } from "@/utils/daily-briefing";

const items = await getBriefingItems();
const today = new Date();
const dateLabel = `${today.getMonth() + 1} 月 ${today.getDate()} 日`;
const fmt = (d: Date) => `${d.getMonth() + 1}/${d.getDate()}`;
---

{
	items.length > 0 && (
		<section class="card-base daily-briefing onload-animation" aria-label="每日选刊">
			<header class="db-head">
				<span class="db-title">每日选刊</span>
				<span class="db-date">{dateLabel}</span>
				<span class="db-note">本站新文 + 友链新文 · 每日自动拼</span>
			</header>
			<ul class="db-list">
				{items.map((it) => (
					<li class="db-item">
						<span class:list={["db-source", { "db-source--pin": it.pinned }]}>
							{it.pinned ? "置顶" : it.source}
						</span>
						<a
							class="db-link"
							href={it.url}
							target={it.external ? "_blank" : undefined}
							rel={it.external ? "noopener" : undefined}
						>
							{it.title}
						</a>
						<time class="db-time">{fmt(it.date)}</time>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.daily-briefing {
		padding: 1rem 1.25rem 0.6rem;
		margin-bottom: 1rem;
	}
	.db-head {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		flex-wrap: wrap;
		margin-bottom: 0.4rem;
	}
	.db-title {
		font-weight: 700;
		font-size: 1.05rem;
		position: relative;
		padding-left: 0.75rem;
	}
	.db-title::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.25rem;
		height: 1rem;
		border-radius: 0.375rem;
		background: var(--primary);
	}
	.db-date {
		font-size: 0.8rem;
		opacity: 0.65;
	}
	.db-note {
		font-size: 0.75rem;
		opacity: 0.5;
		margin-left: auto;
	}
	.db-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.db-item {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.42rem 0;
		border-top: 1px dashed rgb(128 128 128 / 0.18);
	}
	.db-source {
		flex: none;
		font-size: 0.7rem;
		font-weight: 700;
		padding: 0.1rem 0.45rem;
		border-radius: 999px;
		background: rgb(128 128 128 / 0.14);
		max-width: 8rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.db-source--pin {
		background: var(--primary);
		color: white;
	}
	.db-link {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.db-link:hover {
		color: var(--primary);
	}
	.db-time {
		flex: none;
		font-size: 0.75rem;
		opacity: 0.55;
	}
</style>
