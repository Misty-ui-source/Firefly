---
import MusicPlayer from "@/components/features/MusicPlayer.astro";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";

// 璨夜 bento 格位 · 「此刻」合并卡：占第一、二行右列一整张玻璃卡。上半是
// 音乐播放器——与侧栏、导航栏那两份是同一个播放器的不同视图（全局
// MusicPlayerView 脚本会把页面上所有 .music-player-widget 一并初始化、
// 状态互通），合卡只是把侧栏那份在 bento 里的落位收进本卡（侧栏原格在
// astral-mode.css 里于同作用域隐藏，避免同页出现两份可见播放器）。
// 下半是设备在线：运行时拉 /api/device-status（Pages Function 中转
// Komari 探针公开数据，只透名字/在线/运行时长），接口异常显示中性兜底。
// 原下半的 Steam 格因站长很少玩 Steam、记录常年不动而撤下；/steam/ 页
// 与导航入口不受影响。显隐与落位见 astral-mode.css。
---

<div class="card-base astral-tile astral-tile--now">
	<div class="now-music">
		<div class="now-head" aria-hidden="true">
			<span class="now-title">{i18n(I18nKey.music)}</span>
		</div>
		<MusicPlayer id="astral-now-music" />
	</div>

	<div class="now-divider" role="separator"></div>

	<div class="now-devices" data-device-panel>
		<span class="devices-eyebrow">设备 · 在线状态</span>
		<span class="devices-summary" data-device-summary>正在读取设备状态…</span>
		<span class="devices-dots" data-device-dots></span>
		<span class="devices-names" data-device-names></span>
	</div>
</div>

<style>
	.astral-tile--now {
		flex-direction: column;
		padding: 1rem 1rem 1.1rem;
		color: inherit;
	}
	.now-head {
		margin: 0.25rem 0 0.5rem 0.75rem;
	}
	.now-title {
		position: relative;
		font-weight: 700;
		font-size: 1.125rem;
		line-height: 1.4;
	}
	.now-title::before {
		content: "";
		position: absolute;
		left: -0.75rem;
		top: 50%;
		transform: translateY(-50%);
		width: 0.25rem;
		height: 1rem;
		border-radius: 0.375rem;
		background: var(--primary);
	}
	.now-divider {
		height: 1px;
		margin: 0.85rem 0.25rem;
		background: rgb(148 163 184 / 0.28);
	}
	.now-devices {
		display: flex;
		flex-direction: column;
		gap: 0.35rem;
		padding: 0 0.25rem;
		margin-top: auto;
	}
	.devices-eyebrow {
		font-size: 0.72rem;
		font-weight: 700;
		letter-spacing: 0.22em;
		color: var(--primary);
	}
	.devices-summary {
		font-size: 1.12rem;
		font-weight: 700;
		line-height: 1.35;
	}
	.devices-dots {
		display: flex;
		flex-wrap: wrap;
		gap: 0.45rem;
		margin-top: 0.15rem;
		min-height: 0.625rem;
	}
	.device-dot {
		width: 0.625rem;
		height: 0.625rem;
		border-radius: 9999px;
		background: rgb(148 163 184 / 0.45);
	}
	.device-dot.is-online {
		background: #22c55e;
	}
	@media (prefers-reduced-motion: no-preference) {
		.device-dot.is-online {
			animation: device-pulse 2.4s ease-in-out infinite;
		}
	}
	@keyframes device-pulse {
		0%,
		100% {
			box-shadow: 0 0 0 0 rgb(34 197 94 / 0.35);
		}
		50% {
			box-shadow: 0 0 0 0.3rem rgb(34 197 94 / 0);
		}
	}
	.devices-names {
		font-size: 0.83rem;
		color: var(--content-meta);
		line-height: 1.5;
		display: -webkit-box;
		-webkit-line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
</style>

<script>
	// 设备在线拉取：仅在本卡真正可见（璨夜 + 首页 + 桌面 bento）时拉一次；
	// 形态切进璨夜时经 siteModeChange 再检查一次。IIFE + window 标记防
	// 重复（节点在 Swup 容器外、跨页存活）。失败/超时一律走中性兜底文案。
	(() => {
		const w = window as unknown as Record<string, unknown>;
		if (w.__astralDevicesInit) return;
		const panel = document.querySelector<HTMLElement>("[data-device-panel]");
		if (!panel) return;
		w.__astralDevicesInit = true;

		const summary = panel.querySelector<HTMLElement>("[data-device-summary]");
		const dotsBox = panel.querySelector<HTMLElement>("[data-device-dots]");
		const namesBox = panel.querySelector<HTMLElement>("[data-device-names]");
		if (!summary || !dotsBox || !namesBox) return;

		let started = false;

		function fmtUptime(sec: number): string {
			const d = Math.floor(sec / 86400);
			if (d >= 1) return `已运行 ${d} 天`;
			const h = Math.floor(sec / 3600);
			if (h >= 1) return `已运行 ${h} 小时`;
			return `已运行 ${Math.max(1, Math.floor(sec / 60))} 分钟`;
		}

		function fallback() {
			summary.textContent = "设备状态未知";
			dotsBox.replaceChildren();
			namesBox.replaceChildren();
		}

		interface DeviceInfo {
			name: string;
			online: boolean;
			uptime: number | null;
		}

		function render(devices: DeviceInfo[], onlineCount: number) {
			summary.textContent = `${onlineCount}/${devices.length} 台在线`;
			dotsBox.replaceChildren(
				...devices.map((d) => {
					const dot = document.createElement("span");
					dot.className = d.online ? "device-dot is-online" : "device-dot";
					dot.title = d.online
						? `${d.name} · 在线${typeof d.uptime === "number" ? ` · ${fmtUptime(d.uptime)}` : ""}`
						: `${d.name} · 离线`;
					return dot;
				}),
			);
			const onlineNames = devices.filter((d) => d.online).map((d) => d.name);
			namesBox.textContent = onlineNames.join(" · ");
		}

		async function load() {
			const ctrl = new AbortController();
			const timer = window.setTimeout(() => ctrl.abort(), 8000);
			try {
				const res = await fetch("/api/device-status", { signal: ctrl.signal });
				if (!res.ok) throw new Error(`http ${res.status}`);
				const data = (await res.json()) as {
					ok?: boolean;
					online?: number;
					devices?: DeviceInfo[];
				};
				if (!data.ok || !Array.isArray(data.devices)) throw new Error("bad payload");
				render(data.devices, typeof data.online === "number" ? data.online : 0);
			} catch {
				fallback();
			} finally {
				window.clearTimeout(timer);
			}
		}

		function maybeStart() {
			if (started) return;
			if (document.documentElement.dataset.siteMode !== "astral") return;
			if (panel.offsetParent === null) return;
			started = true;
			void load();
		}

		maybeStart();
		window.addEventListener("siteModeChange", maybeStart);
	})();
</script>
