---
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import RecentCommentsSidebar from "@/components/widget/RecentCommentsSidebar.svelte";
import { commentConfig } from "@/config";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}

const { class: className, style, widgetConfig } = Astro.props;
const showTitle = widgetConfig?.showTitle !== false;
const configuredLimit = widgetConfig?.specificConfig?.recentComments?.limit ?? 5;
const limit = Math.max(1, Math.floor(configuredLimit));

// Waline 服务地址：优先用组件配置，其次用全局评论配置
const server =
	widgetConfig?.specificConfig?.recentComments?.serverURL ||
	commentConfig.waline?.serverURL ||
	"";

// 只有启用了 Waline 评论才渲染
const enabled = commentConfig.type === "waline" && server;
---

{
	enabled && (
		<WidgetLayout
			name={i18n(I18nKey.recentComments)}
			showTitle={showTitle}
			id="recent-comments"
			class={className}
			style={style}
		>
			<RecentCommentsSidebar client:load {server} {limit} />
		</WidgetLayout>
	)
}
