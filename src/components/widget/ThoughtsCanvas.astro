---
import type { ThoughtItem } from "@/types/thoughtsConfig";

interface Props {
	items: ThoughtItem[];
}

const { items } = Astro.props;

function fmtDate(iso: string): string {
	try {
		const d = new Date(iso);
		return `${d.getFullYear()}年${d.getMonth() + 1}月${d.getDate()}日`;
	} catch {
		return iso;
	}
}

const dataJson = JSON.stringify(
	items.map((it) => ({
		title: it.title,
		content: it.content,
		dateLabel: fmtDate(it.createdAt),
		updatedLabel: it.updatedAt && it.updatedAt !== it.createdAt ? fmtDate(it.updatedAt) : null,
	}))
);
---

<div class="thoughts-starry" id="thoughts-starry">
	<canvas id="thoughts-canvas"></canvas>
	<div id="thoughts-texts" class="thoughts-texts"></div>
	<div id="thoughts-tip" class="thoughts-tip">滚轮前后移动 · 点击星空中的文字查看详情</div>
	<div id="thoughts-modal" class="thoughts-modal hidden">
		<div class="thoughts-card">
			<button id="thoughts-close" class="thoughts-close">×</button>
			<h2 id="thoughts-mtitle"></h2>
			<div class="thoughts-meta">
				<span>📅</span><span>时间 <span id="thoughts-mdate"></span></span>
				<span id="thoughts-mupdated" class="thoughts-updated"></span>
			</div>
			<div class="thoughts-body">
				<span>💭</span><p id="thoughts-mcontent"></p>
			</div>
		</div>
	</div>
</div>

<style>
	.thoughts-starry {
		position: relative;
		width: 100%;
		height: 60vh;
		min-height: 420px;
		border-radius: 1rem;
		overflow: hidden;
		background: radial-gradient(ellipse at center, #0b0b1e 0%, #050510 100%);
		border: 2px solid #000;
	}
	:global(.dark) .thoughts-starry { border-color: #fff; }
	#thoughts-canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
	/* 文字层学 doulor 的逻辑：文字是真 DOM，字体/字重天然继承站点主题（控制台全局字体设置自动生效），canvas 只画星 */
	.thoughts-texts { position: absolute; inset: 0; pointer-events: none; }
	/* :global 必需：文字元素是脚本运行时创建的，不带 Astro 作用域属性，普通作用域样式打不到它们 */
	:global(.thoughts-text) {
		position: absolute; left: 0; top: 0;
		transform: translate(-50%, -50%);
		white-space: nowrap; color: #fff; font-weight: 500; line-height: 1.25;
		pointer-events: auto; cursor: pointer; user-select: none;
		will-change: transform, opacity, font-size;
	}
	.thoughts-tip {
		position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
		color: rgba(255,255,255,.5); font-size: 12px; pointer-events: none;
		white-space: nowrap;
	}
	.thoughts-modal {
		position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
		background: rgba(0,0,0,.55); z-index: 10; padding: 20px;
	}
	.thoughts-modal.hidden { display: none; }
	.thoughts-card {
		position: relative; max-width: 480px; width: 100%;
		background: #14141f; border: 1px solid rgba(255,255,255,.12);
		border-radius: 1rem; padding: 28px 24px; color: #fff;
		box-shadow: 0 20px 60px rgba(0,0,0,.6);
	}
	.thoughts-card h2 { text-align: center; font-size: 1.35rem; font-weight: 700; margin-bottom: 16px; }
	.thoughts-meta { display: flex; align-items: center; gap: 6px; font-size: .85rem; opacity: .7; margin-bottom: 12px; }
	.thoughts-updated { font-size: .75rem; }
	.thoughts-body { display: flex; gap: 8px; font-size: .95rem; line-height: 1.7; }
	.thoughts-body p { opacity: .85; margin: 0; }
	.thoughts-close {
		position: absolute; top: 10px; right: 14px;
		background: none; border: none; color: rgba(255,255,255,.6);
		font-size: 1.6rem; cursor: pointer; line-height: 1;
	}
	.thoughts-close:hover { color: #fff; }
</style>

<script define:vars={{ dataJson }}>
	const items = JSON.parse(dataJson);
	const wrap = document.getElementById('thoughts-starry');
	const canvas = document.getElementById('thoughts-canvas');
	const ctx = canvas.getContext('2d', { alpha: false });
	const textsLayer = document.getElementById('thoughts-texts');
	const modal = document.getElementById('thoughts-modal');

	let W = 0, H = 0;
	function resize() {
		const dpr = Math.min(window.devicePixelRatio || 1, 1.5);
		const r = wrap.getBoundingClientRect();
		W = r.width; H = r.height;
		canvas.width = Math.round(W * dpr);
		canvas.height = Math.round(H * dpr);
		ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
	}
	resize();
	window.addEventListener('resize', resize);

	// 纵深穿行：cam 是相机深度（无限前进，节点深度取模循环）；滚轮给速度冲量，下滚向前、上滚后退
	let cam = 0, camVel = 0;
	wrap.addEventListener('wheel', (e) => {
		if (!modal.classList.contains('hidden')) return; /* 弹窗开着时不许穿行 */
		e.preventDefault();
		const d = Math.max(-120, Math.min(120, e.deltaY));
		camVel = Math.max(-0.012, Math.min(0.012, camVel + d * 0.000045));
	}, { passive: false });

	// 220 颗星：各自带深度，跟文字同一套投影，穿行时从身边掠过
	const stars = [];
	for (let i = 0; i < 220; i++) {
		stars.push({
			angle: Math.random() * 6.283,
			rad: 0.08 + Math.random() * 0.55,
			z: Math.random(),
			r: Math.random() * 1.2 + 0.3,
			ph: Math.random() * 6.28,
		});
	}

	const openModal = (it) => {
		document.getElementById('thoughts-mtitle').textContent = it.title;
		document.getElementById('thoughts-mdate').textContent = it.dateLabel;
		document.getElementById('thoughts-mcontent').textContent = it.content;
		document.getElementById('thoughts-mupdated').textContent =
			it.updatedLabel ? `（更新于 ${it.updatedLabel}）` : '';
		modal.classList.remove('hidden');
	};

	// 文字节点 = DOM 元素（学 doulor 原版 ThoughtsParallax 的笛卡尔散布，不用极坐标）：
	// 极坐标「角度+半径」随机看着均匀、实际密度向中心收，条目一少就挤成一团还互相压字；
	// 改成把画面切成网格、每条占一格再格内抖动（格子数 ≥ 条目数，多出的空格随机跳过），
	// 任意条数都铺满全屏不重叠；z 仍按序号均分+抖动，保证纵深层次。
	const gridFor = (count) => {
		const cols = Math.max(1, Math.ceil(Math.sqrt(count * 1.6)));
		const rows = Math.max(1, Math.ceil(count / cols));
		const cells = [];
		for (let r = 0; r < rows; r++) for (let c = 0; c < cols; c++) cells.push([c, r]);
		for (let i = cells.length - 1; i > 0; i--) { /* 洗牌：哪几格空着、谁占哪格全随机 */
			const j = Math.floor(Math.random() * (i + 1));
			[cells[i], cells[j]] = [cells[j], cells[i]];
		}
		return { cols, rows, cells };
	};
	const grid = gridFor(Math.max(items.length, 1));
	const nodes = items.map((it, i) => {
		const el = document.createElement('span');
		el.className = 'thoughts-text';
		el.textContent = it.title;
		el.addEventListener('click', () => openModal(it));
		textsLayer.appendChild(el);
		const n = Math.max(items.length, 1);
		const [gc, gr] = grid.cells[i % grid.cells.length];
		return {
			it, el,
			nx: ((gc + 0.18 + Math.random() * 0.64) / grid.cols) * 2 - 1,
			ny: ((gr + 0.18 + Math.random() * 0.64) / grid.rows) * 2 - 1,
			z: ((i + 0.15 + Math.random() * 0.7) / n) % 1,
			sz: 0.6 + Math.random() * 0.4,
			pd: 1,
			w100: 0, /* 标题在 100px 字号下的宽度（离屏量一次，逐帧按比例算真实宽） */
			clickable: true,
			lastFs: -1,
		};
	});

	/* 量宽用的离屏 canvas：字体串取元素实际计算出的字体（= 站点主题字体），量出来的宽才和渲染一致 */
	const measureCtx = document.createElement('canvas').getContext('2d');
	function measureAll() {
		if (!nodes.length) return;
		const family = getComputedStyle(nodes[0].el).fontFamily;
		measureCtx.font = `500 100px ${family}`;
		for (const n of nodes) n.w100 = measureCtx.measureText(n.it.title).width;
	}
	measureAll();
	if (document.fonts && document.fonts.ready) document.fonts.ready.then(measureAll); /* 网络字体加载完再量一次，宽度才准 */

	let rot = 0;
	const relDepth = (z) => (((z - cam) % 1) + 1) % 1; /* 相对深度：0=贴脸，1=最远 */
	const persp = (d) => 1 / (0.22 + d * 1.9); /* 透视系数：近大远小 */
	const CRUISE = 0; /* 静止版（站长定）：无自动巡航，画面自己不动；advance 只来自滚轮冲量，衰减完即完全静止 */
	let lastT = 0;
	function frame(t) {
		const scale = lastT ? Math.min(2.5, Math.max(0.2, (t - lastT) / 16.7)) : 1;
		lastT = t;
		const advance = (CRUISE + camVel) * scale; /* 本帧前进量，星轨按它反推上一帧位置 */
		cam += advance;
		camVel *= Math.pow(0.94, scale);
		// 背景用 CSS 渐变，这里只清屏
		ctx.fillStyle = '#050510';
		ctx.fillRect(0, 0, W, H);

		const cx = W / 2, cy = H / 2;

		// 星星：用上一帧投影点连线成星轨——线天然沿径向从中心射出，越近拉得越长，就是星际穿越那味
		ctx.strokeStyle = '#fff';
		ctx.lineCap = 'round';
		for (const s of stars) {
			const d = relDepth(s.z);
			const p = persp(d);
			const a = s.angle + rot * 0.6;
			const x = cx + Math.cos(a) * s.rad * W * p * 0.5;
			const y = cy + Math.sin(a) * s.rad * H * 0.76 * p * 0.5;
			const dp = Math.min(1, d + advance);
			const pp = persp(dp);
			const px = cx + Math.cos(a) * s.rad * W * pp * 0.5;
			const py = cy + Math.sin(a) * s.rad * H * 0.76 * pp * 0.5;
			const near = Math.min(1, d / 0.08);
			ctx.globalAlpha = (0.3 + 0.5 * (0.5 + 0.5 * Math.sin(s.ph))) * (0.35 + 0.65 * (1 - d)) * near; /* 亮度按相位固定，不闪烁 */
			ctx.lineWidth = Math.max(0.5, s.r * p * 0.8);
			ctx.beginPath();
			ctx.moveTo(px, py);
			ctx.lineTo(x, y);
			ctx.stroke();
		}
		ctx.globalAlpha = 1;

		// 文字：投影结果写到 DOM 元素的 transform/字号/透明度上
		// 投影学 doulor：屏幕偏移 = 归一化坐标 × 半屏 × 透视系数，纵横同口径（原版的 0.76 纵向压扁已去掉，那也是画面显扁、文字挤在中带的原因之一）
		for (const n of nodes) {
			const d = relDepth(n.z);
			/* 刚从身边掠过、绕回最远处时换个位置，避免穿行路线一成不变 */
			if (n.pd < 0.15 && d > 0.85) { n.nx = (Math.random() * 2 - 1) * 0.92; n.ny = (Math.random() * 2 - 1) * 0.92; }
			n.pd = d;
			const p = persp(d);
			const x = cx + n.nx * W * p * 0.5;
			const y = cy + n.ny * H * p * 0.5;
			let fs = Math.max(8, Math.min(34, Math.round((11 + n.sz * 7) * p)));
			/* 长标题在窄屏上按宽度收字号：整行最多占画布宽 86%，不许顶出两边 */
			const tw = n.w100 * fs / 100;
			if (tw > W * 0.86 && tw > 0) fs = Math.max(8, Math.floor(fs * (W * 0.86) / tw));
			const near = Math.min(1, d / 0.16); /* 贴近时提前淡出，不糊脸 */
			const alpha = (0.9 + n.sz * 0.1) * (0.18 + 0.82 * Math.pow(1 - d, 1.35)) * near; /* 近亮远暗：远处小字压成背景质感，不再在中心挤成一团 */
			n.el.style.transform = `translate(${x.toFixed(1)}px, ${y.toFixed(1)}px) translate(-50%, -50%)`;
			if (fs !== n.lastFs) { n.el.style.fontSize = fs + 'px'; n.lastFs = fs; }
			n.el.style.opacity = alpha.toFixed(3);
			const click = alpha > 0.05; /* 几乎看不见的别挡点击 */
			if (click !== n.clickable) { n.el.style.pointerEvents = click ? 'auto' : 'none'; n.clickable = click; }
		}
		requestAnimationFrame(frame);
	}
	frame();

	document.getElementById('thoughts-close').onclick = () => modal.classList.add('hidden');
	modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.add('hidden'); });
</script>
