---
import { Icon } from "astro-icon/components";
import WidgetLayout from "@/components/common/WidgetLayout.astro";
import { announcementConfig } from "@/config/announcementConfig";
import I18nKey from "@/i18n/i18nKey";
import { i18n } from "@/i18n/translation";
import type { WidgetComponentConfig } from "@/types/config";

const config = announcementConfig;

interface Props {
	class?: string;
	style?: string;
	widgetConfig?: WidgetComponentConfig;
}
const { class: className, style, widgetConfig } = Astro.props;

const showTitle = widgetConfig?.showTitle !== false;
// 「了解更多」链接按当前模式取：检测版用 geoLink，静态用 link（geoLink 缺失时回落 link）
const activeLink = config.mode === "geo" ? (config.geoLink ?? config.link) : config.link;
// 链接指向某条博客线路、且跳转方式为「智能选路线」时，点击走智能分流（见组件末尾脚本）；
// 跳转方式为 original（原链接）时不挂任何处理，照配置地址直达
const LINE_HOSTS = ["hk.lanerc.me", "origin.lanerc.me"];
let isLineLink = false;
try {
	isLineLink = LINE_HOSTS.includes(new URL(activeLink?.url || "").hostname);
} catch {}
const smartLink = config.linkRouting === "smart" && isLineLink;
---

<!-- 组件显示现在由sidebarLayoutConfig统一控制，无需检查config.enable -->
<WidgetLayout
  name={config.title || i18n(I18nKey.announcement)}
  showTitle={showTitle}
  id="announcement"
  class={className}
  style={style}
>
  <div>
    <!-- 公告栏内容 -->
    <div class="announcement-content text-neutral-600 dark:text-neutral-300 leading-relaxed mb-3">
      {config.content}
    </div>

    <!-- 可选链接和关闭按钮 -->
    <div class="flex items-center justify-between gap-3">
      <div>
        {
          activeLink && activeLink.enable !== false && (
            <a
              href={activeLink.url}
              {...(smartLink ? { "data-line-smart": true } : {})}
              target={activeLink.external ? "_blank" : "_self"}
              rel={activeLink.external ? "noopener noreferrer" : undefined}
              class="btn-regular rounded-lg px-3 py-1.5 text-sm font-medium active:scale-95 transition-transform"
            >
              {activeLink.text}
            </a>
          )
        }
      </div>

      {
        config.closable && (
          <button
            class="btn-regular rounded-lg h-8 w-8 text-sm hover:bg-red-100 dark:hover:bg-red-900/30 transition-colors"
            onclick="this.closest('widget-layout').style.display='none'"
            aria-label={i18n(I18nKey.announcementClose)}
          >
            <Icon name="fa7-solid:xmark" class="text-sm" />
          </button>
        )
      }
    </div>
  </div>
  {
    config.mode === "geo" && (
      <script>
        import { announcementConfig } from "@/config/announcementConfig";
        // 配置全站一份：脚本用普通打包脚本（不再 define:vars 按实例内联），
        // Astro 每页只出一份、执行一次即按 class 更新全部公告实例，省掉
        // 重复内联的那份 19.6KB。值与 announcementConfig 同源同口径。
        const geoTemplate = announcementConfig.geoTemplate || "";
        const ownerLat = announcementConfig.ownerLat ?? 0;
        const ownerLon = announcementConfig.ownerLon ?? 0;
        const staticContent = announcementConfig.content || "";
