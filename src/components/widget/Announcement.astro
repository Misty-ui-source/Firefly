                if (code === 'JS' && JS_CITY[v.city]) { place = JS_CITY[v.city][0]; local = JS_CITY[v.city][1]; }
                else if (code === 'HA' && HA_CITY[v.city]) { place = HA_CITY[v.city][0]; local = HA_CITY[v.city][1]; }
