---
// 璨夜 bento 格 · 每日选刊格：与内容栏版 DailyBriefing 同一拼装
// （utils/daily-briefing.ts），矩阵里整行出。显隐与落位见 astral-mode.css。
import { getBriefingItems } from "@/utils/daily-briefing";

const items = (await getBriefingItems()).slice(0, 4);
const today = new Date();
const dateLabel = `${today.getMonth() + 1} 月 ${today.getDate()} 日`;
const fmt = (d: Date) => `${d.getMonth() + 1}/${d.getDate()}`;
---

{
	items.length > 0 && (
		<section class="card-base astral-tile astral-tile--briefing" aria-label="每日选刊">
			<header class="db-head">
				<span class="db-title">每日选刊</span>
				<span class="db-date">{dateLabel}</span>
			</header>
			<ul class="db-list">
				{items.map((it) => (
					<li class="db-item">
						<span class:list={["db-source", { "db-source--pin": it.pinned }]}>
							{it.pinned ? "置顶" : it.source}
						</span>
						<a
							class="db-link"
							href={it.url}
							target={it.external ? "_blank" : undefined}
							rel={it.external ? "noopener" : undefined}
						>
							{it.title}
						</a>
						<time class="db-time">{fmt(it.date)}</time>
					</li>
				))}
			</ul>
		</section>
	)
}

<style>
	.astral-tile--briefing {
		flex-direction: column;
		padding: 1rem 1.25rem 0.7rem;
	}
	.db-head {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		margin-bottom: 0.3rem;
	}
	.db-title {
		font-weight: 700;
		font-size: 1.02rem;
		position: relative;
		padding-left: 0.75rem;
	}
	.db-title::before {
		content: "";
		position: absolute;
		left: 0;
		top: 50%;
		transform: translateY(-50%);
		width: 0.25rem;
		height: 1rem;
		border-radius: 0.375rem;
		background: var(--primary);
	}
	.db-date {
		font-size: 0.78rem;
		opacity: 0.65;
	}
	.db-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.db-item {
		display: flex;
		align-items: baseline;
		gap: 0.6rem;
		padding: 0.34rem 0;
		border-top: 1px dashed rgb(128 128 128 / 0.18);
	}
	.db-source {
		flex: none;
		font-size: 0.68rem;
		font-weight: 700;
		padding: 0.08rem 0.42rem;
		border-radius: 999px;
		background: rgb(128 128 128 / 0.14);
		max-width: 7rem;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.db-source--pin {
		background: var(--primary);
		color: white;
	}
	.db-link {
		flex: 1;
		min-width: 0;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.db-link:hover {
		color: var(--primary);
	}
	.db-time {
		flex: none;
		font-size: 0.72rem;
		opacity: 0.55;
	}
</style>
