---
import { render } from "astro:content";
import { siteConfig } from "@/config";
import { getSortedPosts } from "@/utils/content-utils";
import { getPostUrlBySlug, url } from "@/utils/url-utils";

/**
 * 手册（manual）首页字标 hero：只在纸舟·手册主题下点亮（守卫在 main.css
 * 常加载，本组件默认 display:none；点亮规则在 paper-mode.css 手册段）。
 * 结构与数据口径对齐参考站首页：字段行（日期 / 运行天数 / 篇数 / 总字数）、
 * 实心站名 + 描边域名、黄 marker 副题、切角按钮组、最新一篇画框（描边编号）。
 * 全部数字都是真数据：篇数/总字数与站点统计同一算法（正文去代码后
 * 中文字符 + 拉丁字母计数），编号 = 按 published 升序的真实序号。
 */
const posts = await getSortedPosts();
const total = posts.length;
const latest = posts[0];
const latestNo = total; // 升序编号：最新一篇就是总数
const latestUrl = latest ? getPostUrlBySlug(latest.id) : url("/");

let latestWords = 0;
if (latest) {
	const { remarkPluginFrontmatter } = await render(latest);
	latestWords = remarkPluginFrontmatter.words ?? 0;
}

let totalWords = 0;
for (const post of posts) {
	if (post.body) {
		const text = post.body
			.replace(/```[\s\S]*?```/g, "")
			.replace(/`[^`]*`/g, "")
			.replace(/\s+/g, " ")
			.trim();
		const chinese = text.match(/[\u4e00-\u9fa5]/g) || [];
		const latin = text.match(/[a-zA-Z]/g) || [];
		totalWords += chinese.length + latin.length;
	}
}

const start = new Date(`${siteConfig.siteStartDate || "2026-10-15"}T00:00:00+08:00`);
const now = new Date();
const days = Math.max(1, Math.floor((now.getTime() - start.getTime()) / 86400000) + 1);
const pad2 = (n: number) => String(n).padStart(2, "0");
const todayStr = `${now.getFullYear()}.${pad2(now.getMonth() + 1)}.${pad2(now.getDate())}`;
const latestDate = latest
	? `${latest.data.published.getFullYear()}.${pad2(latest.data.published.getMonth() + 1)}.${pad2(latest.data.published.getDate())}`
	: "";
const noStr = String(latestNo).padStart(3, "0");
const fmt = (n: number) => n.toLocaleString("en-US");
---

<section class="manual-hero" aria-label="站点概览">
	<p class="mn-hero-meta">
		<time>{todayStr}</time>
		<span>第 <b data-mn-fx-load>{days}</b> 天</span>
		<span><b data-mn-fx-load>{total}</b> 篇</span>
		<span><b data-mn-fx-load>{fmt(totalWords)}</b> 字</span>
	</p>

	<h2 class="mn-wordmark">
		<span class="mn-wordmark-solid mn-in-drive">Alexander</span>
		<span class="mn-wordmark-hollow mn-in-drive" style="animation-delay: 140ms" aria-hidden="true">LANERC.ME</span>
	</h2>

	<div class="mn-hero-copy">
		<p class="mn-claim"><span class="mn-marker mn-in-stroke">{siteConfig.subtitle}</span></p>
		<p class="mn-bio">{siteConfig.description}</p>
		<p class="mn-actions">
			<a class="mn-btn mn-btn-go" href={latestUrl}>读最新一篇 <span class="mn-btn-sub">No.{noStr}</span></a>
			<a class="mn-btn" href={url("/archive/")}>全部文章</a>
			<a class="mn-btn" href={url("/about/")}>关于本站</a>
		</p>
	</div>

	{latest && (
		<a class="mn-frame" href={latestUrl} data-mn-fx-host>
			<span class="mn-frame-window">
				<span class="mn-hollow-no" aria-hidden="true" data-mn-fx>{noStr}</span>
				<span class="mn-frame-title">{latest.data.title}</span>
				<span class="mn-field">{latestDate} / {fmt(latestWords)} 字</span>
			</span>
			<span class="mn-plate">最新发布，点开就读。</span>
		</a>
	)}

	{posts.length > 0 && (
		<div class="mn-ticker">
			<div class="mn-ticker-track">
				{[0, 1].map((run) => (
					<span class="mn-ticker-run" aria-hidden={run === 1 ? "true" : undefined}>
						{posts.slice(0, 8).map((p, i) => (
							<a class="mn-ticker-item" href={getPostUrlBySlug(p.id)} tabindex={run === 1 ? -1 : undefined}><b>No.{String(total - i).padStart(3, "0")}</b>{p.data.title}</a>
						))}
					</span>
				))}
			</div>
		</div>
	)}
</section>

<!-- 读数特效（参考站 fx.js 的 scramble 同款）：数字/字母像面板计数器一样
     滚动并从左到右逐字锁定。字段行数字在页面打开时依次落定（600ms，
     间隔压进 180ms 内）；画框编号在指针进入/聚焦画框时落定（360ms），
     与 CSS 的灌墨同时发生。prefers-reduced-motion 时完全不跑。 -->
<script is:inline>
	(function () {
		if (window.__mnFxBound) {
			if (window.__mnFxRun) window.__mnFxRun();
			return;
		}
		window.__mnFxBound = true;
		var still =
			typeof matchMedia === "function"
				? matchMedia("(prefers-reduced-motion: reduce)")
				: { matches: true };
		var running = new WeakMap();
		function stand(ch) {
			if (/\d/.test(ch)) return String(Math.floor(Math.random() * 10));
			if (/[A-Za-z]/.test(ch))
				return String.fromCharCode(
					(ch < "a" ? 65 : 97) + Math.floor(Math.random() * 26),
				);
			return ch;
		}
		function scramble(el, ms) {
			ms = ms || 360;
			if (still.matches) return;
			var before = running.get(el);
			if (before) cancelAnimationFrame(before.frame);
			var nodes = before ? before.nodes : null;
			if (!nodes) {
				nodes = [];
				var walk = document.createTreeWalker(el, NodeFilter.SHOW_TEXT);
				var n;
				while ((n = walk.nextNode())) nodes.push({ n: n, final: n.data });
			}
			var final = nodes
				.map(function (x) {
					return x.final;
				})
				.join("");
			if (!/[0-9A-Za-z]/.test(final)) return;
			var labelled = before ? before.labelled : el.hasAttribute("aria-label");
			if (!labelled) el.setAttribute("aria-label", final.trim());
			var started = performance.now();
			var state = { nodes: nodes, labelled: labelled, frame: 0 };
			running.set(el, state);
			var step = function (now) {
				var done = Math.min(1, (now - started) / ms);
				var locked = Math.floor(done * final.length);
				for (var i = 0; i < nodes.length; i++) {
					var x = nodes[i];
					var keep = Math.max(0, Math.min(x.final.length, locked));
					x.n.data =
						x.final.slice(0, keep) +
						x.final
							.slice(keep)
							.split("")
							.map(stand)
							.join("");
					locked -= x.final.length;
				}
				if (done < 1) {
					state.frame = requestAnimationFrame(step);
				} else {
					for (var j = 0; j < nodes.length; j++) nodes[j].n.data = nodes[j].final;
					if (!labelled) el.removeAttribute("aria-label");
					running.delete(el);
				}
			};
			state.frame = requestAnimationFrame(step);
		}
		function run() {
			var hero = document.querySelector(".manual-hero");
			if (!hero || still.matches) return;
			var load = hero.querySelectorAll("[data-mn-fx-load]");
			var gap = load.length > 1 ? Math.min(40, 180 / (load.length - 1)) : 0;
			load.forEach(function (el, i) {
				setTimeout(function () {
					scramble(el, 600);
				}, 120 + i * gap);
			});
			var host = hero.querySelector("[data-mn-fx-host]");
			if (host && !host.__mnFxHost) {
				host.__mnFxHost = true;
				var go = function () {
					host.querySelectorAll("[data-mn-fx]").forEach(function (el) {
						scramble(el);
					});
				};
				host.addEventListener("pointerenter", go);
				host.addEventListener("focus", go);
			}
		}
		window.__mnFxRun = run;
		run();
		document.addEventListener("swup:contentReplaced", function () {
			setTimeout(run, 0);
		});
	})();
</script>

<!-- 手册首页右栏构成（站长 2026-11-01 定）：动态 / 公告 / 最新评论 / 日历。
     公告部件本体在左栏，纯 CSS 搬不过栏，只在「纸舟·手册 + 首页 + ≥1280」
     时用脚本把它的节点挪进右栏、排在动态之后；形态切走或窗口变窄时原样
     挪回左栏原位。其他部件的显隐在 paper-mode.css 手册首页段（仅不显示）。 -->
<script is:inline>
	(function () {
		if (window.__mnAnnBound) {
			if (window.__mnAnnApply) window.__mnAnnApply();
			return;
		}
		window.__mnAnnBound = true;
		var ann = null;
		var home = null;
		var homeNext = null;
		var moved = false;
		function find() {
			if (!ann || !ann.isConnected) {
				ann = document.querySelector('#left-sidebar-wrapper widget-layout[data-id="announcement"], #right-sidebar-static widget-layout[data-id="announcement"]');
				if (ann && !moved) {
					home = ann.parentNode;
					homeNext = ann.nextElementSibling;
				}
			}
			return ann;
		}
		function apply() {
			var de = document.documentElement;
			var on =
				de.getAttribute("data-site-mode") === "paper" &&
				de.getAttribute("data-paper-theme") === "manual" &&
				window.innerWidth >= 1280;
			var a = find();
			if (!a) return;
			if (on && !moved) {
				var dyn = document.querySelector('#right-sidebar-static widget-layout[data-id="latest-dynamics"]');
				if (dyn && dyn.parentNode && a.parentNode !== dyn.parentNode) {
					dyn.parentNode.insertBefore(a, dyn.nextSibling);
					moved = true;
				}
			} else if (!on && moved) {
				if (home) {
					if (homeNext && homeNext.parentNode === home) home.insertBefore(a, homeNext);
					else home.appendChild(a);
				}
				moved = false;
			}
		}
		window.__mnAnnApply = apply;
		new MutationObserver(apply).observe(document.documentElement, {
			attributes: true,
			attributeFilter: ["data-site-mode", "data-paper-theme"],
		});
		// 本站 swup 派发 v4 钩子名 swup:page:view；contentReplaced 是旧名不派发，留作兜底
		var onSwupNav = function () {
			ann = null;
			moved = false;
			setTimeout(apply, 0);
		};
		document.addEventListener("swup:page:view", onSwupNav);
		document.addEventListener("swup:contentReplaced", onSwupNav);
		window.addEventListener("resize", apply);
		if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", apply);
		else apply();
	})();
</script>
