---

<div class="mxdock-overlay" id="mxdock-overlay" aria-hidden="true"></div>

<section
	class="mxdock"
	id="mxdock"
	data-shape="pill"
	data-view="menu"
	aria-label="工具坞"
>
	<div class="mxdock__bar">
		<div class="mxdock__context">
			<a class="mxdock__site-mark" href={url("/")} aria-label={dockTitle}>
				<img src={dockAvatar} alt="" />
			</a>
			<button
				class="mxdock__context-action"
				id="mxdock-context-btn"
				type="button"
				aria-label={dockTitle}
			>
				<span class="mxdock__back-mark" aria-hidden="true">
					<Fragment set:html={ico("back")} />
				</span>
				<span class="mxdock__context-viewport">
					<span class="mxdock__site-title">{dockTitle}</span>
					<span class="mxdock__lyric-viewport" id="mxdock-lyric-viewport">
						<span class="mxdock__lyric-text" id="mxdock-lyric-text"></span>
					</span>
					<span class="mxdock__view-title" id="mxdock-view-title">菜单</span>
				</span>
			</button>
		</div>

		<button
			class="mxdock__menu-toggle"
			id="mxdock-menu-btn"
			type="button"
			aria-label="菜单"
			aria-controls="mxdock-card"
			aria-expanded="false"
		>
			<span class="mxdock__menu-icon" aria-hidden="true">
				<Fragment set:html={ico("menu")} />
			</span>
			<span class="mxdock__close-icon" aria-hidden="true">
				<Fragment set:html={ico("close")} />
			</span>
		</button>
	</div>

	<div class="mxdock__card" id="mxdock-card" aria-hidden="true">
		<div class="mxdock__card-inner" tabindex="-1">
			<div class="mxdock__views">
				<section
					class="mxdock__view is-active"
					data-dock-view="menu"
					data-title="菜单"
				>
					<nav class="mxdock__menu" aria-label="菜单">
						{links.map((link, index) =>
							link.children && link.children.length > 0 ? (
								<div class="mxdock__accordion" data-dock-accordion>
									<button
										class="mxdock__menu-row mxdock__accordion-trigger"
										type="button"
										aria-expanded="false"
										aria-controls={`mxdock-submenu-${index}`}
									>
										<span class="mxdock__menu-row-main">
											{link.icon && <Icon name={link.icon} />}
											<span>{link.name}</span>
										</span>
										<span class="mxdock__accordion-arrow" aria-hidden="true">
											<Fragment set:html={ico("chevron")} />
										</span>
									</button>
									<div
										class="mxdock__submenu"
										id={`mxdock-submenu-${index}`}
										aria-hidden="true"
										inert
									>
										<div class="mxdock__submenu-inner">
											{link.children.map((child) => (
												<a
													href={child.external ? child.url : url(child.url)}
													class="mxdock__submenu-row"
													target={child.external ? "_blank" : undefined}
													rel={child.external ? "noopener noreferrer" : undefined}
													data-dock-navigation
												>
													{child.icon && <Icon name={child.icon} />}
													<span>{child.name}</span>
													{child.external && (
														<Icon
															name="fa7-solid:arrow-up-right-from-square"
															class="mxdock__external-icon"
														/>
													)}
												</a>
											))}
										</div>
									</div>
								</div>
							) : (
								<a
									href={link.external ? link.url : url(link.url)}
									class="mxdock__menu-row"
									target={link.external ? "_blank" : undefined}
									rel={link.external ? "noopener noreferrer" : undefined}
									data-dock-navigation
								>
									<span class="mxdock__menu-row-main">
										{link.icon && <Icon name={link.icon} />}
										<span>{link.name}</span>
									</span>
									{link.external && (
										<Icon
											name="fa7-solid:arrow-up-right-from-square"
											class="mxdock__external-icon"
										/>
									)}
								</a>
							),
						)}
					</nav>
				</section>

				<section class="mxdock__view" data-dock-view="music" data-title="音乐" hidden>
					<div
						class="mxdock__playlist"
						id="mxdock-playlist"
						role="listbox"
						aria-label="歌单"
					>
						<p class="mxdock__empty" id="mxdock-music-empty">暂无正在播放</p>
					</div>
					<div class="mxdock__transport">
						<div class="mxdock__progress-row">
							<span id="mxdock-current-time">0:00</span>
							<input
								class="mxdock__progress"
								id="mxdock-progress"
								type="range"
								min="0"
								max="100"
								step="0.1"
								value="0"
								aria-label="播放进度"
							/>
							<span id="mxdock-duration">0:00</span>
						</div>
						<div class="mxdock__transport-buttons">
							<button type="button" id="mxdock-mode-btn" aria-label="播放模式：顺序播放" aria-pressed="false">
								<span class="mxdock__mode-list-icon" aria-hidden="true"><Fragment set:html={ico("repeat")} /></span>
								<span class="mxdock__mode-single-icon is-hidden" aria-hidden="true"><Fragment set:html={ico("repeatOne")} /></span>
								<span class="mxdock__mode-shuffle-icon is-hidden" aria-hidden="true"><Fragment set:html={ico("shuffle")} /></span>
							</button>
							<button type="button" id="mxdock-prev-btn" aria-label="上一首">
								<Fragment set:html={ico("prev")} />
							</button>
							<button class="mxdock__play-button" type="button" id="mxdock-play-btn" aria-label="播放">
								<span class="mxdock__play-icon" aria-hidden="true"><Fragment set:html={ico("play")} /></span>
								<span class="mxdock__pause-icon is-hidden" aria-hidden="true"><Fragment set:html={ico("pause")} /></span>
							</button>
							<button type="button" id="mxdock-next-btn" aria-label="下一首">
								<Fragment set:html={ico("next")} />
							</button>
							<button type="button" id="mxdock-mute-btn" aria-label="音量" aria-pressed="false">
								<span class="mxdock__volume-up-icon" aria-hidden="true"><Fragment set:html={ico("volUp")} /></span>
								<span class="mxdock__volume-off-icon is-hidden" aria-hidden="true"><Fragment set:html={ico("volOff")} /></span>
							</button>
						</div>
					</div>
				</section>

				<section class="mxdock__view" data-dock-view="toc" data-title="目录" hidden>
					<div class="mxdock__toc">
						<div id="mxdock-toc-content"></div>
					</div>
				</section>
			</div>

			<nav class="mxdock__toolbar" aria-label="工具">
				<button type="button" id="mxdock-search-btn" aria-label="搜索">
					<Fragment set:html={ico("search")} />
					<span>搜索</span>
				</button>
				<button type="button" id="mxdock-theme-btn" aria-label="主题">
					<span class="mxdock__theme-light" aria-hidden="true"><Fragment set:html={ico("sun")} /></span>
					<span class="mxdock__theme-dark is-hidden" aria-hidden="true"><Fragment set:html={ico("moon")} /></span>
					<span>主题</span>
				</button>
				<button type="button" data-view-target="music" aria-label="音乐">
					<Fragment set:html={ico("music")} />
					<span>音乐</span>
				</button>
				<button class="is-hidden" type="button" id="mxdock-toc-btn" data-view-target="toc" aria-label="目录">
					<Fragment set:html={ico("toc")} />
					<span>目录</span>
				</button>
				<button class="is-hidden" type="button" id="mxdock-comment-btn" aria-label="评论">
					<Fragment set:html={ico("comment")} />
					<span>评论</span>
				</button>
				<button class="is-hidden" type="button" id="mxdock-top-btn" aria-label="回到顶部">
					<Fragment set:html={ico("up")} />
					<span>顶部</span>
				</button>
			</nav>
		</div>
	</div>
</section>

<style is:global>
	/* ============================================
	   明信移动端统一变形 Dock（移植自原站 mobile-dock.css，类名 mxdock 前缀）
	   胶囊 / 滚动气泡 / 内容卡三态；仅「明信 + ≤768px」点亮，
	   默认隐藏守卫在 main.css（.mxdock / .mxdock-overlay）。
	   ============================================ */
	@media (max-width: 768px) {
		html[data-site-mode="mingxin"] .mxdock {
			--mxdock-surface: #e7e7e7;
			--mxdock-edge: max(0.75rem, env(safe-area-inset-right, 0px));
			--mxdock-bottom: max(0.5rem, env(safe-area-inset-bottom, 0px));
			--mxdock-motion: cubic-bezier(0.22, 1, 0.36, 1);
			--mxdock-content-top-padding: 0.75rem;
			--mxdock-inset-left: 0.75rem;
			position: fixed;
			right: var(--mxdock-edge);
			bottom: var(--mxdock-bottom);
			z-index: 74;
			display: flex;
			flex-direction: column-reverse;
			align-items: stretch;
			width: calc(
				100vw - var(--mxdock-edge) -
					max(var(--mxdock-inset-left), env(safe-area-inset-left, 0px))
			);
			max-width: calc(100vw - 1.5rem);
			max-height: 70dvh;
			color: var(--deep-text);
			background: var(--mxdock-surface);
			border: 0;
			border-radius: 1.825rem;
			box-shadow: 0 0.65rem 1.8rem rgb(0 0 0 / 14%);
			overflow: hidden;
			transform-origin: bottom right;
			transition:
				width 500ms var(--mxdock-motion),
				border-radius 500ms var(--mxdock-motion),
				transform 500ms var(--mxdock-motion),
				opacity 180ms ease,
				box-shadow 240ms ease;
		}

		html.dark[data-site-mode="mingxin"] .mxdock {
			--mxdock-surface: #181818;
			box-shadow: 0 0.65rem 1.8rem rgb(0 0 0 / 34%);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="bubble"] {
			width: 3.65rem;
			height: 3.65rem;
			min-height: 3.65rem;
			max-height: 3.65rem;
			aspect-ratio: 1;
			border-radius: 50%;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="pill"] {
			border-radius: 1.825rem;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] {
			border-radius: 1.25rem;
		}

		html[data-site-mode="mingxin"] .mxdock.is-keyboard-open {
			transform: translateY(calc(100% + var(--mxdock-bottom) + 1rem));
			opacity: 0;
			pointer-events: none;
		}

		html[data-site-mode="mingxin"] .mxdock__bar {
			display: flex;
			align-items: center;
			gap: 0.35rem;
			min-height: 3.25rem;
			padding: 0.2rem 0.35rem 0.2rem 0.65rem;
			transition:
				border-color 200ms ease,
				padding 260ms ease;
		}

		html[data-site-mode="mingxin"] .mxdock__context-action,
		html[data-site-mode="mingxin"] .mxdock__menu-toggle,
		html[data-site-mode="mingxin"] .mxdock__toolbar button,
		html[data-site-mode="mingxin"] .mxdock__transport button,
		html[data-site-mode="mingxin"] .mxdock__playlist-item,
		html[data-site-mode="mingxin"] .mxdock__menu-row,
		html[data-site-mode="mingxin"] .mxdock__submenu-row {
			border: 0;
			color: inherit;
			background: transparent;
			cursor: pointer;
			-webkit-tap-highlight-color: transparent;
		}

		html[data-site-mode="mingxin"] .mxdock__context {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			min-width: 0;
			min-height: 2.75rem;
			flex: 1;
			padding: 0 0.25rem;
			border-radius: var(--radius-full);
			overflow: hidden;
			transition:
				flex-basis 320ms var(--mxdock-motion),
				opacity 160ms ease,
				padding 260ms ease,
				background-color 180ms ease;
		}

		html[data-site-mode="mingxin"] .mxdock__context-action {
			display: flex;
			align-items: center;
			gap: 0.65rem;
			min-width: 0;
			min-height: 2.75rem;
			flex: 1;
			padding: 0 0.25rem;
			text-align: left;
			border-radius: var(--radius-full);
			overflow: hidden;
		}

		html[data-site-mode="mingxin"] .mxdock__context-action:active,
		html[data-site-mode="mingxin"] .mxdock__menu-toggle:active,
		html[data-site-mode="mingxin"] .mxdock__toolbar button:active,
		html[data-site-mode="mingxin"] .mxdock__transport button:active {
			background: var(--btn-plain-bg-active);
		}

		html[data-site-mode="mingxin"] .mxdock__site-mark {
			display: none;
			place-items: center;
			width: 2.75rem;
			height: 2.75rem;
			flex: 0 0 2.75rem;
			border-radius: 50%;
			color: inherit;
			overflow: hidden;
			-webkit-tap-highlight-color: transparent;
		}

		html[data-site-mode="mingxin"] .mxdock__site-mark img {
			display: block;
			width: 1.75rem;
			height: 1.75rem;
			border-radius: 50%;
			object-fit: cover;
		}

		html[data-site-mode="mingxin"] .mxdock__back-mark {
			display: none;
			place-items: center;
			width: 1.65rem;
			height: 1.65rem;
			flex: 0 0 auto;
			font-size: 1.2rem;
			color: var(--primary);
		}

		html[data-site-mode="mingxin"] .mxdock__back-mark svg {
			width: 1.2rem;
			height: 1.2rem;
		}

		html[data-site-mode="mingxin"] .mxdock__context-viewport {
			display: block;
			min-width: 0;
			flex: 1;
			overflow: hidden;
		}

		html[data-site-mode="mingxin"] .mxdock__site-title,
		html[data-site-mode="mingxin"] .mxdock__view-title {
			display: block;
			overflow: hidden;
			text-overflow: ellipsis;
			white-space: nowrap;
			font-size: 1rem;
			font-weight: 650;
			letter-spacing: 0.01em;
		}

		html[data-site-mode="mingxin"] .mxdock__view-title,
		html[data-site-mode="mingxin"] .mxdock__lyric-viewport {
			display: none;
		}

		html[data-site-mode="mingxin"] .mxdock__lyric-viewport {
			min-width: 0;
			width: 100%;
			padding-left: 0.5rem;
			overflow: hidden;
			white-space: nowrap;
			mask-image: linear-gradient(
				90deg,
				transparent 0,
				#000 0.5rem,
				#000 calc(100% - 0.5rem),
				transparent 100%
			);
			-webkit-mask-image: linear-gradient(
				90deg,
				transparent 0,
				#000 0.5rem,
				#000 calc(100% - 0.5rem),
				transparent 100%
			);
		}

		html[data-site-mode="mingxin"] .mxdock__lyric-text {
			display: inline-block;
			min-width: max-content;
			font-size: 0.95rem;
			font-weight: 600;
			line-height: 1.4;
			will-change: transform;
		}

		html[data-site-mode="mingxin"] .mxdock__lyric-text.is-marquee {
			animation: mxdock-lyric-marquee var(--mxdock-lyric-duration, 7s)
				ease-in-out infinite alternate;
		}

		html[data-site-mode="mingxin"] .mxdock__lyric-text.is-paused {
			animation-play-state: paused;
		}

		html[data-site-mode="mingxin"]
			.mxdock.has-playing-context[data-shape="pill"]
			.mxdock__site-title {
			display: none;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="pill"] .mxdock__site-mark {
			display: grid;
		}

		html[data-site-mode="mingxin"]
			.mxdock.has-playing-context[data-shape="pill"]
			.mxdock__context {
			gap: 0.25rem;
		}

		html[data-site-mode="mingxin"]
			.mxdock.has-playing-context[data-shape="pill"]
			.mxdock__lyric-viewport {
			display: block;
		}

		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"]:not(.is-child-view)
			.mxdock__site-mark {
			display: grid;
		}

		html[data-site-mode="mingxin"]
			.mxdock.has-playing-context[data-shape="card"]:not(.is-child-view)
			.mxdock__site-title {
			display: none;
		}

		html[data-site-mode="mingxin"]
			.mxdock.has-playing-context[data-shape="card"]:not(.is-child-view)
			.mxdock__lyric-viewport {
			display: block;
		}

		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"].is-child-view
			.mxdock__site-title,
		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"].is-child-view
			.mxdock__lyric-viewport,
		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"].is-child-view
			.mxdock__site-mark {
			display: none;
		}

		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"].is-child-view
			.mxdock__view-title {
			display: block;
		}

		html[data-site-mode="mingxin"]
			.mxdock[data-shape="card"].is-child-view
			.mxdock__back-mark {
			display: grid;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="bubble"] .mxdock__context {
			flex: 0 0 0;
			width: 0;
			min-height: 0;
			padding: 0;
			opacity: 0;
			pointer-events: none;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-toggle {
			display: grid;
			place-items: center;
			position: relative;
			width: 2.85rem;
			height: 2.85rem;
			flex: 0 0 2.85rem;
			border-radius: var(--radius-full);
			font-size: 1.5rem;
			transition:
				background-color 180ms ease,
				transform 260ms var(--mxdock-motion);
		}

		html[data-site-mode="mingxin"] .mxdock__menu-toggle svg {
			width: 1.5rem;
			height: 1.5rem;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="bubble"] .mxdock__bar {
			width: 100%;
			height: 100%;
			min-height: 0;
			justify-content: center;
			padding: 0.4rem;
			box-sizing: border-box;
		}

		html[data-site-mode="mingxin"]
			.mxdock[data-shape="bubble"]
			.mxdock__menu-toggle {
			width: 2.8rem;
			flex-basis: 2.8rem;
			transform: none;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-icon,
		html[data-site-mode="mingxin"] .mxdock__close-icon {
			position: absolute;
			inset: 0;
			display: grid;
			place-items: center;
			transition:
				opacity 180ms ease,
				transform 260ms var(--mxdock-motion);
		}

		html[data-site-mode="mingxin"] .mxdock__close-icon {
			opacity: 0;
			transform: rotate(-90deg) scale(0.72);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__menu-icon {
			opacity: 0;
			transform: rotate(90deg) scale(0.72);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__close-icon {
			opacity: 1;
			transform: rotate(0) scale(1);
		}

		html[data-site-mode="mingxin"] .mxdock.is-closing .mxdock__menu-icon {
			opacity: 1;
			transform: rotate(0) scale(1);
		}

		html[data-site-mode="mingxin"] .mxdock.is-closing .mxdock__close-icon {
			opacity: 0;
			transform: rotate(-90deg) scale(0.72);
		}

		html[data-site-mode="mingxin"] .mxdock__card {
			display: grid;
			grid-template-rows: 0fr;
			min-width: 0;
			min-height: 0;
			overflow: hidden;
			pointer-events: none;
			transition: grid-template-rows 500ms var(--mxdock-motion);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__card {
			grid-template-rows: 1fr;
			pointer-events: auto;
		}

		html[data-site-mode="mingxin"] .mxdock.is-closing .mxdock__card {
			grid-template-rows: 0fr;
			pointer-events: none;
			transition: grid-template-rows 500ms var(--mxdock-motion);
		}

		html[data-site-mode="mingxin"] .mxdock__card-inner {
			display: flex;
			flex-direction: column;
			min-height: 0;
			max-height: calc(70dvh - 3.25rem);
			overflow: hidden;
			outline: none;
		}

		html[data-site-mode="mingxin"] .mxdock__views,
		html[data-site-mode="mingxin"] .mxdock__toolbar {
			opacity: 0;
			transform: translate3d(0, 0.65rem, 0);
			transition:
				opacity 200ms ease,
				transform 280ms var(--mxdock-motion);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__views,
		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__toolbar {
			opacity: 1;
			transform: translate3d(0, 0, 0);
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__views {
			transition-delay: 150ms;
		}

		html[data-site-mode="mingxin"] .mxdock[data-shape="card"] .mxdock__toolbar {
			transition-delay: 220ms;
		}

		html[data-site-mode="mingxin"] .mxdock.is-closing .mxdock__views {
			opacity: 0;
			transform: translate3d(0, 0.65rem, 0);
			transition-delay: 0ms;
		}

		html[data-site-mode="mingxin"] .mxdock.is-closing .mxdock__toolbar {
			opacity: 0;
			transform: none;
			transition: none;
		}

		html[data-site-mode="mingxin"] .mxdock__views {
			min-height: 0;
			max-height: calc(70dvh - 7.3rem - var(--mxdock-content-top-padding));
			padding-top: var(--mxdock-content-top-padding);
			box-sizing: border-box;
			overflow: hidden;
		}

		html[data-site-mode="mingxin"] .mxdock__view {
			display: none;
			flex-direction: column;
			min-height: 0;
			max-height: calc(
				70dvh - 7.3rem - var(--mxdock-content-top-padding) * 2
			);
			overflow-y: auto;
			overflow-x: hidden;
			overscroll-behavior: contain;
			-webkit-overflow-scrolling: touch;
		}

		html[data-site-mode="mingxin"] .mxdock__view.is-active {
			display: flex;
			animation: mxdock-view-in 220ms ease-out;
		}

		html[data-site-mode="mingxin"] .mxdock__view[hidden],
		html[data-site-mode="mingxin"] .mxdock .is-hidden {
			display: none !important;
		}

		html[data-site-mode="mingxin"] .mxdock__menu {
			padding: 0.35rem 0.85rem 0.75rem;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row,
		html[data-site-mode="mingxin"] .mxdock__submenu-row {
			display: flex;
			align-items: center;
			justify-content: space-between;
			gap: 0.75rem;
			width: 100%;
			min-height: 3.25rem;
			padding: 0.65rem 0.4rem;
			text-decoration: none;
			color: inherit;
			font-size: 1rem;
			font-weight: 560;
			transition:
				color 160ms ease,
				background-color 160ms ease,
				padding 180ms ease;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row {
			border-bottom: 1px solid var(--line-divider);
		}

		html[data-site-mode="mingxin"]
			.mxdock__menu
			> .mxdock__menu-row:last-child,
		html[data-site-mode="mingxin"]
			.mxdock__menu
			> .mxdock__accordion:last-child
			.mxdock__accordion-trigger {
			border-bottom: none;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row:hover,
		html[data-site-mode="mingxin"] .mxdock__submenu-row:hover {
			color: var(--primary);
			padding-left: 0.65rem;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row-main,
		html[data-site-mode="mingxin"] .mxdock__submenu-row {
			min-width: 0;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row-main {
			display: flex;
			align-items: center;
			gap: 0.65rem;
		}

		html[data-site-mode="mingxin"] .mxdock__menu-row-main > svg,
		html[data-site-mode="mingxin"] .mxdock__submenu-row > svg:first-child {
			width: 1.15rem;
			height: 1.15rem;
			opacity: 0.72;
			flex: 0 0 auto;
		}

		html[data-site-mode="mingxin"] .mxdock__external-icon {
			width: 0.72rem;
			height: 0.72rem;
