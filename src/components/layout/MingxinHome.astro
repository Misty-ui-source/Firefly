	.mingxin-footer__logo-image {
		height: clamp(3.2rem, 7vw, 5.2rem);
		width: auto;
		display: block;
	}
	:root.dark .mingxin-footer__logo-image {
		filter: invert(1);
	}
	.mingxin-footer__tagline {
		margin: 0.8rem 0 0;
		max-width: 34rem;
