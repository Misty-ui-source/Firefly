---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import {
	analyticsConfig,
	announcementConfig,
	mingxinConfig,
	navBarConfig,
	profileConfig,
	siteConfig,
} from "@/config";
import {
	getCategoryList,
	getSortedPosts,
	getSortedPostsList,
	getTagList,
} from "@/utils/content-utils";
import { formatDateI18nWithTime } from "@/utils/date-utils";
import { dynamicSlug, sortDynamics } from "@/utils/dynamic-utils";
import { loadLocalImage } from "@/utils/schema-image";
import { getPostUrlBySlug, getTagUrl, url } from "@/utils/url-utils";
import MingxinMosaic from "./MingxinMosaic.astro";
import MingxinScene from "./MingxinScene.astro";

/**
 * 明信首页（第七形态专属）：个人信息卡 + 明信片影像层 + 内容区 + 签名页脚。
 * 移植自参考站 mmz Home（结构/几何照原样，类名 mmz- → mingxin-），差异：
 * 五幕文案走 mingxinConfig 固定编年（站长审定，不从文章派生）；
 * 气泡/台词一期只装配进运行时配置（二期渲染）；移动端与减弱动效不用
 * 参考站的独立移动首页，改静态明信片堆叠回退（任务书口径）。
 * 显隐由 main.css 守卫 + mingxin-mode.css 点亮控制：非明信形态整根隐藏。
 */

const fmtDate = (d: Date) =>
	`${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;
const fmtSlash = (d: Date) =>
	`${d.getFullYear()}/${String(d.getMonth() + 1).padStart(2, "0")}/${String(d.getDate()).padStart(2, "0")}`;

/* 封面解析：frontmatter 的 ./cover.* 是与文章同目录的相对路径，须经
   schema-image 的构建期 glob 解析成真实 URL（与 PostCard 同口径），
   直接当 src 用会 404；远程/根路径/data 原样，解析不到返回 null 走无封面式 */
const resolveCover = async (post: {
	data: { image?: unknown };
	filePath?: string;
}): Promise<string | null> => {
	const raw = post.data.image;
	if (!raw) return null;
	if (typeof raw !== "string") {
		return (raw as { src?: string }).src ?? null;
	}
	if (
		/^(https?:)?\/\//.test(raw) ||
		raw.startsWith("/") ||
		raw.startsWith("data:")
	) {
		return raw;
	}
	const filePath = (post.filePath ?? "")
		.replace(/^\.\//, "")
		.replace(/^src\//, "");
	const basePath = filePath.slice(0, filePath.lastIndexOf("/"));
	const meta = await loadLocalImage(raw, basePath);
	return meta?.src ?? null;
};

/* ---------------- 数据装配：近期文章（置顶优先，getSortedPostsList 已排序） ---------------- */
const allPosts = await getSortedPostsList();
const afterglowPosts = await Promise.all(
	allPosts.slice(0, 12).map(async (post) => ({
		title: post.data.title,
		href: url(`/posts/${post.id}/`),
		date: fmtDate(post.data.published),
		description: post.data.description ?? "",
		category: post.data.category || "未分类",
		cover: (await resolveCover(post)) ?? undefined,
	})),
);

/* ---------------- 数据装配：我的动态（最新在前） ---------------- */
const stripMarkdown = (text: string) =>
	text
		.replace(/!\[[^\]]*\]\([^)]*\)/g, "")
		.replace(/\[([^\]]*)\]\([^)]*\)/g, "$1")
		.replace(/[*_#>`=~]/g, "")
		.replace(/\s+/g, " ")
		.trim();
const dynamics = sortDynamics(await getCollection("dynamic"));
const momentItems = dynamics.slice(0, 8).map((entry) => {
	const text = stripMarkdown(entry.body ?? "");
	return {
		excerpt: text.length > 96 ? `${text.slice(0, 96)}…` : text,
		date: fmtDate(entry.data.published),
		iso: entry.data.published.toISOString(),
		pinned: entry.data.pinned || false,
		href: url(`/dynamic/${dynamicSlug(entry.id)}/`),
	};
});

/* ---------------- 快速前往：现有导航配置拍平（分组取子项，跳过占位与主页） ---------------- */
type QuickLink = { name: string; href: string; icon?: string; external?: boolean };
const quickLinks: QuickLink[] = [];
for (const link of navBarConfig.links) {
	const leaves = link.children?.length ? link.children : [link];
	for (const leaf of leaves) {
		if (!leaf.url || leaf.url === "#" || leaf.url === "/") continue;
		quickLinks.push({
			name: leaf.name,
			href: leaf.external ? leaf.url : url(leaf.url),
			icon: leaf.icon,
			external: leaf.external,
		});
	}
}
const navQuickLinks = quickLinks.slice(0, 12);

/* ---------------- 公告：复用 announcementConfig 静态文案 ---------------- */
const noticeText = announcementConfig.content.trim();
const noticeLink =
	noticeText &&
	announcementConfig.link?.enable &&
	announcementConfig.link.text &&
	announcementConfig.link.url
		? announcementConfig.link
		: null;

/* ---------------- 个人简介（页脚标语用） ----------------
   作者卡本体已按站长 2026-11-01 改定移入顶栏左段胶囊（MingxinNavbar.astro
   的 .mxnav-brand + 资料卡，此处不再装配个人信息卡数据与热力图）。 */
const profileBio = profileConfig.bio;
const isExternalHref = (href: string) => /^(?:https?:)?\/\//i.test(href);

/* ---------------- 五幕（mingxinConfig 固定文案） ---------------- */
const blindScenes = mingxinConfig.scenes.map((scene, index) => ({
	index,
	composite: Boolean(scene.composite),
	image: scene.image,
	poolMode: scene.mode ?? "manual",
	alt: scene.title,
	title: scene.title,
	date: scene.date,
	description: scene.note,
}));
const finaleImageSrc = blindScenes[blindScenes.length - 1]?.image ?? mingxinConfig.revealImage;
/* 轮换池：非 manual 的槽图不直出 src，挂 data-mx-pick 由 Layout 首帧脚本定图 */
const mxRevealPick = (mingxinConfig.revealMode ?? "manual") !== "manual";
const mxDollPick = (mingxinConfig.dollMode ?? "manual") !== "manual";
const mxFinalePickKey = blindScenes.length
	? `scene-${blindScenes.length - 1}`
	: "reveal";
const mxFinalePick = blindScenes.length
	? blindScenes[blindScenes.length - 1].poolMode !== "manual"
	: mxRevealPick;
const mxStandPick = (i: number) =>
	((mingxinConfig.standModes ?? [])[i] ?? "manual") !== "manual";

/* ---------------- 气泡池 / 台词装配（二期渲染，一期只进运行时配置） ---------------- */
const bubbleLine = (text: string, limit = 22) => {
	const clause =
		text.replace(/\s+/g, " ").split(/[，。；：!?！？,.;:]/)[0] ?? text;
	const clean = clause.trim();
	return clean.length > limit ? `${clean.slice(0, limit)}…` : clean;
};
const bubbleSeen = new Set<string>();
const bubbleMessages: string[] = [];
for (const post of allPosts) {
	const text = bubbleLine(post.data.description || post.data.title, 24);
	if (!text || bubbleSeen.has(text)) continue;
	bubbleSeen.add(text);
	bubbleMessages.push(text);
	if (bubbleMessages.length >= 16) break;
}
for (const fallback of mingxinConfig.bubbleFallbacks) {
	if (bubbleMessages.length >= 12) break;
	if (!bubbleSeen.has(fallback)) {
		bubbleSeen.add(fallback);
		bubbleMessages.push(fallback);
	}
}
/* 气泡图走 resolveCover 解析（相对 ./cover.* 直接当 src 会 404）；
   解析不到的文章不进图池，气泡墙拉不到图时自己会退回纯文字 */
const bubbleImages = (
	await Promise.all(
		allPosts.slice(0, 12).map(async (post) => await resolveCover(post)),
	)
)
	.filter((src): src is string => Boolean(src))
	.slice(0, 4);

/* ---------------- 黑猫台词装配（二期）：数据派生口径同原站 ----------------
   文章摘要/标题在前、动态摘句随后、简介与兜底压阵：bubbleLine(48) 切首句
   截断、去重、上限 8 条；一句都没有时角色不渲染（控制器空台词自动空转）。 */
const dialogueLines: string[] = [];
const dialogueSeen = new Set<string>();
const pushDialogueLine = (raw: string) => {
	const text = bubbleLine(raw, 48);
	if (!text || dialogueSeen.has(text)) return;
	dialogueSeen.add(text);
	dialogueLines.push(text);
};
for (const post of allPosts.slice(0, 6)) {
	pushDialogueLine(post.data.description || post.data.title);
	if (dialogueLines.length >= 5) break;
}
for (const moment of momentItems.slice(0, 3)) {
	pushDialogueLine(moment.excerpt);
	if (dialogueLines.length >= 7) break;
}
if (profileBio) pushDialogueLine(profileBio);
for (const fallback of mingxinConfig.dialogueFallbacks) {
	pushDialogueLine(fallback);
	if (dialogueLines.length >= 8) break;
}
const dialogueLinesFinal = dialogueLines.slice(0, 8);

const blindsRuntime = {
	scenes: {
		scrollDistance: mingxinConfig.scrollDistance,
		cycleDuration: mingxinConfig.cycleDuration,
		sceneCount: blindScenes.length,
		bubbleMessages,
		bubbleImages,
	},
};

/* ---------------- 页脚 ---------------- */
const footerLinks = [
	{ label: "RSS", href: url("/rss.xml"), external: false },
	{ label: "Atom", href: url("/atom.xml"), external: false },
	{ label: "Sitemap", href: "/sitemap-index.xml", external: true },
];
/* 运行天数与全站同口径：siteConfig.siteStartDate 当天 00:00（+08:00）起算。
   旧口径按最早文章日期算，旧文追溯到 2025 年会得出 372 天的假数（站长实锤）。 */
const runtimeStart = new Date(
	`${siteConfig.siteStartDate || "2026-10-15"}T00:00:00+08:00`,
);
const runtimeDays = Math.max(
	0,
	Math.floor((Date.now() - runtimeStart.getTime()) / 86400000),
);
/* 构建时间与站点信息卡（SiteInfo）同源同格式：构建时刻 + i18n 带时间格式 */
const footerBuildTime = formatDateI18nWithTime(new Date());
/* 页脚运行时间与他形态页脚（FooterConfig.html）同格式：天/时/分/秒、每秒跳字；
   SSR 先给构建时刻的分解值，挂载后由 boot 脚本按同一起点逐秒刷新 */
const runtimeDiffMs = Math.max(0, Date.now() - runtimeStart.getTime());
const runtimeText = `${Math.floor(runtimeDiffMs / 86400000)} 天 ${Math.floor((runtimeDiffMs % 86400000) / 3600000)} 小时 ${Math.floor((runtimeDiffMs % 3600000) / 60000)} 分 ${Math.floor((runtimeDiffMs % 60000) / 1000)} 秒`;

/* ================= 终幕内容区 ·「Hero」变体（原站 HomeDataLayer 移植） =================
   与「经典」变体共用同一批构建期数据装配，html[data-mingxin-afterglow] 决定显哪套。
   牌堆/分类圆盘的取图口径与原站一致：构建期解析封面，客户端不二次遍历。 */
const allPostsFull = await getSortedPosts();
const categoriesByCount = (await getCategoryList())
	.slice()
	.sort((a, b) => b.count - a.count);
const tagsByCount = (await getTagList())
	.slice()
	.sort((a, b) => b.count - a.count);

/* 字数统计与紧凑数字：原站 home-data-layer.js 的两件小工具，口径照搬 */
const countReadableCharacters = (body = "") => {
	const text = String(body)
		.replace(/```[\s\S]*?```/g, "")
		.replace(/`[^`]*`/g, "")
		.replace(/\s+/g, " ")
		.trim();
	const cn = text.match(/[一-龥]/g) || [];
	const en = text.match(/[a-zA-Z]/g) || [];
	return cn.length + en.length;
};
const formatCompactNumber = (value: number) => {
	if (Math.abs(value) < 1000) return String(value);
	const compact = value / 1000;
	return `${Number.isInteger(compact) ? compact.toFixed(0) : compact.toFixed(1)}k`;
};
const totalWords = allPostsFull.reduce(
	(sum, post) => sum + countReadableCharacters(post.body || ""),
	0,
);

/* ---------------- 马赛克前段介绍票签内容 ----------------
   三张票签照原站散文风：壹 = 个人简介散文（mingxinConfig.introBio）、
   贰 = 站点数据（构建期真实统计）、叁 = 联系散文（mingxinConfig.
   introContact 整句，装配时把句中「GitHub」字样、「邮箱地址」
   「RSS / Atom」三处按 profileConfig 真值切成真链接片段；
   句式被改、命不中的部分按纯文本渲染，不丢字）。 */
const githubLink = profileConfig.links.find((link) => link.name === "GitHub");
const emailLink = profileConfig.links.find((link) => link.name === "Email");
const contactNeedles: { needle: string; href: string }[] = [
	...(githubLink
		? [
				{
					needle: "GitHub",
					href: githubLink.url,
				},
			]
		: []),
	...(emailLink
		? [
				{
					needle: emailLink.url.replace(/^mailto:/, ""),
					href: emailLink.url,
				},
			]
		: []),
	{ needle: "RSS / Atom", href: "/atom.xml" },
];
const contactSegments: { text: string; href?: string }[] = [];
{
	let rest = mingxinConfig.introContact;
	while (rest) {
		let hit: { index: number; needle: string; href: string } | null = null;
		for (const item of contactNeedles) {
			const index = rest.indexOf(item.needle);
			if (index >= 0 && (!hit || index < hit.index)) hit = { index, ...item };
		}
		if (!hit) {
			contactSegments.push({ text: rest });
			break;
		}
		if (hit.index > 0) contactSegments.push({ text: rest.slice(0, hit.index) });
		contactSegments.push({ text: hit.needle, href: hit.href });
		rest = rest.slice(hit.index + hit.needle.length);
	}
}
const mosaicIntro = {
	bio: mingxinConfig.introBio,
	stats: [
		`文章 ${allPosts.length} 篇`,
		`总字数 ${formatCompactNumber(totalWords)} 字`,
		...(runtimeDays !== null ? [`小屋已运行 ${runtimeDays} 天`] : []),
	],
	contact: contactSegments,
};

/* 博客文章牌堆：置顶最多 3 篇 + 最新 5 篇（非置顶），按 id 去重；
   缩略态按这个顺序自动翻牌；展开态两抽屉沿用牌堆下标选封面 */
const pinnedPool = allPostsFull.filter((post) => post.data.pinned);
const recentPool = allPostsFull.filter((post) => !post.data.pinned).slice(0, 5);
const deckPosts = Array.from(
	new Map(
		[...pinnedPool.slice(0, 3), ...recentPool].map((post) => [post.id, post]),
	).values(),
);
const deckItems = await Promise.all(
	deckPosts.map(async (post, index) => ({
		index,
		href: getPostUrlBySlug(post.id),
		title: post.data.title,
		date: fmtDate(post.data.published),
		isPinned: Boolean(post.data.pinned),
		cover: await resolveCover(post),
	})),
);
const deckGroups = [
	{
		label: "置顶文章",
		icon: "material-symbols:bookmark-outline",
		items: deckItems.filter((item) => item.isPinned),
	},
	{
		label: "最新更新",
		icon: "material-symbols:history",
		items: deckItems.filter((item) => !item.isPinned),
	},
].filter((group) => group.items.length > 0);

/* 内容索引抽屉：分类取篇数前 4、标签取篇数前 6，各补一张「查看全部」 */
const indexGroups = [
	{
		label: "分类索引",
		icon: "material-symbols:folder-outline-rounded",
		cards: categoriesByCount.slice(0, 4).map((category) => ({
			name: category.name,
			count: category.count,
			url: category.url,
		})),
		allLabel: "查看全部",
		allNote: `${categoriesByCount.length} 个分类`,
		allUrl: url("/categories/"),
	},
	{
		label: "标签索引",
		icon: "material-symbols:label",
		cards: tagsByCount.slice(0, 6).map((tag) => ({
			name: `#${tag.name}`,
			count: tag.count,
			url: getTagUrl(tag.name),
		})),
		allLabel: "查看全部标签",
		allNote: `${tagsByCount.length} 个标签`,
		allUrl: url("/tags/"),
	},
].filter((group) => group.cards.length > 0);

/* 分类剧场：三张圆盘 = 篇数最多的三个分类，盘面是该分类最新一篇文章的封面。
   allPostsFull 已按发布时间倒序，每个分类第一次命中的就是最新一篇 */
const leadPostByCategory = new Map<string, (typeof allPostsFull)[number]>();
for (const post of allPostsFull) {
	const name = post.data.category?.trim() || "未分类";
	if (!leadPostByCategory.has(name)) leadPostByCategory.set(name, post);
}
const sceneAgents = await Promise.all(
	categoriesByCount.slice(0, 3).map(async (category) => {
		const lead = leadPostByCategory.get(category.name);
		return {
			name: category.name,
			count: category.count,
			cover: lead ? await resolveCover(lead) : null,
		};
	}),
);
const scenePrompt = `本站共有 ${categoriesByCount.length} 个分类`;
const SCENE_LINES = [
	"M300 110C300 162 102 152 102 196",
	"M300 110V196",
	"M300 110C300 162 498 152 498 196",
];

/* 站点数据六项：UV/PV 运行时由 Umami 分享接口回填（口径同原站），其余构建期定值 */
const statBoxes = [
	{ mod: "uv", label: "访客", compact: "--", full: "--", statKind: "UV" as const },
	{ mod: "pv", label: "浏览量", compact: "--", full: "--", statKind: "PV" as const },
	{
		mod: "posts",
		label: "文章",
		compact: String(allPostsFull.length),
		full: String(allPostsFull.length),
	},
	{
		mod: "cats",
		label: "分类",
		compact: String(categoriesByCount.length),
		full: String(categoriesByCount.length),
	},
	{
		mod: "tags",
		label: "标签",
		compact: String(tagsByCount.length),
		full: String(tagsByCount.length),
	},
	{
		mod: "words",
		label: "总字数",
		compact: formatCompactNumber(totalWords),
		full: totalWords.toLocaleString(),
	},
];
/* 层叠插画按下标倒序渲染：下标 0（访客）最后画、视觉在最上层 */
const statLayers = statBoxes.map((box, i) => ({ box, i })).reverse();

/* 订阅与联系：直接用全站同一份联系方式数据源 profileConfig.links（与
   Profile 卡/作者卡/关于页清单同一套条目），不另行手写——旧口径手写一条
   「邮箱」打头、又拼 profile 的 Email，同一邮箱出现两次，源里有的
   Telegram 还漏掉（站长 2026-11-01 实锤）。中心 hub 取 GitHub（无则第一条） */
const brandColorOf = (haystack: string) => {
	const text = haystack.toLowerCase();
	if (text.includes("github")) return "#181717";
	if (text.includes("telegram")) return "#26a5e4";
	if (text.includes("bilibili")) return "#fb7299";
	if (text.includes("mail")) return "#ea4335";
	if (text.includes("rss")) return "#ee802f";
	if (text.includes("twitter") || text.includes("x.com")) return "#1d9bf0";
	return undefined;
};
const contactLinks = profileConfig.links.map((link) => ({
	name: link.name,
	icon: link.icon,
	href: link.url,
	color: brandColorOf(`${link.icon} ${link.name}`),
}));
const primaryContact =
	contactLinks.find((link) => /github/i.test(`${link.icon} ${link.name}`)) ??
	contactLinks[0];
const ORBIT_SLOTS = [
	{ x: -92, y: -56, s: 52 },
	{ x: 90, y: -64, s: 46 },
	{ x: -104, y: 36, s: 44 },
	{ x: 102, y: 28, s: 54 },
	{ x: -46, y: 84, s: 40 },
	{ x: 58, y: 86, s: 42 },
];
const orbitSatellites = contactLinks
	.filter((link) => link !== primaryContact)
	.slice(0, ORBIT_SLOTS.length)
	.map((link, i) => ({ ...link, ...ORBIT_SLOTS[i] }));

const guideCards = [
	{ id: "stats", title: "站点数据", hint: "小屋的家底，一层一层数给你听" },
	{ id: "posts", title: "博客文章", hint: "置顶与最新，都收在这摞牌里" },
	{ id: "index", title: "内容索引", hint: "按分类与标签，找到想看的那篇" },
	{ id: "contact", title: "订阅与联系", hint: "订阅更新，或者直接找到我" },
] as const;

const umamiShare = analyticsConfig.umamiAnalytics;
---

<div class="mingxin-home" data-mingxin-home>
	{/* 个人信息卡独立长条已按站长 2026-11-01 改定撤除（不渲染）：
	    作者卡展开并入顶栏左段胶囊（MingxinNavbar.astro 的 .mxnav-brand）。 */}

	<section class="mingxin-blinds" data-mingxin-blinds aria-label="明信片影像层">
		<div class="mingxin-blinds__stage" data-blinds-stage aria-hidden="true">
			<img
				class="mingxin-blinds__background"
				src={mxRevealPick ? undefined : mingxinConfig.revealImage}
				data-mx-pick={mxRevealPick ? "reveal" : undefined}
				alt=""
				decoding="async"
				data-blinds-background
			/>
			{/* 马赛克 Hero 前段（可选加项，开关关时零渲染）：原站首屏整套
			    （拼图碎片/巨字标题/照片落位/介绍票签/玻璃雨），交接段照片
			    放大 + 整层交叉淡化后撤下，揭示段接管（不同图，无跳切） */}
			{mingxinConfig.mosaicHero && <MingxinMosaic part="layer" intro={mosaicIntro} />}
			<!-- 全屏背景收缩成首幕画面的过渡层：clip-path 收窗 + 图片等比 scale -->
			<div class="mingxin-blinds__portal" data-scenes-portal>
				<img
					class="mingxin-blinds__portal-image"
					src={mxRevealPick ? undefined : mingxinConfig.revealImage}
					data-mx-pick={mxRevealPick ? "reveal" : undefined}
					alt=""
					decoding="async"
					data-scenes-portal-image
				/>
			</div>
		</div>

		{/* 首屏文字层：站名小字 / 大标题 / 轮播语，固定在视口上，只随 reveal 阶段显示 */}
		<div class="mingxin-blinds__hero" data-blinds-hero data-visible="true">
			<span class="mingxin-blinds__hero-line" data-hero-line="left" aria-hidden="true" />
			<span class="mingxin-blinds__hero-line" data-hero-line="right" aria-hidden="true" />
			<div class="mingxin-blinds__hero-center" data-hero-center>
				<p class="mingxin-blinds__hero-occupation">{siteConfig.title}</p>
				<p class="mingxin-blinds__hero-name">{mingxinConfig.headline}</p>
				<p class="mingxin-blinds__hero-message" data-hero-message>
					{mingxinConfig.headlineMessages[0]}
				</p>
			</div>
		</div>

		{/* 马赛克前段滚动段（开关关时不存在，揭示段位置与未加此层时一致） */}
		{mingxinConfig.mosaicHero && <MingxinMosaic part="section" />}

		<section class="mingxin-blinds__reveal" data-blinds-reveal aria-label="揭示">
			<div class="mingxin-blinds__reveal-viewport"></div>
		</section>

		<section class="mingxin-blinds__scenes" data-blinds-scenes aria-label="明信片幕序">
			<div class="mingxin-blinds__scenes-viewport" data-scenes-viewport>
				<div
					class="mingxin-blinds__cycle"
					style="--mingxin-cycle-period:224px"
					aria-hidden="true"
					data-scenes-cycle
				>
					<div class="mingxin-blinds__cycle-track" data-scenes-cycle-track></div>
				</div>

				{/* 气泡墙（二期）：留言气泡横向飘过影像层，整层不挡明信片点击；
				    槽位结构照原站（外层漂移 / 内层卡面 / 文字 / 图） */}
				<div
					class="mingxin-blinds__bubbles"
					aria-hidden="true"
					data-scenes-bubbles
				>
					{
						Array.from({ length: 12 }).map(() => (
							<span class="mingxin-blind-bubble" data-scene-bubble>
								<span class="mingxin-blind-bubble__body" data-scene-bubble-body>
									<span class="mingxin-blind-bubble__text" data-scene-bubble-text />
									<img
										class="mingxin-blind-bubble__image"
										data-scene-bubble-image
										alt=""
										loading="lazy"
										decoding="async"
									/>
								</span>
							</span>
						))
					}
				</div>

				<div class="mingxin-blinds__track" data-scenes-track>
					{blindScenes.map((item) => (
						<MingxinScene index={item.index} item={item} composite={item.composite} />
					))}
				</div>

				{/* 立绘巡航（二期）：影像层底部沿视口横向往返，可拖拽带惯性；
				    图源走 mingxinConfig.standImages（零硬编码，三期进控制台素材卡） */}
				<div class="mingxin-blinds__stands" data-scenes-stands aria-hidden="true">
					<div class="mingxin-blinds__stands-track" data-scenes-stands-track>
						{
							mingxinConfig.standImages.map((src, si) => (
								<div class="mingxin-blinds__stand" data-scenes-stand>
									<img
										class="mingxin-blinds__stand-image"
										src={mxStandPick(si) ? undefined : src}
										data-mx-pick={mxStandPick(si) ? `stand-${si}` : undefined}
										alt=""
										loading="lazy"
										decoding="async"
										draggable="false"
									/>
								</div>
							))
						}
					</div>
				</div>
			</div>
		</section>

		{/* 终幕放大过渡层：恒为 fixed，挂在根层级，避免被 pin 段 transform 影响 */}
		<div class="mingxin-blinds__finale" data-finale-portal aria-hidden="true">
			<img
				class="mingxin-blinds__finale-image"
				src={mxFinalePick ? undefined : finaleImageSrc}
				data-mx-pick={mxFinalePick ? mxFinalePickKey : undefined}
				alt=""
				loading="lazy"
				decoding="async"
				data-finale-image
			/>
		</div>

		<script
			type="application/json"
			data-blinds-config
			is:inline
			set:html={JSON.stringify(blindsRuntime)}
		/>
	</section>

	{/* 静态回退（≤768px / 减弱动效）：明信片纵向堆叠，不挂滚动机器 */}
	<div class="mingxin-static" aria-label="明信片">
		{blindScenes.map((item) => (
			<article class="mingxin-static__card">
				<span class="mingxin-static__badge" aria-hidden="true">{item.index + 1}</span>
				<img
					class="mingxin-static__image"
					src={item.poolMode !== "manual" ? undefined : item.image}
					data-mx-pick={item.poolMode !== "manual" ? `scene-${item.index}` : undefined}
					alt={item.alt}
					loading="lazy"
					decoding="async"
				/>
				<div class="mingxin-static__band">
					<div class="mingxin-static__id">
						<p class="mingxin-static__title">{item.title}</p>
						<p class="mingxin-static__date">{item.date}</p>
					</div>
					<span class="mingxin-static__divider" aria-hidden="true"></span>
					<p class="mingxin-static__note">{item.description}</p>
				</div>
			</article>
		))}
	</div>

	{/* 终幕衔接占位：高度由控制器按实测校准 */}
	<div class="mingxin-finale-spacer" data-finale-spacer aria-hidden="true"></div>

	{/* 终幕文字层：独立 fixed 层，位于内容区之上 */}
	<div class="mingxin-finale-copy" data-finale-copy-layer aria-hidden="true">
		<div class="mingxin-finale-copy__inner" data-finale-copy-inner>
			<h2 class="mingxin-finale-copy__title">{mingxinConfig.finaleTitle}</h2>
			<p class="mingxin-finale-copy__subtitle">{mingxinConfig.finaleSubtitle}</p>
		</div>
	</div>

	{/* 内容区：终幕退场后从下方上滑接管。两套变体同一批构建期数据，
	    html[data-mingxin-afterglow="hero"|"classic"] 决定显哪套（默认 hero=「Hero」）。 */}
	<div data-mingxin-afterglow>
	{/* 终幕变体访客开关：Hero / 经典两段，点了写 html 属性 + localStorage
	    即时换（显隐全走 mingxin-mode.css 的 [data-mingxin-afterglow] 规则）；
	    外观卡明信段有同名开关，两处选中态由脚本互相刷新。 */}
	<div class="mingxin-afterglow-switch" role="radiogroup" aria-label="终幕内容区样式">
		<span class="mingxin-afterglow-switch__label">终幕</span>
		<div class="mingxin-afterglow-switch__track">
			<button
				type="button"
				class="mingxin-afterglow-switch__btn"
				data-afterglow-choice="hero"
				role="radio"
				aria-checked="false"
			>
				Hero
			</button>
			<button
				type="button"
				class="mingxin-afterglow-switch__btn"
				data-afterglow-choice="classic"
				role="radio"
				aria-checked="false"
			>
				经典
			</button>
		</div>
	</div>
	{/* —— 变体「Hero」：原站 HomeDataLayer 四卡（牌堆/站点数据/内容索引/订阅联系），
	    结构与类名照原站 home-data-layer.css，样式在 styles/mingxin-datalayer.css。
	    默认态照原站层级：牌堆卡展开通栏在上、其余三卡缩成底部一行（data-guide-expanded
	    与牌堆卡的 guide-card--active 构建期直出，控制器 boot 时接管这一既成状态） —— */}
	<section
		class="mingxin-datalayer"
		data-afterglow-variant="hero"
		data-afterglow-compass
		data-guide-expanded
		data-stats-base-url={umamiShare.shareApiBase}
		data-stats-share-id={umamiShare.shareId}
		aria-labelledby="mingxin-guide-heading"
	>
		<div class="home-guide__guides" aria-hidden="true">
			<div class="mx-guide-frame mx-guide-frame--v"></div>
			<div class="mx-guide-frame mx-guide-frame--h"></div>
		</div>
		<h2 class="mingxin-datalayer__sr-heading" id="mingxin-guide-heading">站点导览</h2>
		<div class="home-guide">
			{guideCards.map((card, cardIndex) => (
				<article
					class:list={[
						"guide-card",
						{ "guide-card--active": card.id === "posts" },
					]}
					data-guide-card={card.id}
					style={`--enter-index:${cardIndex}`}
					tabindex="0"
					aria-expanded={card.id === "posts" ? "true" : "false"}
					aria-controls={`mingxin-guide-detail-${card.id}`}
				>
					<div class="guide-card__stage">
						<div
							class:list={[
								"guide-card__art",
								{ "guide-card__art--fill": card.id === "contact" },
							]}
						>
							{card.id === "stats" && (
								<svg class="guide-art" viewBox="0 0 220 232" aria-hidden="true">
									<g class="stat-deck">
										{statLayers.map((layer) => (
											<g
												class="stat-layer"
												data-stat-layer={layer.i}
												data-on={layer.i === 0 ? "" : undefined}
												style={`--y-rest:${70 + layer.i * 11};--y-open:${30 + layer.i * 25};`}
											>
												<path
													class="stat-side"
													d="M-72 0 L0 36 L72 0 L72 10 L0 46 L-72 10 Z"
												/>
												<path
													class="g-card-face g-outline"
													pathLength="1"
													d="M0 -36 L72 0 L0 36 L-72 0 Z"
												/>
												<path
													class="g-hatch"
													pathLength="1"
													d="M-46 4 L-14 -10 M-34 14 L6 -6 M-12 22 L32 0"
												/>
											</g>
										))}
									</g>
								</svg>
							)}
							{card.id === "posts" && (
								<div
									class="post-deck"
									data-post-deck
									style={`--deck-n:${deckItems.length};`}
								>
									{deckItems.map((item, i) => (
										<a
											class="post-card"
											href={item.href}
											draggable="false"
											tabindex={i === 0 ? 0 : -1}
											inert={i !== 0}
											data-post-card={i}
											data-on={i === 0 ? "" : undefined}
											style={`--depth:${i};`}
										>
											{item.cover ? (
												<div class="post-card__media">
													<img
														class="post-card__img"
														src={item.cover}
														alt={item.title}
														loading={i < 3 ? "eager" : "lazy"}
														decoding="async"
													/>
												</div>
											) : (
												<div class="post-card__media post-card__media--empty" />
											)}
											<div class="post-card__body">
												<p class="post-card__title">{item.title}</p>
												<p class="post-card__meta">
													{item.isPinned && (
														<span class="post-card__badge">置顶</span>
													)}
													<span class="post-card__date">{item.date}</span>
												</p>
											</div>
										</a>
									))}
								</div>
							)}
							{card.id === "index" && (
								<div
									class="index-scene"
									data-index-scene
									data-scene-phase="team"
									role="img"
									aria-label={`${scenePrompt}：${sceneAgents.map((agent) => `${agent.name} ${agent.count}`).join(" / ")}`}
								>
									<svg class="index-scene__lines" viewBox="0 0 600 400" aria-hidden="true">
										<defs>
											{SCENE_LINES.slice(0, sceneAgents.length).map((d, i) => (
												<mask
													id={`mingxin-scene-reveal-${i}`}
													maskUnits="userSpaceOnUse"
													x="0"
													y="0"
													width="600"
													height="400"
												>
													<path class="index-scene__reveal" pathLength="1" d={d} />
												</mask>
											))}
										</defs>
										{SCENE_LINES.slice(0, sceneAgents.length).map((d, i) => (
											<path
												class="index-scene__line"
												d={d}
												mask={`url(#mingxin-scene-reveal-${i})`}
											/>
										))}
									</svg>
									<div class="index-scene__halo" aria-hidden="true" />
									<div class="index-scene__prompt" aria-hidden="true">
										<span class="index-scene__text">
											<span data-scene-text>{scenePrompt}</span>
											<span class="index-scene__caret" />
										</span>
										<span class="index-scene__send">
											<svg viewBox="0 0 24 24" aria-hidden="true">
												<path d="M12 18.5v-13M6.5 11 12 5.5l5.5 5.5" />
											</svg>
										</span>
									</div>
									{sceneAgents.map((agent, i) => (
										<div
											class="index-scene__agent"
											style={`--agent-x:${102 + i * 198};--i:${i};`}
										>
											<div class="index-scene__node">
												<span class="index-scene__face">
													{agent.cover ? (
														<img
															class="index-scene__img"
															src={agent.cover}
															alt=""
															loading="lazy"
															decoding="async"
														/>
													) : (
														<span class="index-scene__initial">
															{agent.name.slice(0, 1)}
														</span>
													)}
												</span>
												<span class="index-scene__dot" />
											</div>
											<div class="index-scene__role">
												<span class="index-scene__tools">
													<span class="index-scene__tool">{agent.count}</span>
												</span>
												<span class="index-scene__name">{agent.name}</span>
											</div>
										</div>
									))}
								</div>
							)}
							{card.id === "contact" && (
								<div class="orbit" style={`--orbit-count:${orbitSatellites.length}`}>
									<div class="orbit__field">
										{orbitSatellites.map((link, i) => (
											<a
												class="orbit__slot"
												href={link.href}
												target={isExternalHref(link.href) ? "_blank" : undefined}
												rel={isExternalHref(link.href) ? "me noopener" : "me"}
												aria-label={link.name}
												style={`--x:${link.x};--y:${link.y};--s:${link.s};--orbit-i:${i};${link.color ? `--brand:${link.color};` : ""}`}
											>
												<span class="orbit__face">
													<Icon name={link.icon} />
												</span>
											</a>
										))}
									</div>
									<a
										class="orbit__hub"
										href={primaryContact.href}
										target={isExternalHref(primaryContact.href) ? "_blank" : undefined}
										rel={isExternalHref(primaryContact.href) ? "me noopener" : "me"}
										aria-label={primaryContact.name}
										style={primaryContact.color ? `--brand:${primaryContact.color}` : undefined}
									>
										<Icon name={primaryContact.icon} />
									</a>
								</div>
							)}
						</div>
						<div
							class:list={[
								"guide-card__detail",
								{ "guide-card__detail--always": card.id === "stats" },
							]}
							id={`mingxin-guide-detail-${card.id}`}
						>
							{card.id === "stats" && (
								<div class="stat-readout">
									{statBoxes.map((box, i) => (
										<div
											class="stat-card"
											data-stat-card={i}
											data-on={i === 0 ? "" : undefined}
											style={`--stat-i:${i};`}
										>
											<p class="stat-card__label">{box.label}</p>
											<p class="stat-card__value">
												<span
													class="stat-card__compact"
													data-stat-compact={"statKind" in box ? box.statKind : undefined}
												>
													{box.compact}
												</span>
												<span
													class="stat-card__full"
													data-stat-full={"statKind" in box ? box.statKind : undefined}
												>
													{box.full}
												</span>
											</p>
										</div>
									))}
								</div>
							)}
							{card.id === "posts" && (
								<ul class="acc" data-acc>
									{deckGroups.map((group, gi) => (
										<li class="acc__item" data-open={gi === 0 ? "" : undefined}>
											<button
												class="acc__head"
												type="button"
												aria-expanded={gi === 0}
												data-acc-head
											>
												<span class="acc__icon">
													<Icon name={group.icon} />
												</span>
												<span class="acc__title">{group.label}</span>
												<span class="acc__count">{group.items.length}</span>
												<span class="acc__chevron" aria-hidden="true" />
											</button>
											<div class="acc__panel">
												<div class="acc__content">
													<ul class="acc__rows">
														{group.items.map((item) => (
															<li>
																<a
																	class="acc__row"
																	href={item.href}
																	data-post-pick={item.index}
																>
																	<span class="acc__row-title">{item.title}</span>
																	<span class="acc__row-date">{item.date}</span>
																</a>
															</li>
														))}
													</ul>
												</div>
											</div>
										</li>
									))}
								</ul>
							)}
							{card.id === "index" && (
								<ul class="acc" data-acc>
									{indexGroups.map((group, gi) => (
										<li class="acc__item" data-open={gi === 0 ? "" : undefined}>
											<button
												class="acc__head"
												type="button"
												aria-expanded={gi === 0}
												data-acc-head
											>
												<span class="acc__icon">
													<Icon name={group.icon} />
												</span>
												<span class="acc__title">{group.label}</span>
												<span class="acc__count">{group.cards.length}</span>
												<span class="acc__chevron" aria-hidden="true" />
											</button>
											<div class="acc__panel">
												<div class="acc__content">
													<ul class="acc__cards">
														{group.cards.map((item) => (
															<li>
																<a class="acc__card" href={item.url}>
																	<span class="acc__card-name">{item.name}</span>
																	<span class="acc__card-count">{item.count}</span>
																</a>
															</li>
														))}
														<li>
															<a class="acc__card acc__card--all" href={group.allUrl}>
																<span class="acc__card-name">{group.allLabel}</span>
																<span class="acc__card-count">{group.allNote}</span>
															</a>
														</li>
													</ul>
												</div>
											</div>
										</li>
									))}
								</ul>
							)}
							{card.id === "contact" && (
								<ul class="guide-links">
									{contactLinks.map((link) => (
										<li>
											<a
												href={link.href}
												target={isExternalHref(link.href) ? "_blank" : undefined}
												rel={isExternalHref(link.href) ? "me noopener" : "me"}
												style={link.color ? `--brand:${link.color}` : undefined}
											>
												<span class="guide-links__icon">
													<Icon name={link.icon} />
												</span>
												<span>{link.name}</span>
											</a>
										</li>
									))}
								</ul>
							)}
						</div>
					</div>
					<footer class="guide-card__meta">
						<div class="guide-card__meta-text">
							<h3 class="guide-card__title">{card.title}</h3>
							<p class="guide-card__hint">{card.hint}</p>
						</div>
					</footer>
				</article>
			))}
		</div>
	</section>

	{/* —— 变体「经典」：番茄四模块（快速前往/公告/近期文章/我的动态） —— */}
	<section class="mingxin-afterglow" data-afterglow-variant="classic" aria-label="快速前往">
		<div class="mingxin-afterglow__inner">
			<div class="mingxin-afterglow__compass">
				<header class="mingxin-afterglow__head" data-afterglow-compass>
					<h2 class="mingxin-afterglow__title">快速带你前往</h2>
					<p class="mingxin-afterglow__subtitle">小屋的各个房间，都从这里过去</p>
				</header>
				<nav class="mingxin-afterglow__nav" aria-label="快速前往">
					{navQuickLinks.map((link) => (
						<a
							class="mingxin-afterglow__link"
							href={link.href}
							target={link.external ? "_blank" : undefined}
							rel={link.external ? "noreferrer noopener" : undefined}
						>
							{link.icon && <Icon name={link.icon} />}
