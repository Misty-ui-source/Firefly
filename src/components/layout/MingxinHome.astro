			margin: 0.2rem 0 0;
			font-family: var(--m3e-font-mono-family, ui-monospace, monospace);
			font-size: 0.75rem;
			color: oklch(from var(--deep-text) 0.55 0 h);
		}
		.mingxin-static__divider {
			width: 1px;
			background: var(--surface-outline-variant);
			flex: none;
		}
		.mingxin-static__note {
			margin: 0;
			color: var(--deep-text);
			font-size: 0.88rem;
			line-height: 1.6;
			display: -webkit-box;
			-webkit-box-orient: vertical;
			-webkit-line-clamp: 2;
			line-clamp: 2;
			overflow: hidden;
		}
		.mingxin-afterglow {
			padding-top: 2.5rem;
		}
	}

	/* ═══════════ 二期：黑猫对话 / 气泡墙 / 立绘巡航 ═══════════
	   样式照原站 Home.astro 对应段移植（Stylus → CSS、类名 mmz- → mingxin-）；
	   原站 --mmz-ease 在其仓库内无定义，这里映射到本站 --m3e-easing-standard。 */

	/* ---------------- 左下角黑猫对话 ---------------- */
	/* 定位与原站的 sticky 方案不同：本站外层有 overflow-x: clip 的滚动祖先链，
	   sticky 的 0 高盒会把溢出的 anchor 按其约束框裁掉（实测左半被裁、猫不绘制、
	   命中失效）；改 fixed 后行为等价——显隐本就由影像层阶段回调 gate，
	   reveal/shrink 之外 anchor 恒隐藏，不会赖在页脚不走。 */
	.mingxin-dialogue {
		--mingxin-dialogue-size: clamp(12rem, 13vw, 16rem);
		--mingxin-dialogue-ink: oklch(0.22 0.01 300);
		--mingxin-dialogue-paper: oklch(1 0 0);
		--mingxin-dialogue-stroke: 0.2rem;
		--mingxin-dialogue-spring: cubic-bezier(0.34, 1.56, 0.64, 1);
		position: fixed;
		left: 0;
		bottom: 0;
		z-index: 3;
		width: 100vw;
		height: 0;
		pointer-events: none;
	}

	@supports (transition-timing-function: linear(0, 1)) {
		.mingxin-dialogue {
			--mingxin-dialogue-spring: linear(
				0,
				0.36 12%,
				0.86 26%,
				1.12 36%,
				0.98 46%,
				1.02 58%,
				0.995 74%,
				1
			);
		}
	}

	/* 角色本体：底边压在视口底边、左缘贴住视口左缘；图本身有透明留白，
	   看着就是卡在角上。JS 接管前保持隐藏，入场只翻 data 属性，过渡交给 CSS。 */
	.mingxin-dialogue__anchor {
		position: absolute;
		bottom: 0;
		left: 0;
		width: var(--mingxin-dialogue-size);
		aspect-ratio: 1;
		opacity: 0;
		visibility: hidden;
		translate: 0 2.4rem;
		transition:
			opacity var(--m3e-duration-long, 600ms) var(--m3e-easing-standard, cubic-bezier(0.2, 0, 0, 1)),
			visibility 0s linear var(--m3e-duration-long, 600ms),
			translate var(--m3e-duration-long, 600ms) var(--m3e-easing-standard, cubic-bezier(0.2, 0, 0, 1));
		will-change: transform, opacity;
		pointer-events: none;
	}

	.mingxin-dialogue[data-scene-visible="true"] .mingxin-dialogue__anchor {
		opacity: 1;
		visibility: visible;
		translate: 0 0;
		pointer-events: auto;
		transition:
			opacity var(--m3e-duration-long, 600ms) var(--m3e-easing-standard, cubic-bezier(0.2, 0, 0, 1)),
			visibility 0s,
			translate var(--m3e-duration-long, 600ms) var(--m3e-easing-standard, cubic-bezier(0.2, 0, 0, 1));
	}

	.mingxin-dialogue__sticker {
		position: absolute;
		inset: 0;
		margin: 0;
		line-height: 0;
		filter: drop-shadow(0 0.5rem 0.8rem rgb(0 0 0 / 26%));
		/* 支点在底边：压下去时头顶动、脚不动，才像按在桌上的一团棉花 */
		transform-origin: 50% 100%;
		transition: translate 220ms cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.mingxin-dialogue__sticker[data-pressed="true"] {
		scale: 1.07 0.9;
		transition: scale 220ms var(--mingxin-dialogue-spring);
	}

	.mingxin-dialogue__trigger {
		position: absolute;
		inset: 0;
		padding: 0;
		border: 0;
		border-radius: 50% 50% 0 0;
		background: transparent;
		cursor: pointer;
	}

	.mingxin-dialogue__trigger:focus-visible {
		outline: 2px solid var(--primary);
		outline-offset: 2px;
	}

	/* 想法气泡：粗描边白椭圆，挂在角色头顶右上方，从左下角冒出来。
	   墨色/纸色不随主题翻转，属内容型材质例外（同原站口径）。 */
	.mingxin-dialogue__bubble {
		position: absolute;
		bottom: 92%;
		left: 52%;
		z-index: 1;
		width: max-content;
		max-width: min(16rem, 42vw);
		margin: 0;
		padding: 0.95rem 1.75rem;
		border: var(--mingxin-dialogue-stroke) solid var(--mingxin-dialogue-ink);
		border-radius: 50%;
		background: var(--mingxin-dialogue-paper);
		color: var(--mingxin-dialogue-ink);
		font-size: clamp(0.88rem, 0.95vw, 1rem);
		font-weight: 800;
		line-height: 1.45;
		text-align: center;
		text-wrap: balance;
		transform-origin: 0% 100%;
		cursor: pointer;
		opacity: 0;
		visibility: hidden;
		transition:
			opacity 180ms ease,
			visibility 0s linear 180ms;
	}

	.mingxin-dialogue__bubble[data-open="true"] {
		opacity: 1;
		visibility: visible;
		transition: none;
	}

	/* 思考泡泡的两颗小圆点，从气泡左下角一路落向角色头顶 */
	.mingxin-dialogue__bubble::before,
	.mingxin-dialogue__bubble::after {
		content: "";
		position: absolute;
		border: var(--mingxin-dialogue-stroke) solid var(--mingxin-dialogue-ink);
		border-radius: 50%;
		background: var(--mingxin-dialogue-paper);
	}

	.mingxin-dialogue__bubble::before {
		top: calc(100% + 0.2rem);
		left: 0.9rem;
		width: 1rem;
		height: 0.85rem;
	}

	.mingxin-dialogue__bubble::after {
		top: calc(100% + 1.25rem);
		left: 0.1rem;
		width: 0.62rem;
		height: 0.52rem;
	}

	.mingxin-dialogue__sticker-image {
		display: block;
		width: 100%;
		height: auto;
		object-fit: contain;
	}

	/* ---------------- 气泡墙 ---------------- */
	.mingxin-blinds__bubbles {
		position: absolute;
		inset: 0;
		z-index: 3;
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	.mingxin-blind-bubble {
		position: absolute;
		top: var(--mingxin-bubble-top, 50%);
		left: 0;
		max-width: 20rem;
		will-change: transform;
		animation: mingxin-bubble-drift var(--mingxin-bubble-duration, 32s) linear infinite;
	}

	.mingxin-blind-bubble.is-empty {
		visibility: hidden;
	}

	.mingxin-blind-bubble__body {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		gap: 0.45em;
		padding: 0.42rem 0.95rem 0.6rem;
		border: 1px solid color-mix(in srgb, var(--on-surface) 16%, transparent);
		border-radius: var(--shape-corner-l, 1rem);
		background: color-mix(in srgb, var(--page-bg) 68%, transparent);
		color: color-mix(in srgb, var(--on-surface) 62%, transparent);
		font-size: calc(0.86rem * var(--mingxin-bubble-scale, 1));
		line-height: 1.45;
	}

	.mingxin-blind-bubble__image {
		display: none;
		flex: none;
		width: 9em;
		height: 6.2em;
		border-radius: var(--shape-corner-m, 0.75rem);
		object-fit: cover;
		opacity: 0;
		background: color-mix(in srgb, var(--on-surface) 12%, transparent);
		transition: opacity 0.45s ease;
	}

	.mingxin-blind-bubble__image.is-loading {
		background-image: linear-gradient(
			100deg,
			transparent 20%,
			color-mix(in srgb, var(--on-surface) 16%, transparent) 45%,
			transparent 70%
		);
		background-size: 220% 100%;
		animation: mingxin-bubble-shimmer 1.25s linear infinite;
	}

	.mingxin-blind-bubble__image.is-loaded {
		opacity: 1;
	}

	.mingxin-blind-bubble__text {
		display: -webkit-box;
		max-width: 100%;
		overflow: hidden;
		-webkit-line-clamp: 2;
		line-clamp: 2;
		-webkit-box-orient: vertical;
		overflow-wrap: break-word;
		white-space: normal;
	}

	.mingxin-blind-bubble.has-image .mingxin-blind-bubble__image {
		display: block;
	}

	.mingxin-blinds__bubbles.is-paused .mingxin-blind-bubble,
	.mingxin-blinds__bubbles.is-paused .mingxin-blind-bubble__image {
		animation-play-state: paused;
	}

	@keyframes mingxin-bubble-shimmer {
		from {
			background-position: 180% 0;
		}
		to {
			background-position: -80% 0;
		}
	}

	@keyframes mingxin-bubble-drift {
		from {
			transform: translate3d(100vw, 0, 0);
		}
		to {
			transform: translate3d(-100%, 0, 0);
		}
	}

	/* ---------------- 立绘巡航 ---------------- */
	.mingxin-blinds__stands {
		--mingxin-stand-height: min(24vh, 15rem);
		--mingxin-stand-width: min(24vw, 13rem);
		position: absolute;
		right: 0;
		bottom: 0;
		left: 0;
		z-index: 5;
		height: var(--mingxin-stand-height);
		overflow: hidden;
		opacity: 0;
		visibility: hidden;
		pointer-events: none;
	}

	@supports (height: 100dvh) {
		.mingxin-blinds__stands {
			--mingxin-stand-height: min(24dvh, 15rem);
		}
	}

	.mingxin-blinds__stands-track {
		position: absolute;
		inset: 0;
	}

	.mingxin-blinds__stand {
		position: absolute;
		bottom: 0;
		left: 0;
		width: max-content;
		pointer-events: auto;
		touch-action: pan-y;
		cursor: grab;
		user-select: none;
		will-change: transform;
	}

	.mingxin-blinds__stand.is-dragging {
		cursor: grabbing;
	}

	/* 同时限制单张宽高；内层以底边为铰链立起，不占用外层横移的 transform */
	.mingxin-blinds__stand-image {
		display: block;
		width: auto;
		height: auto;
		max-width: var(--mingxin-stand-width);
		max-height: var(--mingxin-stand-height);
		object-fit: contain;
		object-position: center bottom;
		transform-origin: 50% 100%;
		user-select: none;
		-webkit-user-drag: none;
	}

	/* 小屏 / 减动效：对话整层撤下（影像层本身走静态回退，同原站口径） */
	@media (max-width: 767.98px) {
		.mingxin-dialogue {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.mingxin-dialogue {
			display: none;
		}
	}
</style>

<script>
	import { mingxinConfig } from "@/config";
	import { mountMingxinBlinds } from "@/scripts/home-mingxin";
	import { mountMingxinDialogue } from "@/scripts/mingxin/home-dialogue";
	import { mountMingxinMosaic } from "@/scripts/mingxin/home-mosaic";
	import { bootMingxinGuide } from "@/scripts/mingxin-guide";
	import { bootMingxinIndexScene } from "@/scripts/mingxin-index-scene";

	/* 明信首页挂载：模式守卫在最前——非 mingxin 时整段不执行（零负担）。
	   swup 软导航进出首页靠 page:view 重挂、visit:start 销毁；
	   站内切到明信形态时靠 siteModeChange 补挂。监听只注册一次（window 戳记）。 */
	const MESSAGES = mingxinConfig.headlineMessages;
	let teardown: (() => void) | null = null;
	let lastNavWasSwup = false;

	function mountRotator(root: HTMLElement): () => void {
		const el = root.querySelector<HTMLElement>("[data-hero-message]");
		if (!el || MESSAGES.length < 2) return () => {};
		if (window.matchMedia("(prefers-reduced-motion: reduce)").matches)
			return () => {};
		let index = 0;
		let fadeTimer = 0;
		const interval = window.setInterval(() => {
			if (document.hidden) return;
			el.classList.add("is-fading");
			fadeTimer = window.setTimeout(() => {
				index = (index + 1) % MESSAGES.length;
				el.textContent = MESSAGES[index];
				el.classList.remove("is-fading");
			}, 460);
		}, 3400);
		return () => {
			window.clearInterval(interval);
			window.clearTimeout(fadeTimer);
		};
	}

	function mountHome(): void {
		const root = document.querySelector<HTMLElement>("[data-mingxin-home]");
		if (!root) return;
		if (document.documentElement.dataset.siteMode !== "mingxin") {
			teardown?.();
			teardown = null;
			return;
		}
		if (root.dataset.mxMounted === "true") return;
		root.dataset.mxMounted = "true";
		const cleanups: (() => void)[] = [];
		/* 黑猫对话先挂：影像层控制器经 deps 回调驱动它的显隐与打招呼
		   （reveal/shrink 段可见、reveal 段 420ms 后冒首句），同原站装配序 */
		const dialogueRoot = root.querySelector<HTMLElement>("[data-mingxin-dialogue]");
		const dialogue = dialogueRoot ? mountMingxinDialogue(dialogueRoot) : null;
		if (dialogue) cleanups.push(() => dialogue.destroy());
		const blindsRoot = root.querySelector<HTMLElement>("[data-mingxin-blinds]");
		if (blindsRoot) {
			const destroy = mountMingxinBlinds(blindsRoot, {
				deferFirstSync: lastNavWasSwup,
				setSceneVisible: (visible) => dialogue?.setSceneVisible(visible),
				setGreetingVisible: (visible) => dialogue?.setGreetingVisible(visible),
			});
			if (destroy) cleanups.push(destroy);
			/* 马赛克层在影像层之后挂：它只读自己的滚动段，与影像层互不写同一批元素 */
			if (blindsRoot.querySelector("[data-mosaic-layer]")) {
				cleanups.push(mountMingxinMosaic(blindsRoot));
			}
		}
		cleanups.push(mountRotator(root));
		/* 页脚运行时间逐秒跳字：与他形态页脚同一算法（起点 +08:00、天/时/分/秒） */
		const uptimeEl = root.querySelector<HTMLElement>("[data-mx-uptime]");
		if (uptimeEl) {
			const start = Number(uptimeEl.dataset.start || 0);
			const tick = () => {
				const diff = Math.max(0, Date.now() - start);
				uptimeEl.textContent = `${Math.floor(diff / 86400000)} 天 ${Math.floor((diff % 86400000) / 3600000)} 小时 ${Math.floor((diff % 3600000) / 60000)} 分 ${Math.floor((diff % 60000) / 1000)} 秒`;
			};
			tick();
			const timer = window.setInterval(tick, 1000);
			cleanups.push(() => window.clearInterval(timer));
		}
		/* 终幕变体开关（终幕区）：写 html 属性 + localStorage 即时换，
		   选中态与外观卡的同名 chip 互刷（卡内 chip 由 navbar 脚本管） */
		const glowButtons = Array.from(
			root.querySelectorAll<HTMLElement>("[data-afterglow-choice]"),
		);
		if (glowButtons.length) {
			const syncGlow = () => {
				const current =
					document.documentElement.getAttribute("data-mingxin-afterglow") ===
					"classic"
						? "classic"
						: "hero";
				glowButtons.forEach((button) => {
					button.setAttribute(
						"aria-checked",
						String(button.dataset.afterglowChoice === current),
					);
				});
			};
			const onGlowClick = (event: Event) => {
				const button = (event.target as Element).closest<HTMLElement>(
					"[data-afterglow-choice]",
				);
				if (!button) return;
				const value = button.dataset.afterglowChoice === "classic" ? "classic" : "hero";
				document.documentElement.setAttribute("data-mingxin-afterglow", value);
				try {
					localStorage.setItem("mingxinAfterglow", value);
				} catch {}
				syncGlow();
			};
			const switchEl = root.querySelector<HTMLElement>(".mingxin-afterglow-switch");
			switchEl?.addEventListener("click", onGlowClick);
			syncGlow();
			cleanups.push(() => switchEl?.removeEventListener("click", onGlowClick));
		}
		const layer = root.querySelector<HTMLElement>(".mingxin-datalayer");
		if (layer && layer.dataset.guideMounted !== "true") {
			layer.dataset.guideMounted = "true";
			cleanups.push(bootMingxinGuide(layer));
			cleanups.push(bootMingxinIndexScene(layer));
		}
		teardown = () => {
			cleanups.forEach((fn) => {
				try {
					fn();
				} catch {}
			});
			delete root.dataset.mxMounted;
			if (layer) delete layer.dataset.guideMounted;
		};
	}

	const w = window as unknown as { __mingxinHomeBoot?: boolean };
	if (!w.__mingxinHomeBoot) {
		w.__mingxinHomeBoot = true;
		document.addEventListener("swup:page:view", () => {
			lastNavWasSwup = true;
			mountHome();
		});
		document.addEventListener("swup:visit:start", () => {
			teardown?.();
			teardown = null;
		});
		window.addEventListener("siteModeChange", mountHome);
	}
	mountHome();
</script>
