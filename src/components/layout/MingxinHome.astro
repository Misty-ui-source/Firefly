	.mingxin-afterglow-switch__btn {
		padding: 0.35rem 0.9rem;
		border: 1px solid var(--surface-outline-variant);
		border-radius: 999px;
		background: transparent;
		color: var(--deep-text);
		font: inherit;
		font-weight: 600;
		cursor: pointer;
	}
	.mingxin-afterglow-switch__btn[aria-checked="true"] {
		border-color: var(--deep-text);
		background: color-mix(in oklch, var(--deep-text) 13%, transparent);
		box-shadow: inset 0 0 0 1px var(--deep-text);
		font-weight: 800;
	}

	/* 备案图标尺寸与他形态页脚（FooterConfig.html 内联样式）同值 */
	.mingxin-footer__icp-icon {
		display: inline-block;
		width: 1.15em;
		height: 1.15em;
		vertical-align: -0.22em;
		margin-right: 0.3em;
	}
	.mingxin-footer__meta a {
		color: inherit;
		text-decoration: none;
	}

	/* ================= 静态回退（≤768px / 减弱动效） ================= */
	.mingxin-static {
		display: none;
	}
	@media (max-width: 767.98px), (prefers-reduced-motion: reduce) {
		.mingxin-blinds,
		.mingxin-finale-spacer,
		.mingxin-finale-copy {
			display: none !important;
		}
		.mingxin-static {
			display: grid;
			gap: 1.4rem;
			max-width: 44rem;
			margin-inline: auto;
			padding: 1.25rem 1rem 0;
		}
		.mingxin-static__card {
			position: relative;
			border: 1px solid var(--surface-outline-variant);
			border-radius: 1rem;
			background: var(--card-bg);
