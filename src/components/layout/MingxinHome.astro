		flex-wrap: wrap;
		font-size: 0.85rem;
		color: oklch(from var(--deep-text) 0.6 0 h);
		font-weight: 600;
	}
	.mingxin-footer__credit,
	.mingxin-footer__meta-row {
		margin: 0;
	}
	.mingxin-footer__meta {
		display: grid;
		gap: 0.25rem;
		text-align: right;
	}
	/* 终幕变体开关：与外观卡形态 chip 同一套选中态语言（深字描边 + 13% 染） */
	.mingxin-afterglow-switch {
		display: flex;
		align-items: center;
		justify-content: flex-end;
		gap: 0.75rem;
