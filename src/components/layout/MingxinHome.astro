		.mingxin-static__image {
			width: 100%;
			aspect-ratio: 4 / 3;
			object-fit: cover;
			display: block;
		}
		.mingxin-static__band {
			display: flex;
			gap: 0.9rem;
			padding: 0.9rem 1rem 1rem;
		}
		.mingxin-static__id {
